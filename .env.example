# 0. CẤU HÌNH DOCKER & CỔNG CỐ ĐỊNH TRÊN VPS (Web: 5087, SQL Host: 1437)
ASPNETCORE_URLS="http://+:5087"
SA_PASSWORD="BookShare@2026StrongPass!"

# 1. CƠ SỞ DỮ LIỆU SQL SERVER (Dùng cho Scaffold & Runtime)
# - Khi chạy Docker Compose: Server=sqlserver,1433;Database=BookShareDb;User Id=sa;Password=BookShare@2026StrongPass!;TrustServerCertificate=True;MultipleActiveResultSets=true;
ConnectionStrings__DefaultConnection="Server=(localdb)\\MSSQLLocalDB;Database=BookShareDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"

# 2. GEMINI AI API (Dịch vụ S13 - Chat AI hỗ trợ & S14 - Gợi ý sách)
Gemini__ApiKey=""
Gemini__Model="gemini-2.5-flash"

# 3. RESEND EMAIL API (Dịch vụ S01 - Gửi OTP 6 số & S18 - Nhắc hạn trả sách)
Resend__ApiKey=""
Resend__FromEmail="BookShare <onboarding@resend.dev>"

# 4. GOOGLE OAUTH 2.0 (Dịch vụ S01 - Đăng nhập bằng Google chuẩn .NET Identity)
Authentication__Google__ClientId=""
Authentication__Google__ClientSecret=""

# 5. LƯU TRỮ ẢNH BIÊN BẢN KIỂM ĐỊNH (Dịch vụ S10 - Lưu nội bộ an toàn tại wwwroot/uploads/reports)
# Không yêu cầu khóa đám mây ngoài; nếu dùng dịch vụ SMTP dự phòng cho Email OTP/Nhắc hạn:
Smtp__Host=""
Smtp__Port="587"
Smtp__User=""
Smtp__Pass=""
Smtp__FromEmail=""

