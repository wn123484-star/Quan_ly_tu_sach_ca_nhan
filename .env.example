# 1. CƠ SỞ DỮ LIỆU SQL SERVER (Dùng cho Scaffold & Runtime)
ConnectionStrings__DefaultConnection="Server=(localdb)\\MSSQLLocalDB;Database=BookShareDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;"

# 2. GEMINI AI API (Dịch vụ S13 - Chat AI hỗ trợ & S14 - Gợi ý sách)
Gemini__ApiKey=""
Gemini__Model="gemini-2.5-flash"

# 3. RESEND EMAIL API (Dịch vụ S01 - Gửi OTP 6 số & S18 - Nhắc hạn trả sách)
Resend__ApiKey=""
Resend__FromEmail="BookShare <onboarding@resend.dev>"

# 4. GOOGLE OAUTH 2.0 (Dịch vụ S01 - Đăng nhập bằng Google chuẩn .NET Identity)
Authentication__Google__ClientId=""
Authentication__Google__ClientSecret=""

# 5. CLOUDINARY (Dịch vụ S02 & S10 - Lưu ảnh bìa sách & Ảnh tình trạng lúc giao/trả)
Cloudinary__Url="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
Cloudinary__CloudName=""
Cloudinary__ApiKey=""
Cloudinary__ApiSecret=""

# 6. VNPAY SANDBOX (Dịch vụ S16 & S17 - Thanh toán gói Premium & Phí phạt trễ hạn)
VNPay__TmnCode=""
VNPay__HashSecret=""
VNPay__BaseUrl="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPay__ReturnUrl="http://localhost:5141/Payment/VNPayCallback"

# 7. GOOGLE RECAPTCHA V3 (Chặn bot đăng ký & spam yêu cầu mượn)
ReCaptcha__SiteKey=""
ReCaptcha__SecretKey=""
