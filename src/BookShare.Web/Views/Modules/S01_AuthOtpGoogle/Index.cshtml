@model BookShare.Web.Models.ViewModels.S01AuthPageViewModel
@inject BookShare.Web.Services.Interfaces.ISystemIconService IconService
@{
    ViewData["Title"] = Model.IsAuthenticated ? "Hồ Sơ Cá Nhân & Bảo Mật" : "Đăng Nhập & Đăng Ký Thành Viên";
    var defaultAvatarUrl = IconService.GetImageUrl("avatar_default", "/images/avatar-default.svg");
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s01-auth-otp-google/s01-auth-otp-google.css" asp-append-version="true" />
}

<div class="s01-auth-wrapper">
    @if (Model.IsAuthenticated)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box bg-success text-white"><i class="bi bi-person-check-fill"></i></div>
                    <div>
                        <span class="badge bg-primary mb-1">Phiên làm việc đang hoạt động • Vai trò: @Model.CurrentUserRole</span>
                        <h5 class="fw-bold mb-0">@Model.CurrentUserFullName (@Model.CurrentUserEmail)</h5>
                        <small class="text-muted">Điểm uy tín hiện tại: <strong>@Model.CurrentTrustScore điểm</strong></small>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="S02PersonalShelf" asp-action="Index" class="btn btn-primary btn-sm fw-bold">
                        <i class="bi bi-bookshelf me-1"></i>Tủ Sách Cá Nhân
                    </a>
                    <a asp-controller="S18NotificationHub" asp-action="Index" class="btn btn-outline-info btn-sm fw-bold">
                        <i class="bi bi-bell-fill me-1"></i>Cài Đặt Thông Báo &amp; Xác Minh Email
                    </a>
                    <form asp-controller="S01AuthOtpGoogle" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: GIỚI THIỆU CỘNG ĐỒNG BOOKSHARE -->
        <div class="col-lg-5">
            <div class="s01-hero-panel">
                <div>
                    <span class="badge bg-info text-dark fw-bold mb-2">CỔNG THÀNH VIÊN BOOKSHARE</span>
                    <h4 class="fw-bold mb-2">Chia Sẻ Sách Giấy Minh Bạch &amp; Gắn Kết Tri Thức</h4>
                    <p class="small opacity-90 mb-4">
                        BookShare kết nối độc giả, tủ sách cá nhân, câu lạc bộ sách và thư viện đối tác theo mô hình mượn trả hoàn toàn phi thương mại (0 đồng).
                    </p>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="s01-feature-item">
                            <div class="fw-bold small mb-1"><i class="bi bi-book-half text-info me-2"></i>100% Chia sẻ &amp; Mượn trả Sách Giấy</div>
                            <div class="small opacity-85">Quản lý tủ sách cá nhân, theo dõi tiến độ từng trang đọc và ghi chú trích dẫn tâm đắc.</div>
                        </div>
                        <div class="s01-feature-item">
                            <div class="fw-bold small mb-1"><i class="bi bi-shield-check text-warning me-2"></i>Quy trình Mượn Trả Minh Bạch</div>
                            <div class="small opacity-85">Đối chiếu ảnh tình trạng sách trước khi giao và khi hoàn trả tại quầy thư viện hoặc điểm trạm câu lạc bộ.</div>
                        </div>
                        <div class="s01-feature-item">
                            <div class="fw-bold small mb-1"><i class="bi bi-award-fill text-success me-2"></i>Bảo vệ Uy tín Thành viên</div>
                            <div class="small opacity-85">Hệ thống điểm uy tín hai chiều giúp cộng đồng trao gửi những cuốn sách quý một cách an tâm và bền vững.</div>
                        </div>
                    </div>
                </div>

                <div class="p-3 rounded-3 bg-white bg-opacity-10 small">
                    <div class="fw-bold mb-1"><i class="bi bi-lock-fill text-warning me-1"></i>An toàn Tài khoản Thành viên</div>
                    <p class="mb-0 opacity-90">
                        Tài khoản được bảo vệ bằng mật khẩu mã hóa chuẩn, xác minh địa chỉ Email qua mã OTP 6 chữ số và tùy chọn đăng nhập liên kết Google.
                    </p>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: ĐĂNG NHẬP, GOOGLE, ĐĂNG KÝ & HỒ SƠ CÁ NHÂN -->
        <div class="col-lg-7">
            <div class="s01-auth-card mb-4">
                <ul class="nav nav-pills nav-fill mb-4 gap-2" id="s01AuthTabs" role="tablist">
                    @if (!Model.IsAuthenticated)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold" data-bs-toggle="pill" data-bs-target="#tabLogin" type="button">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#tabRegister" type="button">
                                <i class="bi bi-person-plus me-1"></i>Đăng Ký
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold" id="btnTabQrLogin" data-bs-toggle="pill" data-bs-target="#tabQrLogin" type="button">
                                @IconService.RenderIconHtml("qr_scan", "bi-qr-code-scan", "me-1")Mã QR
                            </button>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold" id="btnTabProfile" data-bs-toggle="pill" data-bs-target="#tabProfile" type="button">
                                <i class="bi bi-person-vcard-fill me-1"></i>Hồ Sơ &amp; Email
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold" id="btnTabAppearance" data-bs-toggle="pill" data-bs-target="#tabAppearance" type="button">
                                <i class="bi bi-palette2 me-1"></i>Giao Diện &amp; Font
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold" id="btnTabQrLogin" data-bs-toggle="pill" data-bs-target="#tabQrLogin" type="button">
                                @IconService.RenderIconHtml("qr_scan", "bi-qr-code-scan", "me-1")Liên Kết QR
                            </button>
                        </li>
                    }
                </ul>

                <div class="tab-content">
                    @if (!Model.IsAuthenticated)
                    {
                        <!-- TAB 1: ĐĂNG NHẬP & GOOGLE -->
                        <div class="tab-pane fade show active" id="tabLogin" role="tabpanel">
                        <form id="s01LoginForm" asp-controller="S01AuthOtpGoogle" asp-action="Login" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                            <input type="hidden" name="RecaptchaToken" id="loginRecaptchaToken" />

                            <div class="mb-3">
                                <label class="form-label small fw-bold" for="loginEmail">Email đăng nhập</label>
                                <input type="text" class="form-control" id="loginEmail" name="Email" value="" placeholder="Nhập địa chỉ Email của bạn..." required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold" for="loginPassword">Mật khẩu</label>
                                <input type="password" class="form-control" id="loginPassword" name="Password" value="" placeholder="Nhập mật khẩu..." required />
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="RememberMe" value="true" checked id="rememberCheck" />
                                    <label class="form-check-label small" for="rememberCheck">Ghi nhớ phiên đăng nhập</label>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                <i class="bi bi-unlock-fill me-1"></i>Đăng Nhập Vào Hệ Thống
                            </button>
                        </form>

                        <div class="text-center text-muted small my-3">— HOẶC ĐĂNG NHẬP NHANH —</div>

                        <form asp-controller="S01AuthOtpGoogle" asp-action="GoogleLogin" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="s01-google-btn" @(Model.IsGoogleOAuthConfigured ? null : "disabled")>
                                <i class="bi bi-google text-danger fs-5"></i>
                                <span>Tiếp tục nhanh bằng tài khoản Google</span>
                            </button>
                            @if (!Model.IsGoogleOAuthConfigured)
                            {
                                <div class="small text-muted text-center mt-2">
                                    <i class="bi bi-info-circle me-1"></i>Đăng nhập Google hiện chưa được kích hoạt (cần cấu hình khóa Google OAuth 2.0 hợp lệ trong tệp <code>.env</code>).
                                </div>
                            }
                        </form>

                        <div class="p-3 rounded-3 border d-flex flex-wrap justify-content-between align-items-center gap-2 small s01-note-box">
                            <div>
                                <i class="bi bi-envelope-check-fill text-primary me-1"></i>
                                <strong>Xác minh Email nhận thông báo bằng OTP:</strong> Thực hiện tại Trung tâm Thông báo sau khi đăng nhập.
                            </div>
                            <a asp-controller="S18NotificationHub" asp-action="Index" class="btn btn-outline-primary btn-xs fw-bold">
                                Mở Cài Đặt Thông Báo &rarr;
                            </a>
                        </div>
                    </div>

                        <!-- TAB 2: ĐĂNG KÝ TÀI KHOẢN MỚI -->
                        <div class="tab-pane fade" id="tabRegister" role="tabpanel">
                            <form id="s01RegisterForm" asp-controller="S01AuthOtpGoogle" asp-action="Register" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="RecaptchaToken" id="registerRecaptchaToken" />
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="regFullName">Họ và tên đầy đủ *</label>
                                        <input type="text" id="regFullName" name="FullName" class="form-control" placeholder="VD: Nguyễn Văn An" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="regEmail">Địa chỉ Email *</label>
                                        <input type="email" id="regEmail" name="Email" class="form-control" placeholder="sinhvien@cmc.edu.vn" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="regPassword">Mật khẩu (tối thiểu 6 ký tự) *</label>
                                        <input type="password" id="regPassword" name="Password" class="form-control" value="" minlength="6" placeholder="Nhập mật khẩu..." required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="regAddress">Khu vực giao nhận sách P2P</label>
                                        <input type="text" id="regAddress" name="Address" class="form-control" value="" placeholder="VD: Cầu Giấy, Hà Nội" />
                                    </div>
                                    <div class="col-12">
                                        <div class="small text-muted mb-2">
                                            <i class="bi bi-person-badge me-1"></i>Tài khoản đăng ký mới được khởi tạo với vai trò thành viên tiêu chuẩn và 100 điểm uy tín ban đầu.
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                            <i class="bi bi-person-plus-fill me-1"></i>Tạo Tài Khoản Thành Viên
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }

                    <!-- TAB 2B: ĐĂNG NHẬP NHANH BẰNG MÃ QR -->
                    <div class="tab-pane fade" id="tabQrLogin" role="tabpanel">
                        <div class="text-center p-3 p-md-4 rounded-4 border bg-body-tertiary">
                            <h6 class="fw-bold text-primary mb-2">
                                <i class="bi bi-qr-code-scan me-1"></i>Đăng Nhập Nhanh Không Cần Nhập Mật Khẩu
                            </h6>
                            <p class="small text-muted mb-3">
                                Mở ứng dụng BookShare (hoặc trình duyệt) đang đăng nhập sẵn trên thiết bị khác và quét mã dưới đây để vào hệ thống ngay lập tức.
                            </p>

                            <div class="d-inline-block p-3 bg-white rounded-4 border shadow-sm mb-3">
                                <div id="qrWebLoginBox" class="d-flex align-items-center justify-content-center" style="min-width:210px; min-height:210px;">
                                    <span class="small text-muted">Đang khởi tạo mã xác nhận...</span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-center align-items-center gap-2 mb-3 flex-wrap">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2" id="qrWebLoginTimer">
                                    Hiệu lực: 120s
                                </span>
                                <span class="small fw-semibold text-muted" id="qrWebLoginStatus">
                                    Đang chờ thiết bị khác xác nhận...
                                </span>
                            </div>

                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <button type="button" id="btnRefreshWebQr" class="btn btn-outline-primary btn-sm fw-bold">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Tạo Mã Mới
                                </button>
                                <button type="button" id="btnScanMobileLinkQr" class="btn btn-primary btn-sm fw-bold">
                                    <i class="bi bi-camera-fill me-1"></i>Quét Mã Từ Thiết Bị Đã Đăng Nhập
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (Model.IsAuthenticated)
                    {
                        <!-- TAB 3: HỒ SƠ CÁ NHÂN & ĐỔI MẬT KHẨU (MẶC ĐỊNH KHI ĐÃ ĐĂNG NHẬP) -->
                        <div class="tab-pane fade show active" id="tabProfile" role="tabpanel">
                            <div class="d-flex align-items-center gap-3 p-3 rounded-4 border mb-3 s01-profile-summary">
                                <img src="@(string.IsNullOrWhiteSpace(Model.CurrentUserAvatarUrl) ? defaultAvatarUrl : Model.CurrentUserAvatarUrl)" alt="Ảnh đại diện của @Model.CurrentUserFullName" id="s01AvatarPreview"
                                     class="rounded-circle border shadow-sm" style="width:64px; height:64px; object-fit:cover;"
                                     onerror="this.onerror=null;this.src='@defaultAvatarUrl'" />
                                <div>
                                    <div class="fw-bold">@Model.CurrentUserFullName <span class="badge bg-primary ms-1">@Model.CurrentUserRole</span></div>
                                    <div class="small text-muted">Tên đăng nhập: <code>@Model.CurrentUserName</code></div>
                                    <div class="small text-muted">
                                        Email nhận thư:
                                        @if (Model.HasValidEmail)
                                        {
                                            <strong>@Model.CurrentUserEmail</strong>
                                            <span class="badge @(Model.EmailConfirmed ? "bg-success" : "bg-warning text-dark") ms-1">
                                                @(Model.EmailConfirmed ? "Đã xác minh OTP" : "Chưa xác minh OTP")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Chưa có Email — Cần điền để gửi thư</span>
                                        }
                                    </div>
                                    <div class="small text-success fw-semibold"><i class="bi bi-award-fill me-1"></i>Điểm uy tín: @Model.CurrentTrustScore điểm</div>
                                </div>
                            </div>

                            <form id="s01UpdateProfileForm" class="mb-4 pb-3 border-bottom">
                                <h6 class="fw-bold small text-primary text-uppercase mb-3">
                                    <i class="bi bi-pencil-square me-1"></i>Cài Đặt Thông Tin Hiển Thị &amp; Email Nhận Thư (Mọi Cấp)
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="profFullName">Tên hiển thị (khác với Email) *</label>
                                        <input type="text" id="profFullName" class="form-control" value="@Model.CurrentUserFullName" placeholder="VD: Nguyễn Minh Anh" required />
                                        <div class="form-text small">Tên hiển thị trên đầu trang, phiếu mượn &amp; hội thoại AI.</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="profEmail">Email liên hệ &amp; nhận thư</label>
                                        <input type="email" id="profEmail" class="form-control" value="@Model.CurrentUserEmail" placeholder="VD: tenban@gmail.com" />
                                        <div class="form-text small">Dùng để gửi OTP, nhắc hạn trả sách và bản lưu chat AI.</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="profUserNameReadonly">Tên đăng nhập hệ thống</label>
                                        <input type="text" id="profUserNameReadonly" class="form-control bg-body-tertiary" value="@Model.CurrentUserName" readonly />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="profPhone">Số điện thoại</label>
                                        <input type="text" id="profPhone" class="form-control" value="@Model.CurrentUserPhoneNumber" placeholder="0988xxxxxx" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="profAddress">Địa chỉ / Khu vực giao nhận</label>
                                        <input type="text" id="profAddress" class="form-control" value="@Model.CurrentUserAddress" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold" for="profAvatarUrl">Đường dẫn ảnh đại diện</label>
                                        <input type="text" id="profAvatarUrl" class="form-control" value="@Model.CurrentUserAvatarUrl" />
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary fw-bold px-4">
                                            <i class="bi bi-check2-circle me-1"></i>Lưu Tên Hiển Thị &amp; Email
                                        </button>
                                    </div>
                                </div>
                            </form>

                            <form id="s01ChangePasswordForm">
                                <h6 class="fw-bold small text-danger text-uppercase mb-3">
                                    <i class="bi bi-key-fill me-1"></i>Đổi Mật Khẩu Bảo Mật
                                </h6>
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-5">
                                        <label class="form-label small fw-bold" for="profCurrentPass">Mật khẩu hiện tại</label>
                                        <input type="password" id="profCurrentPass" class="form-control" value="" placeholder="Nhập mật khẩu hiện tại..." required />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label small fw-bold" for="profNewPass">Mật khẩu mới (tối thiểu 6 ký tự)</label>
                                        <input type="password" id="profNewPass" class="form-control" value="" minlength="6" placeholder="Nhập mật khẩu mới..." required />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-outline-danger fw-bold w-100">
                                            Đổi MK
                                        </button>
                                    </div>
                                </div>
                            </form>

                            <div class="mt-4 pt-3 border-top">
                                <h6 class="fw-bold small text-primary text-uppercase mb-2">
                                    <i class="bi bi-phone-flip me-1"></i>Đăng Nhập Nhanh Thiết Bị Khác Bằng Mã QR
                                </h6>
                                <p class="small text-muted mb-3">
                                    Quét mã trên màn hình máy tính để đăng nhập giúp thiết bị đó, hoặc tạo mã tạm thời dùng 1 lần cho điện thoại mới.
                                </p>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" id="btnApproveDesktopQr" class="btn btn-sm btn-primary fw-bold">
                                        <i class="bi bi-qr-code-scan me-1"></i>Quét Mã Trên Máy Tính
                                    </button>
                                    <button type="button" id="btnGenerateMobileLinkQr" class="btn btn-sm btn-outline-primary fw-bold">
                                        <i class="bi bi-qr-code me-1"></i>Hiện Mã Cho Điện Thoại (60s)
                                    </button>
                                </div>
                                <div id="mobileLinkQrContainer" class="d-none mt-3 p-3 rounded-4 border bg-body-tertiary text-center">
                                    <div class="d-inline-block p-2 bg-white rounded-3 border shadow-sm">
                                        <div id="mobileLinkQrBox"></div>
                                    </div>
                                    <div class="small fw-semibold text-primary mt-2" id="mobileLinkQrTimer"></div>
                                </div>
                            </div>

                            @if (Model.CurrentUserRole == "User")
                            {
                                <div class="mt-4 pt-3 border-top">
                                    <h6 class="fw-bold small text-primary text-uppercase mb-2">
                                        <i class="bi bi-geo-alt-fill me-1"></i>Đăng Ký Trở Thành Chủ Nhiệm CLB / Điểm Trạm Sách
                                    </h6>
                                    @if (Model.PendingCuratorStatus == "Pending")
                                    {
                                        <div class="alert alert-info small mb-0">
                                            <i class="bi bi-hourglass-split me-1"></i>Đề nghị trở thành Chủ nhiệm CLB của bạn đang chờ Quản trị viên xem xét phê duyệt.
                                        </div>
                                    }
                                    else
                                    {
                                        @if (Model.PendingCuratorStatus == "Rejected" && !string.IsNullOrWhiteSpace(Model.LatestCuratorNote))
                                        {
                                            <div class="alert alert-warning small mb-2">
                                                Đề nghị trước đó chưa được duyệt: <strong>@Model.LatestCuratorNote</strong>. Bạn có thể bổ sung và gửi lại.
                                            </div>
                                        }
                                        <form id="s01CuratorRequestForm" class="row g-2">
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold" for="curatorOrgName">Tên CLB / Điểm trạm dự kiến *</label>
                                                <input type="text" id="curatorOrgName" class="form-control form-control-sm" placeholder="VD: CLB Sách Sinh viên ĐH CMC" required />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold" for="curatorReason">Kinh nghiệm &amp; Cam kết vận hành *</label>
                                                <input type="text" id="curatorReason" class="form-control form-control-sm" placeholder="Mô tả điểm hẹn tiếp nhận sách và thời gian trực..." required />
                                            </div>
                                            <div class="col-12 text-end">
                                                <button type="submit" class="btn btn-sm btn-outline-primary fw-bold">
                                                    <i class="bi bi-send-check me-1"></i>Gửi Đề Nghị Nâng Quyền Chủ Nhiệm CLB
                                                </button>
                                            </div>
                                        </form>
                                    }
                                </div>
                            }
                        </div>

                        <!-- TAB 4: CÀI ĐẶT GIAO DIỆN BOOTSTRAP, BẢNG MÀU, PHÔNG CHỮ & CỠ CHỮ (MỌI CẤP) -->
                        <div class="tab-pane fade" id="tabAppearance" role="tabpanel">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-palette2 me-1"></i>Tùy Biến Giao Diện, Phong Cách &amp; Phông Chữ Nội Bộ</h6>
                            <p class="small text-muted mb-3">
                                Toàn bộ giao diện Bootstrap, biểu tượng và 5 bộ phông chữ tiếng Việt đều được tích hợp sẵn cục bộ — đổi tức thì và lưu đồng bộ vào tài khoản của bạn.
                            </p>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold" for="prefThemeMode">Chế độ Sáng / Tối</label>
                                    <select id="prefThemeMode" class="form-select">
                                        <option value="light">☀️ Nền Sáng (Mặc định dễ đọc)</option>
                                        <option value="dark">🌙 Nền Tối (Bảo vệ mắt ban đêm)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold" for="prefUiStyle">Phong cách thiết kế (Bootstrap)</label>
                                    <select id="prefUiStyle" class="form-select">
                                        <option value="standard">📘 Chuẩn Hiện Đại (BookShare Default)</option>
                                        <option value="sketchy">✏️ Nét Vẽ Nghệch Ngoặc (Sketchy Hand-Drawn)</option>
                                        <option value="morph">🫧 Kính Mờ Mềm Mại (Neumorphism Morph)</option>
                                        <option value="flatly">📐 Phẳng Sắc Nét (Flatly Minimal)</option>
                                        <option value="cyborg">⚡ Đêm Công Nghệ (Cyborg Dark)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold" for="prefPalette">Bảng màu chủ đạo (10 lựa chọn)</label>
                                    <select id="prefPalette" class="form-select">
                                        <option value="blue">🔵 Xanh Sapphire (Mặc định)</option>
                                        <option value="gold">✨ Vàng Mộng Mơ (Ấm áp &amp; Dịu mắt)</option>
                                        <option value="rose">🌸 Hồng Ấm Áp (Sakura Nhẹ Nhàng)</option>
                                        <option value="lavender">💜 Tím Oải Hương (Mộng Mơ)</option>
                                        <option value="sepia">📜 Giấy Cổ Thư Viện (Cảm giác sách giấy)</option>
                                        <option value="emerald">🟢 Lục Bảo Thư Viện</option>
                                        <option value="ocean">🌊 Xanh Đại Dương</option>
                                        <option value="coral">🟠 Cam Hoàng Hôn</option>
                                        <option value="royal">🟣 Tím Hoàng Gia</option>
                                        <option value="midnight">🌌 Đêm Ngân Hà</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold" for="prefFontFamily">Phông chữ tiếng Việt (Tải sẵn cục bộ)</label>
                                    <select id="prefFontFamily" class="form-select">
                                        <option value="roboto">Roboto — Chuẩn cân đối</option>
                                        <option value="bevietnam">Be Vietnam Pro — Hiện đại sắc nét</option>
                                        <option value="lora">Lora — Có chân cổ điển đọc sách</option>
                                        <option value="patrick">Patrick Hand — Viết tay nghệch ngoặc</option>
                                        <option value="jetbrains">JetBrains Mono — Đơn cách kỹ thuật</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold" for="prefFontSize">Cỡ chữ hiển thị</label>
                                    <select id="prefFontSize" class="form-select">
                                        <option value="sm">Nhỏ gọn (14px)</option>
                                        <option value="md">Tiêu chuẩn (16px)</option>
                                        <option value="lg">Lớn dễ đọc (17.5px)</option>
                                        <option value="xl">Rất lớn trợ thị (19px)</option>
                                    </select>
                                </div>
                                <div class="col-md-6 d-flex align-items-end gap-2">
                                    <button type="button" id="btnSaveUiPrefs" class="btn btn-primary fw-bold flex-grow-1">
                                        <i class="bi bi-save2-fill me-1"></i>Lưu Cài Đặt Giao Diện
                                    </button>
                                    <button type="button" id="btnResetUiPrefs" class="btn btn-outline-secondary fw-semibold">
                                        Mặc định
                                    </button>
                                </div>
                            </div>

                            <div class="p-3 rounded-4 border bg-body-tertiary">
                                <div class="small fw-bold text-primary mb-1"><i class="bi bi-eye-fill me-1"></i>Xem trước trực tiếp phong cách &amp; phông chữ</div>
                                <p class="mb-1">“Mỗi cuốn sách giấy được trao tay là một cánh cửa tri thức mở ra cho cộng đồng — 100% chia sẻ miễn phí 0đ.”</p>
                                <small class="text-muted">BookShare hỗ trợ đầy đủ dấu tiếng Việt trên cả 5 bộ phông chữ cục bộ.</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s01-auth-otp-google/s01-auth-otp-google.js" asp-append-version="true"></script>
}
