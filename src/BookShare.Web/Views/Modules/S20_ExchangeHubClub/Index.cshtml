@model BookShare.Web.Models.ViewModels.S20ExchangeHubClubPageViewModel
@{
    ViewData["Title"] = "Không Gian Câu Lạc Bộ Sách Dạng Group, Trưởng Nhóm & Trạm Giao Nhận";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = Model.CurrentUserRole == "Admin";
    var canCreateClub = isAdmin || User.IsInRole("Curator");
    var creatorDisplayName = !string.IsNullOrWhiteSpace(Model.CurrentUserFullName)
        ? Model.CurrentUserFullName
        : (User.Identity?.Name ?? "Người thành lập");
    var sel = Model.SelectedHub;
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s20-exchange-hub-club/s20-exchange-hub-club.css" asp-append-version="true" />
}

<section class="s20-hero card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge bg-primary mb-2 px-3 py-1 rounded-pill">CÂU LẠC BỘ SÁCH HỌC THUẬT &amp; MÔ HÌNH NHÓM CỘNG ĐỒNG</span>
            <h2 class="fw-bold mb-1">🏕️ Không Gian Từng Câu Lạc Bộ, Trưởng Nhóm &amp; Điểm Trạm Giao Nhận</h2>
            <p class="text-muted small mb-0">
                Mỗi Câu lạc bộ vận hành độc lập như một Nhóm (Group) có <strong>Trưởng nhóm</strong>, <strong>Phó nhóm</strong>, danh sách thành viên, bảng tin nội bộ, điều lệ và trạm kiểm định – giao nhận sách riêng biệt. Quản trị viên có toàn quyền khởi tạo &amp; điều phối mọi CLB.
            </p>
        </div>
        <div class="s20-hub-badge">
            <div class="small">Vai trò hệ thống: <strong>@Model.CurrentUserRole</strong></div>
            <div class="fs-5 fw-bold">@Model.TotalHubsCount Trạm/CLB • @Model.TotalCopiesAtHubs Bản Sao</div>
            <small>Đơn P2P hẹn tại Hub: @Model.PendingP2PHubOrdersCount đơn</small>
            @if (canCreateClub)
            {
                <button type="button" id="btnOpenCreateClubModal"
                        data-creator-name="@creatorDisplayName"
                        class="btn btn-warning btn-sm text-dark fw-bold w-100 mt-2">
                    <i class="bi bi-plus-circle-fill me-1"></i>Thành Lập CLB / Trạm Mới
                </button>
            }
        </div>
    </div>
</section>

<!-- BỘ LỌC & DANH SÁCH TỪNG CÂU LẠC BỘ / ĐIỂM TRẠM RIÊNG BIỆT -->
<section class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" asp-controller="S20ExchangeHubClub" asp-action="Index" class="row g-2 align-items-center mb-3">
        <div class="col-md-5">
            <input type="text" name="clubKeyword" value="@Model.ClubKeyword" class="form-control form-control-sm" placeholder="Tìm Câu lạc bộ / Điểm trạm theo tên, địa chỉ, Trưởng nhóm..." />
        </div>
        <div class="col-md-4">
            <select name="hubType" class="form-select form-select-sm" aria-label="Lọc loại hình điểm trạm">
                <option value="all" selected="@(Model.HubTypeFilter == "all")">🌐 Tất cả Câu lạc bộ &amp; Thư viện</option>
                <option value="ClubStation" selected="@(Model.HubTypeFilter == "ClubStation")">⛺ Câu lạc bộ Sách</option>
                <option value="DropoffHub" selected="@(Model.HubTypeFilter == "DropoffHub")">📍 Điểm ký gửi cộng đồng</option>
                <option value="Library" selected="@(Model.HubTypeFilter == "Library")">🏛️ Thư viện Đối tác</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm fw-bold flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Lọc CLB</button>
            <a asp-controller="S20ExchangeHubClub" asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Xem tất cả"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>

    <div class="row g-3">
        @foreach (var h in Model.Hubs)
        {
            bool isSelected = sel != null && sel.HubId == h.HubId;
            <div class="col-md-4">
                <div class="card shadow-sm rounded-4 h-100 bg-white p-3 @(isSelected ? "border border-2 border-primary" : "border")">
                    <div class="d-flex justify-content-between align-items-center mb-2 gap-1 flex-wrap">
                        <span class="badge @(h.HubType == "ClubStation" ? "bg-warning text-dark" : h.HubType == "DropoffHub" ? "bg-info text-dark" : "bg-primary")">
                            @(h.HubType == "ClubStation" ? "⛺ Câu Lạc Bộ Sách" : h.HubType == "DropoffHub" ? "📍 Trạm Ký Gửi" : "🏛️ Thư viện Đối tác")
                        </span>
                        <span class="badge @(h.IsPublicClub ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border")">
                            @(h.IsPublicClub ? "Nhóm mở" : "Cần duyệt")
                        </span>
                    </div>
                    <h6 class="fw-bold mb-1">@h.Name</h6>
                    <p class="small text-muted mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@h.Address</p>
                    <div class="p-2 rounded-3 bg-light small mt-auto border">
                        <div class="d-flex justify-content-between">
                            <span>Trưởng nhóm:</span>
                            <strong class="text-truncate ms-2">@h.ManagerName</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Thành viên nhóm:</span>
                            <span><strong class="text-primary">@h.ApprovedMembersCount</strong> thành viên @(h.PendingMembersCount > 0 ? $"({h.PendingMembersCount} chờ duyệt)" : "")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Sách đang lưu trạm:</span>
                            <strong>@h.CopiesStoredCount bản sao</strong>
                        </div>
                        <div class="d-flex gap-1 mt-2">
                            <a asp-controller="S20ExchangeHubClub" asp-action="Index" asp-route-hubId="@h.HubId"
                               class="btn btn-xs @(isSelected ? "btn-primary" : "btn-outline-primary") fw-bold flex-grow-1">
                                <i class="bi bi-door-open-fill me-1"></i>@(isSelected ? "Đang xem CLB này" : "Mở Không Gian CLB")
                            </a>
                            @if (isAdmin || (isAuthenticated && h.ManagerUserId == Model.CurrentUserId))
                            {
                                <button type="button" class="btn btn-xs btn-outline-secondary js-s20-edit-hub"
                                        data-hub-id="@h.HubId"
                                        data-hub-name="@h.Name"
                                        data-hub-address="@h.Address"
                                        data-hub-hours="@h.OpenHours"
                                        data-hub-phone="@h.Phone"
                                        data-hub-desc="@(h.Description ?? "")"
                                        data-hub-rules="@(h.ClubRules ?? "")"
                                        data-hub-public="@(h.IsPublicClub ? "1" : "0")"
                                        title="Cập nhật thông tin &amp; điều lệ CLB">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- KHÔNG GIAN NHÓM CỦA CÂU LẠC BỘ ĐANG CHỌN -->
@if (sel != null)
{
    <section class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 border-start border-4 border-primary" id="selectedClubWorkspace" data-hub-id="@sel.HubId">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 pb-3 mb-3 border-bottom">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <span class="badge bg-primary">KHÔNG GIAN NHÓM CLB #@sel.HubId</span>
                    <span class="badge bg-warning text-dark"><i class="bi bi-crown-fill me-1"></i>Trưởng nhóm: @sel.ManagerName</span>
                    <span class="badge bg-info text-dark">@sel.ApprovedMembersCount thành viên</span>
                    <span class="badge bg-light text-dark border">@sel.OpenHours@(User.Identity?.IsAuthenticated == true ? $" • {sel.Phone}" : "")</span>
                </div>
                <h4 class="fw-bold mb-1">@sel.Name</h4>
                @if (!string.IsNullOrWhiteSpace(sel.Description))
                {
                    <p class="small text-muted mb-1">@sel.Description</p>
                }
                @if (!string.IsNullOrWhiteSpace(sel.ClubRules))
                {
                    <div class="small bg-body-tertiary border rounded-3 px-3 py-2 mt-2">
                        <strong class="text-primary"><i class="bi bi-journal-check me-1"></i>Điều lệ &amp; Nội quy CLB:</strong>
                        <span>@sel.ClubRules</span>
                    </div>
                }
            </div>

            <div class="d-flex flex-wrap gap-2">
                @if (isAuthenticated)
                {
                    @if (Model.IsCurrentUserClubMember)
                    {
                        <span class="badge bg-success py-2 px-3 align-self-center">
                            <i class="bi bi-check-circle-fill me-1"></i>Đã là @(Model.CurrentUserClubRole == "Leader" ? "Trưởng nhóm" : Model.CurrentUserClubRole == "ViceLeader" ? "Phó nhóm" : "Thành viên")
                        </span>
                        @if (Model.CurrentUserClubRole != "Leader" && sel.ManagerUserId != Model.CurrentUserId)
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm fw-semibold" id="btnLeaveSelectedClub" data-hub-id="@sel.HubId">
                                <i class="bi bi-box-arrow-left me-1"></i>Rời CLB
                            </button>
                        }
                    }
                    else if (Model.CurrentUserClubStatus == "Pending")
                    {
                        <span class="badge bg-warning text-dark py-2 px-3 align-self-center">
                            <i class="bi bi-hourglass-split me-1"></i>Đang chờ Trưởng nhóm duyệt
                        </span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary btn-sm fw-bold" id="btnJoinSelectedClub" data-hub-id="@sel.HubId">
                            <i class="bi bi-person-plus-fill me-1"></i>@(sel.IsPublicClub ? "Tham Gia CLB Ngay" : "Gửi Đơn Gia Nhập CLB")
                        </button>
                    }
                }
                else
                {
                    <a asp-controller="S01AuthOtpGoogle" asp-action="Index" class="btn btn-outline-primary btn-sm fw-bold">
                        Đăng nhập để tham gia CLB
                    </a>
                }
            </div>
        </div>

        <div class="row g-4">
            <!-- CỘT TRÁI: THÀNH VIÊN GROUP CLB (THÊM THÀNH VIÊN NHƯ GROUP, DUYỆT ĐƠN, BỔ NHIỆM TRƯỞNG/PHÓ NHÓM) -->
            <div class="col-lg-7">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-people-fill text-primary me-2"></i>Thành Viên Nhóm CLB (@Model.TotalFilteredMembers)</h5>
                    <form method="get" asp-controller="S20ExchangeHubClub" asp-action="Index" class="d-flex gap-1 align-items-center">
                        <input type="hidden" name="hubId" value="@sel.HubId" />
                        <input type="hidden" name="clubKeyword" value="@Model.ClubKeyword" />
                        <input type="hidden" name="hubType" value="@Model.HubTypeFilter" />
                        <input type="hidden" name="orderStatus" value="@Model.OrderStatusFilter" />
                        <input type="hidden" name="orderPage" value="@Model.OrderPage" />
                        <select name="memberStatus" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Lọc trạng thái thành viên CLB">
                            <option value="all" selected="@(Model.MemberStatusFilter == "all")">Tất cả thành viên</option>
                            <option value="Approved" selected="@(Model.MemberStatusFilter == "Approved")">Đã duyệt</option>
                            <option value="Pending" selected="@(Model.MemberStatusFilter == "Pending")">Đang chờ duyệt (@sel.PendingMembersCount)</option>
                        </select>
                    </form>
                </div>

                @if (Model.CanManageSelectedClub)
                {
                    <!-- FORM ADD THÀNH VIÊN NHƯ GROUP (CHỈ CHỌN TỪ DANH SÁCH BẠN BÈ ĐÃ KẾT BẠN - 0 LỘ EMAIL NGƯỜI LẠ) -->
                    <div class="p-3 rounded-4 border bg-body-tertiary mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-1 mb-2">
                            <div class="small fw-bold text-primary">
                                <i class="bi bi-person-fill-add me-1"></i>Thêm Bạn Bè Vào Nhóm CLB
                            </div>
                            <a href="#friendNetworkSection" class="small text-decoration-none fw-semibold">
                                <i class="bi bi-people me-1"></i>Kết bạn mới &darr;
                            </a>
                        </div>
                        <form id="formAddClubMember" class="row g-2 align-items-end">
                            <input type="hidden" id="addMemberHubId" value="@sel.HubId" />
                            <div class="@(isAdmin ? "col-md-5" : "col-md-8")">
                                <label class="form-label small text-muted mb-1" for="addMemberUserId">Chọn từ Bạn bè đã kết bạn (@Model.Friends.Count)</label>
                                <select id="addMemberUserId" class="form-select form-select-sm">
                                    <option value="">@(Model.Friends.Any() ? "-- Chọn bạn bè muốn mời vào CLB --" : "-- Bạn chưa có bạn bè nào, hãy kết bạn ở mục bên dưới --")</option>
                                    @foreach (var f in Model.Friends)
                                    {
                                        <option value="@f.UserId">@f.FullName (Uy tín: @f.TrustScore@(f.IsInSelectedClub ? " • Đã ở CLB" : ""))</option>
                                    }
                                </select>
                            </div>
                            @if (isAdmin)
                            {
                                <div class="col-md-4">
                                    <label class="form-label small text-muted mb-1" for="addMemberEmail">Hoặc nhập chính xác Email</label>
                                    <input type="email" id="addMemberEmail" class="form-control form-control-sm" autocomplete="off" placeholder="Nhập chính xác địa chỉ email..." />
                                </div>
                            }
                            <div class="@(isAdmin ? "col-md-3" : "col-md-4")">
                                <label class="form-label small text-muted mb-1" for="addMemberRole">Vai trò nhóm</label>
                                <select id="addMemberRole" class="form-select form-select-sm">
                                    <option value="Member" selected>Thành viên</option>
                                    @if (Model.IsSelectedClubLeader)
                                    {
                                        <option value="ViceLeader">Phó nhóm</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                                @if (Model.IsSelectedClubLeader && Model.EligibleLeaderMembers.Any())
                                {
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <select id="assignLeaderUserId" class="form-select form-select-sm w-auto" aria-label="Chuyển giao Trưởng nhóm cho thành viên CLB">
                                            @foreach (var mem in Model.EligibleLeaderMembers)
                                            {
                                                <option value="@mem.UserId" selected="@(mem.UserId == sel.ManagerUserId)">Trưởng nhóm: @mem.FullName</option>
                                            }
                                        </select>
                                        <button type="button" id="btnAssignClubLeader" data-hub-id="@sel.HubId" class="btn btn-outline-warning text-dark btn-xs fw-bold">
                                            <i class="bi bi-award-fill me-1"></i>Chuyển Giao Trưởng Nhóm
                                        </button>
                                    </div>
                                }
                                <button type="submit" class="btn btn-primary btn-sm fw-bold ms-auto">
                                    <i class="bi bi-person-plus-fill me-1"></i>Thêm Vào Nhóm
                                </button>
                            </div>
                        </form>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0 table-mobile-cards">
                        <thead class="table-light">
                            <tr>
                                <th>Thành viên</th>
                                <th>Vai trò CLB</th>
                                <th>Trạng thái</th>
                                @if (Model.CanManageSelectedClub)
                                {
                                    <th class="text-end">Điều phối nhóm</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.SelectedClubMembers)
                            {
                                <tr>
                                    <td data-label="Thành viên">
                                        <div class="fw-bold">@m.FullName</div>
                                        <small class="text-muted">Điểm uy tín: @m.TrustScore</small>
                                    </td>
                                    <td data-label="Vai trò CLB">
                                        <span class="badge @(m.MemberRole == "Leader" ? "bg-warning text-dark" : m.MemberRole == "ViceLeader" ? "bg-info text-dark" : "bg-light text-dark border")">
                                            @(m.MemberRole == "Leader" ? "👑 Trưởng nhóm" : m.MemberRole == "ViceLeader" ? "⭐ Phó nhóm" : "Thành viên")
                                        </span>
                                    </td>
                                    <td data-label="Trạng thái">
                                        <span class="badge @(m.Status == "Approved" ? "bg-success" : "bg-warning text-dark")">
                                            @(m.Status == "Approved" ? "Chính thức" : "Chờ duyệt")
                                        </span>
                                    </td>
                                    @if (Model.CanManageSelectedClub)
                                    {
                                        <td class="text-end" data-label="Điều phối nhóm">
                                            <div class="d-flex justify-content-end gap-1 flex-wrap">
                                                @if (m.Status == "Pending")
                                                {
                                                    <button type="button" class="btn btn-xs btn-success fw-bold js-club-review-member"
                                                            data-hub-id="@sel.HubId" data-member-id="@m.MemberId" data-approve="true">
                                                        Duyệt vào
                                                    </button>
                                                    <button type="button" class="btn btn-xs btn-outline-danger js-club-review-member"
                                                            data-hub-id="@sel.HubId" data-member-id="@m.MemberId" data-approve="false">
                                                        Từ chối
                                                    </button>
                                                }
                                                else if (Model.IsSelectedClubLeader && m.MemberRole != "Leader")
                                                {
                                                    <button type="button" class="btn btn-xs btn-outline-primary js-club-role-member"
                                                            data-hub-id="@sel.HubId" data-member-id="@m.MemberId"
                                                            data-new-role="@(m.MemberRole == "ViceLeader" ? "Member" : "ViceLeader")">
                                                        @(m.MemberRole == "ViceLeader" ? "Hạ thành viên" : "Lên Phó nhóm")
                                                    </button>
                                                    <button type="button" class="btn btn-xs btn-outline-danger js-club-remove-member"
                                                            data-hub-id="@sel.HubId" data-member-id="@m.MemberId" data-member-name="@m.FullName">
                                                        Mời rời
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.MemberTotalPages > 1)
                {
                    <nav class="mt-2 d-flex justify-content-end" aria-label="Phân trang thành viên CLB">
                        <ul class="pagination pagination-sm mb-0">
                            @for (int p = 1; p <= Model.MemberTotalPages; p++)
                            {
                                <li class="page-item @(p == Model.MemberPage ? "active" : "")">
                                    <a class="page-link" asp-controller="S20ExchangeHubClub" asp-action="Index"
                                       asp-route-hubId="@sel.HubId" asp-route-memberStatus="@Model.MemberStatusFilter"
                                       asp-route-memberPage="@p" asp-route-orderStatus="@Model.OrderStatusFilter" asp-route-orderPage="@Model.OrderPage">@p</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>

            <!-- CỘT PHẢI: BẢNG TIN & THÔNG BÁO NỘI BỘ CỦA RIÊNG CLB -->
            <div class="col-lg-5">
                <h5 class="fw-bold mb-3"><i class="bi bi-megaphone-fill text-warning me-2"></i>Bảng Tin Nội Bộ CLB</h5>
                @if (Model.CanManageSelectedClub)
                {
                    <form id="formCreateClubPost" class="p-3 rounded-4 border bg-body-tertiary mb-3 d-flex flex-column gap-2">
                        <input type="hidden" id="clubPostHubId" value="@sel.HubId" />
                        <input type="text" id="clubPostTitle" class="form-control form-control-sm fw-semibold" placeholder="Tiêu đề thông báo / Lịch sinh hoạt CLB..." required />
                        <textarea id="clubPostContent" class="form-control form-control-sm" rows="2" placeholder="Nội dung sinh hoạt, lịch đổi sách, thông báo tới thành viên..." required></textarea>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="form-check small mb-0">
                                <input class="form-check-input" type="checkbox" id="clubPostPinned" />
                                <label class="form-check-label" for="clubPostPinned">Ghim đầu bảng tin</label>
                            </div>
                            <button type="submit" class="btn btn-warning text-dark btn-xs fw-bold">
                                <i class="bi bi-send-fill me-1"></i>Đăng Bảng Tin
                            </button>
                        </div>
                    </form>
                }

                <div class="d-flex flex-column gap-2" style="max-height: 360px; overflow-y: auto;">
                    @if (!Model.SelectedClubPosts.Any())
                    {
                        <div class="p-3 rounded-3 border bg-light small text-muted text-center">
                            Chưa có thông báo nội bộ nào trong CLB này.
                        </div>
                    }
                    else
                    {
                        @foreach (var post in Model.SelectedClubPosts)
                        {
                            <div class="p-3 rounded-3 border @(post.IsPinned ? "border-warning bg-warning bg-opacity-10" : "bg-light") small">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="fw-bold">
                                        @if (post.IsPinned)
                                        {
                                            <span class="badge bg-warning text-dark me-1">📌 Ghim</span>
                                        }
                                        @post.Title
                                    </div>
                                    @if (Model.CanManageSelectedClub)
                                    {
                                        <button type="button" class="btn btn-link text-danger p-0 small js-club-delete-post"
                                                data-hub-id="@sel.HubId" data-post-id="@post.PostId" title="Xóa bài đăng">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                                <p class="mb-1 mt-1" style="white-space:pre-line;">@post.Content</p>
                                <small class="text-muted">@post.AuthorName • @post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </section>
}

<!-- MẠNG LƯỚI BẠN BÈ & LỜI MỜI KẾT BẠN (CHẤP NHẬN / TỪ CHỐI / MỜI VÀO CLB) -->
<section class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4" id="friendNetworkSection">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
        <div>
            <span class="badge bg-success mb-1 px-3 py-1 rounded-pill">KẾT NỐI BẠN ĐỌC &amp; QUYỀN RIÊNG TƯ</span>
            <h4 class="fw-bold mb-1"><i class="bi bi-people-fill text-success me-2"></i>Mạng Lưới Bạn Bè &amp; Lời Mời Kết Bạn</h4>
            <p class="small text-muted mb-0">
                Kết bạn trước khi mời thành viên vào Câu lạc bộ. Mọi thành viên đều có toàn quyền <strong>Chấp nhận</strong> hoặc <strong>Từ chối</strong> lời mời kết bạn, tuyệt đối không công khai Email cá nhân.
            </p>
        </div>
        @if (isAuthenticated)
        {
            <div class="d-flex flex-wrap gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                    <i class="bi bi-person-check-fill me-1"></i>Bạn bè: @Model.Friends.Count
                </span>
                <span class="badge @(Model.IncomingFriendRequests.Any() ? "bg-danger" : "bg-secondary-subtle text-secondary border") px-3 py-2">
                    <i class="bi bi-person-plus-fill me-1"></i>Lời mời đến: @Model.IncomingFriendRequests.Count
                </span>
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2">
                    <i class="bi bi-send-fill me-1"></i>Đã gửi: @Model.OutgoingFriendRequests.Count
                </span>
            </div>
        }
    </div>

    @if (!isAuthenticated)
    {
        <div class="p-4 rounded-4 border bg-body-tertiary text-center">
            <i class="bi bi-shield-lock-fill text-primary fs-2 d-block mb-2"></i>
            <h6 class="fw-bold mb-1">Đăng nhập để tìm kiếm và kết bạn cùng cộng đồng đọc sách</h6>
            <p class="small text-muted mb-3">Tài khoản đăng nhập có thể gửi lời mời kết bạn, chấp nhận hoặc từ chối lời mời và mời bạn bè vào nhóm Câu lạc bộ.</p>
            <a asp-controller="S01AuthOtpGoogle" asp-action="Index" class="btn btn-primary btn-sm fw-bold">
                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập ngay
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- CỘT 1: TÌM KIẾM & GỬI LỜI MỜI KẾT BẠN (KHÔNG LỘ DANH BẠ EMAIL) -->
            <div class="col-lg-4">
                <div class="p-3 rounded-4 border bg-body-tertiary h-100 d-flex flex-column">
                    <h6 class="fw-bold mb-2"><i class="bi bi-search text-primary me-1"></i>Tìm &amp; Gửi Lời Mời Kết Bạn</h6>
                    <form id="formSearchFriends" class="d-flex flex-column gap-2 mb-3">
                        <div class="input-group input-group-sm">
                            <input type="text" id="friendSearchKeyword" class="form-control" autocomplete="off"
                                   placeholder="Nhập tên hiển thị hoặc chính xác Email..." minlength="2" required />
                            <button type="submit" class="btn btn-primary fw-bold">
                                <i class="bi bi-search me-1"></i>Tìm
                            </button>
                        </div>
                        <input type="text" id="friendRequestNote" class="form-control form-control-sm" maxlength="250"
                               placeholder="Lời nhắn kết bạn (không bắt buộc)..." />
                    </form>
                    <div id="friendSearchResults" class="d-flex flex-column gap-2 flex-grow-1" style="max-height: 290px; overflow-y: auto;">
                        <div class="small text-muted text-center py-3 border rounded-3 bg-white">
                            Nhập tên thành viên (tối thiểu 2 ký tự) hoặc chính xác Email để tìm và gửi lời mời kết bạn.
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT 2: LỜI MỜI KẾT BẠN ĐẾN (CHẤP NHẬN / TỪ CHỐI) -->
            <div class="col-lg-4">
                <div class="p-3 rounded-4 border bg-body-tertiary h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0"><i class="bi bi-inbox-fill text-warning me-1"></i>Lời Mời Kết Bạn Đến</h6>
                        <span class="badge @(Model.IncomingFriendRequests.Any() ? "bg-danger" : "bg-secondary")">@Model.IncomingFriendRequests.Count</span>
                    </div>
                    <div class="d-flex flex-column gap-2 flex-grow-1" style="max-height: 350px; overflow-y: auto;">
                        @if (!Model.IncomingFriendRequests.Any())
                        {
                            <div class="small text-muted text-center py-4 border rounded-3 bg-white">
                                Hiện không có lời mời kết bạn nào đang chờ bạn phản hồi.
                            </div>
                        }
                        else
                        {
                            @foreach (var req in Model.IncomingFriendRequests)
                            {
                                <div class="p-2 rounded-3 border bg-white small">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <img src="@req.AvatarUrl" alt="Ảnh đại diện @req.FullName"
                                             onerror="this.onerror=null;this.src='/images/avatar-default.svg';"
                                             class="rounded-circle border" style="width:36px;height:36px;object-fit:cover;" />
                                        <div class="flex-grow-1 min-w-0">
                                            <div class="fw-bold text-truncate">@req.FullName</div>
                                            <div class="text-muted" style="font-size:0.75rem;">Uy tín @req.TrustScore • @req.CreatedAt.ToString("dd/MM HH:mm")</div>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(req.Message))
                                    {
                                        <div class="text-muted fst-italic mb-2" style="font-size:0.78rem;">“@req.Message”</div>
                                    }
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-xs btn-success fw-bold flex-fill js-friend-respond"
                                                data-friendship-id="@req.FriendshipId" data-accept="true">
                                            <i class="bi bi-check-lg me-1"></i>Chấp nhận
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-danger fw-semibold flex-fill js-friend-respond"
                                                data-friendship-id="@req.FriendshipId" data-accept="false">
                                            <i class="bi bi-x-lg me-1"></i>Từ chối
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- CỘT 3: DANH SÁCH BẠN BÈ & LỜI MỜI ĐÃ GỬI -->
            <div class="col-lg-4">
                <div class="p-3 rounded-4 border bg-body-tertiary h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0"><i class="bi bi-person-hearts text-success me-1"></i>Bạn Bè Của Tôi (@Model.Friends.Count)</h6>
                    </div>
                    <div class="d-flex flex-column gap-2 mb-3" style="max-height: 220px; overflow-y: auto;">
                        @if (!Model.Friends.Any())
                        {
                            <div class="small text-muted text-center py-3 border rounded-3 bg-white">
                                Chưa có bạn bè nào. Hãy tìm kiếm và kết bạn để mời nhau vào nhóm CLB!
                            </div>
                        }
                        else
                        {
                            @foreach (var f in Model.Friends)
                            {
                                <div class="p-2 rounded-3 border bg-white small d-flex align-items-center justify-content-between gap-2">
                                    <div class="d-flex align-items-center gap-2 min-w-0">
                                        <img src="@f.AvatarUrl" alt="Ảnh đại diện @f.FullName"
                                             onerror="this.onerror=null;this.src='/images/avatar-default.svg';"
                                             class="rounded-circle border flex-shrink-0" style="width:32px;height:32px;object-fit:cover;" />
                                        <div class="min-w-0">
                                            <div class="fw-bold text-truncate">@f.FullName</div>
                                            <div class="text-muted" style="font-size:0.74rem;">Uy tín @f.TrustScore</div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                        @if (Model.CanManageSelectedClub && sel != null)
                                        {
                                            if (f.IsInSelectedClub)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Trong CLB</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-xs btn-primary fw-bold js-friend-quick-add"
                                                        data-hub-id="@sel.HubId" data-user-id="@f.UserId" data-user-name="@f.FullName"
                                                        title="Thêm trực tiếp vào CLB đang xem">
                                                    <i class="bi bi-plus-circle me-1"></i>Vào CLB
                                                </button>
                                            }
                                        }
                                        <button type="button" class="btn btn-xs btn-outline-secondary js-friend-remove"
                                                data-friendship-id="@f.FriendshipId" data-peer-name="@f.FullName" data-is-pending="0"
                                                title="Hủy kết bạn">
                                            <i class="bi bi-person-dash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (Model.OutgoingFriendRequests.Any())
                    {
                        <div class="small fw-bold text-muted mb-1"><i class="bi bi-hourglass-split me-1"></i>Lời mời bạn đã gửi (@Model.OutgoingFriendRequests.Count)</div>
                        <div class="d-flex flex-column gap-1" style="max-height: 120px; overflow-y: auto;">
                            @foreach (var outReq in Model.OutgoingFriendRequests)
                            {
                                <div class="px-2 py-1 rounded-3 border bg-white small d-flex justify-content-between align-items-center gap-2">
                                    <span class="text-truncate"><strong>@outReq.FullName</strong> <span class="text-muted">(Chờ phản hồi)</span></span>
                                    <button type="button" class="btn btn-xs btn-outline-danger js-friend-remove"
                                            data-friendship-id="@outReq.FriendshipId" data-peer-name="@outReq.FullName" data-is-pending="1">
                                        Thu hồi
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</section>

<!-- KÝ GỬI SÁCH, KIỂM ĐỊNH SÁCH THẬT & ĐIỀU PHỐI GIAO NHẬN TẠI TRẠM CLB -->
<div class="row g-4">
    <div class="col-lg-5 d-flex flex-column gap-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-box-seam-fill text-primary me-2"></i>1. Đăng Ký Ký Gửi Sách P2P Tại Trạm CLB</h5>
                <form id="formRegisterDropoff" class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-bold" for="dropoffCopyId">Chọn Bản sao sách P2P cần gửi trạm</label>
                        <select id="dropoffCopyId" class="form-select">
                            @foreach (var c in Model.HubCopies)
                            {
                                <option value="@c.BookCopyId">[@c.Barcode] @c.BookTitle (Chủ: @c.OwnerName)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small fw-bold" for="dropoffHubId">Chọn Điểm trạm / CLB nhận ký gửi</label>
                        <select id="dropoffHubId" class="form-select">
                            @foreach (var h in Model.Hubs)
                            {
                                <option value="@h.HubId" selected="@(sel != null && h.HubId == sel.HubId)">@h.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-outline-primary fw-bold">
                        <i class="bi bi-pin-map-fill me-1"></i>Đăng Ký Ký Gửi Tại Điểm Trạm
                    </button>
                </form>
            </div>
        </div>

        @if (Model.CanManageSelectedClub || User.IsInRole("Curator") || User.IsInRole("Admin"))
        {
            <div class="card border-0 shadow-sm rounded-4 bg-white border-start border-4 border-warning">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold mb-0"><i class="bi bi-patch-check-fill text-warning me-2"></i>2. Kiểm Định Sách Thật Tại Điểm Trạm</h5>
                        <span class="badge bg-dark">Trưởng nhóm CLB / Quản trị</span>
                    </div>
                    <p class="small text-muted mb-3">Cộng <strong>+2 Điểm Uy tín</strong> cho chủ sách sau khi hoàn tất xác minh sách thật lần đầu.</p>

                    <form id="formCuratorVerify" class="d-flex flex-column gap-3">
                        <input type="hidden" id="verifyHubId" value="@(sel?.HubId ?? 3)" />
                        <div>
                            <label class="form-label small fw-bold" for="verifyCopyId">Bản sao sách kiểm định tại Trạm CLB</label>
                            <select id="verifyCopyId" class="form-select">
                                @foreach (var c in Model.HubCopies)
                                {
                                    <option value="@c.BookCopyId">[@c.Barcode] @c.BookTitle (@c.Condition • @c.ShelfLocation)</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small fw-bold" for="verifyCondition">Cấp độ vật lý thực tế</label>
                                <select id="verifyCondition" class="form-select">
                                    <option value="New">New (Mới 99%)</option>
                                    <option value="Good" selected>Good (Tốt, đủ trang)</option>
                                    <option value="Fair">Fair (Khá)</option>
                                    <option value="Worn">Worn (Sờn gáy)</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold" for="verifyShelfLocation">Ngăn kệ tại Trạm CLB</label>
                                <input type="text" id="verifyShelfLocation" class="form-control" value="Trạm CLB-K1 (Đã kiểm định)" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning fw-bold text-dark">
                            <i class="bi bi-shield-fill-check me-1"></i>Xác Nhận Kiểm Định Sách Thật (+2 Uy Tín)
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-0"><i class="bi bi-arrow-left-right text-primary me-2"></i>Điều Phối Ký Gửi &amp; Giao Nhận Sách Trung Gian</h5>
                        <small class="text-muted">Trưởng nhóm CLB xác nhận Chủ sách gửi sách &rarr; Người mượn nhận sách &rarr; Hoàn trả tại Trạm</small>
                    </div>
                    <form method="get" asp-controller="S20ExchangeHubClub" asp-action="Index" class="d-flex gap-1 align-items-center">
                        <input type="hidden" name="hubId" value="@(sel?.HubId)" />
                        <input type="hidden" name="clubKeyword" value="@Model.ClubKeyword" />
                        <input type="hidden" name="hubType" value="@Model.HubTypeFilter" />
                        <input type="hidden" name="memberStatus" value="@Model.MemberStatusFilter" />
                        <input type="hidden" name="memberPage" value="@Model.MemberPage" />
                        <select name="orderStatus" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Lọc trạng thái đơn giao nhận">
                            <option value="all" selected="@(Model.OrderStatusFilter == "all")">Tất cả (@Model.TotalFilteredOrders đơn)</option>
                            <option value="Pending" selected="@(Model.OrderStatusFilter == "Pending")">Chờ duyệt</option>
                            <option value="Approved" selected="@(Model.OrderStatusFilter == "Approved")">Đã duyệt</option>
                            <option value="InTransit" selected="@(Model.OrderStatusFilter == "InTransit")">Đã ký gửi tại Trạm</option>
                            <option value="Borrowed" selected="@(Model.OrderStatusFilter == "Borrowed")">Đang mượn</option>
                        </select>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0 table-mobile-cards">
                        <thead class="table-light">
                            <tr>
                                <th>Đơn / Bản sao</th>
                                <th>Chủ sách &rarr; Người mượn</th>
                                <th>Trạng thái</th>
                                <th>Xác nhận tại Điểm trạm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ord in Model.HubP2POrders)
                            {
                                <tr>
                                    <td data-label="Đơn / Bản sao">
                                        <code>#REQ-@ord.LoanRequestId</code> • <code>@ord.Barcode</code>
                                        <div class="fw-bold">@ord.BookTitle</div>
                                        <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@ord.HubName</small>
                                    </td>
                                    <td data-label="Chủ sách → Người mượn">
                                        <div>Chủ: <strong>@ord.OwnerName</strong></div>
                                        <div>Mượn: <strong class="text-primary">@ord.BorrowerName</strong> (Uy tín: @ord.BorrowerTrustScore)</div>
                                    </td>
                                    <td data-label="Trạng thái">
                                        <span class="badge bg-info text-dark d-block mb-1">Đơn: @ord.RequestStatus</span>
                                        <span class="badge @(ord.CopyStatus == "Borrowed" ? "bg-warning text-dark" : ord.CopyStatus == "InTransit" ? "bg-primary" : "bg-success")">
                                            Sách: @ord.CopyStatus
                                        </span>
                                    </td>
                                    <td data-label="Xác nhận tại Điểm trạm">
                                        @if (Model.CanManageSelectedClub || User.IsInRole("Curator") || User.IsInRole("Admin"))
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                <button type="button" class="btn btn-xs btn-outline-primary fw-semibold js-hub-action"
                                                        data-req-id="@ord.LoanRequestId" data-action="CheckInDropoff">
                                                    1. Nhận sách ký gửi
                                                </button>
                                                <button type="button" class="btn btn-xs btn-primary fw-bold js-hub-action"
                                                        data-req-id="@ord.LoanRequestId" data-action="HandoverToBorrower">
                                                    2. Giao người mượn (+1 Suất thưởng)
                                                </button>
                                                <button type="button" class="btn btn-xs btn-outline-success fw-semibold js-hub-action"
                                                        data-req-id="@ord.LoanRequestId" data-action="ConfirmReturnAtHub">
                                                    3. Nhận sách trả tại Trạm
                                                </button>
                                                <div class="d-flex gap-1 mt-1">
                                                    <button type="button" class="btn btn-xs btn-outline-dark flex-fill js-qr-create"
                                                            data-req-id="@ord.LoanRequestId" data-type="Handover">
                                                        <i class="bi bi-qr-code me-1"></i>QR Giao
                                                    </button>
                                                    <button type="button" class="btn btn-xs btn-outline-dark flex-fill js-qr-create"
                                                            data-req-id="@ord.LoanRequestId" data-type="Return">
                                                        <i class="bi bi-qr-code me-1"></i>QR Trả
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Ban điều hành CLB xử lý</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.OrderTotalPages > 1)
                {
                    <nav class="mt-3 d-flex justify-content-end" aria-label="Phân trang đơn giao nhận CLB">
                        <ul class="pagination pagination-sm mb-0">
                            @for (int p = 1; p <= Model.OrderTotalPages; p++)
                            {
                                <li class="page-item @(p == Model.OrderPage ? "active" : "")">
                                    <a class="page-link" asp-controller="S20ExchangeHubClub" asp-action="Index"
                                       asp-route-hubId="@(sel?.HubId)" asp-route-orderStatus="@Model.OrderStatusFilter"
                                       asp-route-orderPage="@p" asp-route-memberStatus="@Model.MemberStatusFilter" asp-route-memberPage="@Model.MemberPage">@p</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s20-exchange-hub-club/s20-exchange-hub-club.js" asp-append-version="true"></script>
}
