@model BookShare.Web.Models.ViewModels.S04BookNotesPageViewModel
@{
    ViewData["Title"] = "S04. Sổ Tay Ghi Chú Cá Nhân & Trích Dẫn Tâm Đắc";
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s04-book-notes-quotes/s04-book-notes-quotes.css" asp-append-version="true" />
}

<!-- 1. HEADER & BỘ LỌC THEO ĐẦU SÁCH / CHẾ ĐỘ CỘNG ĐỒNG -->
<section class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <span class="badge bg-primary mb-1">Dịch vụ S04 • BookNotesQuotes</span>
            <h4 class="fw-bold mb-1">Sổ Tay Ghi Chú & Trích Dẫn Sách Của @Model.UserFullName</h4>
            <p class="text-muted small mb-0">
                Lưu giữ trích dẫn tâm đắc (<code>QuoteText</code>), ghi chú chiêm nghiệm (<code>NoteContent</code>) theo từng trang sách (<code>PageNumber</code>) và chia sẻ công khai cùng cộng đồng.
            </p>
        </div>
        <div class="d-flex gap-3">
            <div class="p-3 rounded-4 bg-primary bg-opacity-10 text-center">
                <div class="small text-muted">Tổng ghi chú cá nhân</div>
                <div class="fs-4 fw-bold text-primary">@Model.TotalMyNotesCount ghi chú</div>
            </div>
            <div class="p-3 rounded-4 bg-success bg-opacity-10 text-center">
                <div class="small text-muted">Đang chia sẻ công khai</div>
                <div class="fs-4 fw-bold text-success" id="s04PublicCount">@Model.PublicNotesCount trích dẫn</div>
            </div>
        </div>
    </div>

    <!-- Thanh lọc nhanh theo đầu sách & Chế độ xem -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="S04BookNotesQuotes" asp-action="Index" asp-route-community="@Model.ShowCommunityPublic"
               class="s04-filter-pill @(Model.SelectedBookId == null ? "active" : "")">
                <i class="bi bi-journals"></i>
                <span>Tất cả đầu sách</span>
            </a>
            @foreach (var book in Model.MyTrackedBooks)
            {
                <a asp-controller="S04BookNotesQuotes" asp-action="Index"
                   asp-route-bookId="@book.Id" asp-route-community="@Model.ShowCommunityPublic"
                   class="s04-filter-pill @(Model.SelectedBookId == book.Id ? "active" : "")">
                    <i class="bi bi-book"></i>
                    <span>@book.Title</span>
                </a>
            }
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="S04BookNotesQuotes" asp-action="Index"
               asp-route-bookId="@Model.SelectedBookId" asp-route-community="false"
               class="btn btn-sm @(!Model.ShowCommunityPublic ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                <i class="bi bi-person-lines-fill me-1"></i>Sổ tay của tôi
            </a>
            <a asp-controller="S04BookNotesQuotes" asp-action="Index"
               asp-route-bookId="@Model.SelectedBookId" asp-route-community="true"
               class="btn btn-sm @(Model.ShowCommunityPublic ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                <i class="bi bi-globe-americas me-1"></i>Kèm trích dẫn Cộng đồng
            </a>
        </div>
    </div>
</section>

<div class="row g-4">
    <!-- 2. FORM THÊM / CẬP NHẬT GHI CHÚ & TRÍCH DẪN (BÊN TRÁI) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white sticky-top s04-editor-card">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0" id="s04FormTitle">
                        <i class="bi bi-pen-fill text-primary me-2"></i>Viết Ghi Chú & Trích Dẫn Mới
                    </h6>
                    <button type="button" id="btnResetNoteForm" class="btn btn-sm btn-light border d-none">
                        Hủy sửa
                    </button>
                </div>

                <form id="s04SaveNoteForm">
                    <input type="hidden" id="noteIdInput" value="" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Đầu sách đang đọc</label>
                        <select id="noteBookId" class="form-select" required>
                            @foreach (var b in Model.MyTrackedBooks)
                            {
                                if (Model.SelectedBookId == b.Id)
                                {
                                    <option value="@b.Id" selected>@b.Title — @b.Author (ISBN: @b.ISBN)</option>
                                }
                                else
                                {
                                    <option value="@b.Id">@b.Title — @b.Author (ISBN: @b.ISBN)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Số trang sách (<code>PageNumber</code>)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-bookmark-star text-primary"></i></span>
                            <input type="number" id="notePageNumber" class="form-control" min="1" max="5000" value="45" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Câu trích dẫn nguyên văn từ sách (<code>QuoteText</code>)</label>
                        <textarea id="noteQuoteText" class="form-control s04-quote-textarea" rows="3"
                                  placeholder="Nhập câu trích dẫn tâm đắc trong trang sách (không bắt buộc)..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Ghi chú cá nhân / Cảm nhận (<code>NoteContent</code>) *</label>
                        <textarea id="noteContentText" class="form-control" rows="4" required
                                  placeholder="Ghi lại bài học, ý tưởng ứng dụng hoặc suy nghĩ cá nhân của bạn..."></textarea>
                    </div>

                    <div class="form-check form-switch mb-3 p-3 rounded-3 bg-light border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="noteIsPublic" checked />
                        <label class="form-check-label small fw-semibold" for="noteIsPublic">
                            Chia sẻ công khai trích dẫn này lên Cộng đồng BookShare (<code>IsPublic</code>)
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-3" id="btnSubmitNote">
                        <i class="bi bi-journal-check me-1"></i>Lưu Vào Sổ Tay Ghi Chú
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 3. DANH SÁCH THẺ TRÍCH DẪN & GHI CHÚ THEO TRANG SÁCH (BÊN PHẢI) -->
    <div class="col-lg-8">
        @if (!Model.Notes.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <i class="bi bi-journal-richtext fs-1 text-muted mb-2"></i>
                <h6 class="fw-bold">Chưa có ghi chú nào cho bộ lọc hiện tại</h6>
                <p class="text-muted small mb-0">Hãy điền trích dẫn tâm đắc và cảm nhận ở khung bên trái để lưu giữ tri thức.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3" id="s04NotesTimeline">
                @foreach (var note in Model.Notes)
                {
                    <article class="s04-note-card p-4 bg-white rounded-4 shadow-sm" id="noteCard-@note.NoteId">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(note.CoverImageUrl) ? "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=200" : note.CoverImageUrl)"
                                     alt="@note.BookTitle" class="s04-book-mini-cover shadow-sm"
                                     onerror="this.src='https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=200'" />
                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold">
                                            <i class="bi bi-file-earmark-text me-1"></i>Trang @note.PageNumber
                                        </span>
                                        <span class="badge @(note.IsPublic ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")"
                                              id="noteBadgePublic-@note.NoteId">
                                            <i class="bi @(note.IsPublic ? "bi-globe2" : "bi-lock-fill") me-1"></i>
                                            @(note.IsPublic ? "Công khai" : "Riêng tư")
                                        </span>
                                        <span class="text-muted small">• @note.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <h6 class="fw-bold mb-0 text-dark">@note.BookTitle</h6>
                                    <div class="small text-muted">Tác giả: @note.BookAuthor • Người ghi: <strong>@note.OwnerFullName</strong></div>
                                </div>
                            </div>

                            @if (note.IsOwner)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <div class="form-check form-switch mb-0" title="Bật/tắt chia sẻ công khai">
                                        <input class="form-check-input js-toggle-note-public" type="checkbox"
                                               data-note-id="@note.NoteId" @(note.IsPublic ? "checked" : "") />
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary js-edit-note"
                                            data-note-id="@note.NoteId"
                                            data-book-id="@note.BookId"
                                            data-page="@note.PageNumber"
                                            data-quote="@note.QuoteText"
                                            data-content="@note.NoteContent"
                                            data-public="@(note.IsPublic ? "true" : "false")"
                                            title="Chỉnh sửa ghi chú">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger js-delete-note"
                                            data-note-id="@note.NoteId"
                                            title="Xóa ghi chú">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(note.QuoteText))
                        {
                            <blockquote class="s04-quote-box mb-3">
                                <i class="bi bi-quote fs-4 text-primary me-1"></i>
                                <span>"@note.QuoteText"</span>
                            </blockquote>
                        }

                        <div class="s04-note-body text-dark">
                            <div class="small fw-bold text-secondary mb-1">
                                <i class="bi bi-lightbulb-fill text-warning me-1"></i>Ghi chú & Chiêm nghiệm:
                            </div>
                            <p class="mb-0">@note.NoteContent</p>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s04-book-notes-quotes/s04-book-notes-quotes.js" asp-append-version="true"></script>
}
