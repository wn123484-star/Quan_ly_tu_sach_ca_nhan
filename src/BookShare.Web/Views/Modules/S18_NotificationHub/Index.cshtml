@model BookShare.Web.Models.ViewModels.S18NotificationHubPageViewModel
@{
    ViewData["Title"] = "Cài Đặt Thông Báo, Xác Minh OTP Email & Nhắc Hạn Tự Động";
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s18-notification-hub/s18-notification-hub.css" asp-append-version="true" />
}

<section class="s18-hero card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge bg-info text-dark mb-2 px-3 py-1 rounded-pill">TRUNG TÂM THÔNG BÁO &amp; XÁC MINH EMAIL OTP</span>
            <h2 class="fw-bold mb-1">🔔 Cài Đặt Thông Báo, Xác Minh OTP Email &amp; Nhắc Hạn Tự Động</h2>
            <p class="text-muted small mb-0">
                Xác minh địa chỉ Email nhận thông báo bằng mã OTP 6 chữ số và quản lý thông báo nhắc hạn trả sách, thông báo có sách đặt trước theo thời gian thực.
            </p>
        </div>
        <div class="d-flex gap-2">
            <div class="s18-counter-box">
                <span>Chưa đọc</span>
                <strong>@Model.UnreadCount</strong>
            </div>
            <div class="s18-counter-box s18-counter-resend">
                <span>Đã gửi Resend</span>
                <strong>@Model.EmailSentCount</strong>
            </div>
        </div>
    </div>
</section>

<div class="row g-4">
    <!-- CỘT TRÁI: BẢNG ĐIỀU KHIỂN KÍCH HOẠT GỬI EMAIL RESEND -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
            <div class="card-body p-4">
                @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
                {
                    <h5 class="fw-bold mb-2"><i class="bi bi-envelope-paper-fill text-primary me-2"></i>Chiến Dịch Gửi Email Thông Báo</h5>
                    <p class="text-muted small mb-3">
                        Quét danh sách hợp đồng đến hạn và lượt đặt trước vừa có sách để gửi email nhắc nhở tự động cho bạn đọc.
                    </p>

                    <div class="d-grid gap-2 mb-3">
                        <button type="button" class="btn btn-primary fw-bold text-start p-3 rounded-3 js-trigger-campaign" data-campaign="DueReminder">
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-alarm-fill me-2"></i>Gửi Email Nhắc Hạn Trả Sách</span>
                                <span class="badge bg-light text-primary">Nhắc hạn</span>
                            </div>
                            <small class="d-block opacity-75 fw-normal mt-1">Quét toàn bộ hợp đồng đang mở &amp; quá hạn</small>
                        </button>

                        <button type="button" class="btn btn-warning fw-bold text-dark text-start p-3 rounded-3 js-trigger-campaign" data-campaign="QueueAvailable">
                            <div class="d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-fire me-2"></i>Báo Có Sách Đặt Trước Hàng Chờ</span>
                                <span class="badge bg-dark text-warning">Hàng chờ</span>
                            </div>
                            <small class="d-block opacity-75 fw-normal mt-1">Gửi thông báo giữ chỗ 48h cho đầu hàng chờ</small>
                        </button>
                    </div>
                    <hr />
                }

                <!-- Khung Xác Minh Email Nhận Thông Báo Bằng Mã OTP 6 Số -->
                <div class="p-3 rounded-4 border border-primary bg-light mb-3" id="s18OtpVerificationPanel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary"><i class="bi bi-shield-lock-fill me-1"></i>XÁC MINH EMAIL NHẬN THÔNG BÁO (OTP)</span>
                        <span id="s18OtpVerifiedBadge" class="badge bg-warning text-dark">Chờ xác minh</span>
                    </div>
                    <p class="small text-muted mb-2">
                        Nhập Email của bạn để nhận mã OTP 6 số xác minh kênh nhận thông báo nhắc hạn trả sách:
                    </p>
                    <div class="input-group input-group-sm mb-2">
                        <input type="email" id="s18VerifyEmailInput" class="form-control" value="@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")" placeholder="Nhập email nhận thông báo..." />
                        <button type="button" id="btnS18SendOtp" class="btn btn-primary fw-bold">
                            <i class="bi bi-send-check me-1"></i>Gửi OTP
                        </button>
                    </div>
                    <div id="s18DevOtpBanner" class="alert alert-warning py-2 px-3 small d-none mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <span><strong>Mã OTP 6 số:</strong></span>
                            <code id="s18DevOtpValue" class="fs-5 fw-bold text-primary">------</code>
                        </div>
                        <div class="text-muted" style="font-size:0.75rem;">Đã tự động điền mã để bạn bấm xác minh ngay.</div>
                    </div>
                    <div class="input-group input-group-sm">
                        <input type="text" id="s18OtpCodeInput" class="form-control font-monospace fw-bold text-center" maxlength="6" placeholder="Nhập 6 chữ số OTP..." />
                        <button type="button" id="btnS18ConfirmOtp" class="btn btn-success fw-bold">
                            <i class="bi bi-check2-circle me-1"></i>Xác Minh OTP
                        </button>
                    </div>
                </div>

                @if (User.IsInRole("Librarian") || User.IsInRole("Admin"))
                {
                    <hr />
                    <form id="formCustomResend" class="d-flex flex-column gap-2">
                        <label class="small fw-bold">Gửi thông báo tùy chỉnh kèm Email:</label>
                        <input type="text" id="customNotifTitle" class="form-control form-control-sm" placeholder="Tiêu đề thông báo / Email..." required />
                        <textarea id="customNotifContent" class="form-control form-control-sm" rows="2" placeholder="Nội dung chi tiết gửi tới bạn đọc..." required></textarea>
                        <button type="submit" class="btn btn-outline-primary btn-sm fw-bold">
                            <i class="bi bi-send-check-fill me-1"></i>Phát Thông Báo &amp; Gửi Email
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: DANH SÁCH THÔNG BÁO & BỘ LỌC THEO LOẠI -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-3 border-bottom">
                    <div class="d-flex flex-wrap gap-1">
                        <button type="button" class="btn btn-xs btn-primary js-filter-notif" data-type="all">Tất cả (@Model.Notifications.Count)</button>
                        <button type="button" class="btn btn-xs btn-outline-danger js-filter-notif" data-type="DueReminder">⏰ Nhắc hạn trả</button>
                        <button type="button" class="btn btn-xs btn-outline-warning text-dark js-filter-notif" data-type="QueueAvailable">🔥 Hàng chờ Sách Hot</button>
                        <button type="button" class="btn btn-xs btn-outline-success js-filter-notif" data-type="LoanApproved">✅ Duyệt mượn</button>
                        <button type="button" class="btn btn-xs btn-outline-secondary js-filter-notif" data-type="Dispute">⚖️ Tranh chấp</button>
                        <button type="button" class="btn btn-xs btn-outline-dark js-filter-notif" data-type="System">⚙️ Hệ thống</button>
                    </div>
                    <button type="button" id="btnMarkAllRead" class="btn btn-sm btn-outline-success fw-bold">
                        <i class="bi bi-check2-all me-1"></i>Đánh dấu tất cả đã đọc
                    </button>
                </div>

                <div class="d-flex flex-column gap-3" id="notifListContainer">
                    @foreach (var n in Model.Notifications)
                    {
                        <div id="notif-card-@n.Id" class="s18-notif-card @(n.IsRead ? "is-read" : "is-unread")" data-notif-type="@n.Type">
                            <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap mb-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge @(n.Type == "DueReminder" ? "bg-danger" : n.Type == "QueueAvailable" ? "bg-warning text-dark" : n.Type == "Dispute" ? "bg-dark" : "bg-primary")">
                                        @n.Type
                                    </span>
                                    @if (n.EmailSentViaResend)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                            <i class="bi bi-envelope-check-fill me-1"></i>Đã gửi Email
                                        </span>
                                    }
                                    @if (!n.IsRead)
                                    {
                                        <span class="badge bg-danger rounded-pill">Mới</span>
                                    }
                                    <strong class="text-dark">@n.Title</strong>
                                </div>
                                <small class="text-muted">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>

                            <p class="small text-secondary mb-2">@n.Content</p>

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <small class="text-muted">Người nhận: <strong>@n.UserFullName</strong> (<code>@n.UserEmail</code>)</small>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(n.DetailUrl) && !n.DetailUrl.StartsWith("/S18NotificationHub"))
                                    {
                                        <a href="@n.DetailUrl" class="btn btn-xs btn-outline-info fw-semibold">
                                            Xem trang liên quan &rarr;
                                        </a>
                                    }
                                    @if (!n.IsRead)
                                    {
                                        <button type="button" class="btn btn-xs btn-outline-primary js-mark-read" data-id="@n.Id">
                                            <i class="bi bi-check2 me-1"></i>Đánh dấu đã đọc
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="small text-success"><i class="bi bi-check2-all me-1"></i>Đã đọc</span>
                                    }
                                    <button type="button" class="btn btn-xs btn-outline-danger py-0 px-2 js-delete-notif" data-id="@n.Id" title="Xóa thông báo này">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s18-notification-hub/s18-notification-hub.js" asp-append-version="true"></script>
}
