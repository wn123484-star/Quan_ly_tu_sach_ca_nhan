@model BookShare.Web.Models.ViewModels.S17SandboxPaymentPageViewModel
@{
    ViewData["Title"] = "Ví Tiền Ảo Miễn Phí & Quét QR Thanh Toán BookShare";
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s17-sandbox-payment/s17-sandbox-payment.css" asp-append-version="true" />
}

<section class="s17-hero card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge bg-success mb-2 px-3 py-1 rounded-pill">100% TIỀN ẢO MIỄN PHÍ • KHÔNG NGÂN HÀNG THẬT</span>
            <h2 class="fw-bold mb-1">💳 Ví Tiền Ảo &amp; Thanh Toán QR BookShare</h2>
            <p class="text-muted small mb-3">
                Nạp tiền ảo miễn phí thoải mái để đăng ký gói hội viên 4 cấp, thanh toán phí trễ hạn hoặc ký quỹ bảo lãnh sách quý (hoàn 100% về ví khi trả sách). Hỗ trợ <strong>Quét QR Thanh Toán</strong> bằng camera đồng bộ tức thì giữa Web và Ứng dụng di động.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" id="btnS17ScanQrPay" class="btn btn-primary fw-bold rounded-pill px-4 js-open-qr-pay-scanner">
                    <i class="bi bi-qr-code-scan me-2"></i>Quét QR Thanh Toán (Mở Camera)
                </button>
                <a asp-controller="S16MembershipTier" asp-action="Index" class="btn btn-outline-primary fw-bold rounded-pill px-3">
                    <i class="bi bi-gem me-1"></i>Xem Bảng Giá 4 Cấp Hội Viên
                </a>
            </div>
        </div>
        <div class="s17-stat-box">
            <div class="small opacity-75">Số dư Ví Tiền Ảo (@Model.CurrentUserName)</div>
            <div class="fs-2 fw-bold text-warning" id="s17WalletBalanceValue">@Model.WalletBalance.ToString("N0")đ ảo</div>
            <div class="small opacity-90">
                Đã nạp miễn phí: <strong>@Model.TotalToppedUp.ToString("N0")đ</strong> • Đã dùng: <strong>@Model.TotalSpent.ToString("N0")đ</strong>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <!-- KHỐI 1: NẠP TIỀN ẢO MIỄN PHÍ THOẢI MÁI -->
    <div class="col-lg-5" id="walletTopUpCard">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-top border-4 border-success">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0"><i class="bi bi-cash-coin text-success me-2"></i>Nạp Tiền Ảo Miễn Phí</h5>
                    <span class="badge bg-success-subtle text-success">0đ tiền thật</span>
                </div>
                <p class="small text-muted mb-3">
                    Chọn mệnh giá nhanh hoặc nhập số tiền ảo bất kỳ (tối đa 10.000.000đ/lần, không giới hạn số lần nạp) để trải nghiệm nâng cấp gói hội viên &amp; quét QR hóa đơn.
                </p>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-outline-success btn-sm fw-bold rounded-pill js-quick-topup-chip" data-amount="50000">+50.000đ</button>
                    <button type="button" class="btn btn-outline-success btn-sm fw-bold rounded-pill js-quick-topup-chip" data-amount="100000">+100.000đ</button>
                    <button type="button" class="btn btn-outline-success btn-sm fw-bold rounded-pill js-quick-topup-chip" data-amount="200000">+200.000đ</button>
                    <button type="button" class="btn btn-outline-success btn-sm fw-bold rounded-pill js-quick-topup-chip" data-amount="500000">+500.000đ</button>
                    <button type="button" class="btn btn-outline-success btn-sm fw-bold rounded-pill js-quick-topup-chip" data-amount="1000000">+1.000.000đ</button>
                </div>

                <form id="formVirtualTopUp" class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-bold" for="topUpAmountInput">Số tiền ảo muốn nạp (đồng ảo)</label>
                        <input type="number" id="topUpAmountInput" class="form-control form-control-lg fw-bold text-success" value="200000" min="1000" max="10000000" step="1000" required />
                    </div>
                    <div>
                        <label class="form-label small fw-bold" for="topUpNoteInput">Ghi chú nạp tiền (tùy chọn)</label>
                        <input type="text" id="topUpNoteInput" class="form-control form-control-sm" placeholder="VD: Nạp tiền ảo nâng cấp gói Hội Viên Học Thuật..." />
                    </div>
                    <button type="submit" id="btnTopUpVirtualWallet" class="btn btn-success fw-bold py-2">
                        <i class="bi bi-plus-circle-fill me-1"></i>Nạp Tiền Ảo Miễn Phí Ngay
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- KHỐI 2: TẠO HÓA ĐƠN QR & THANH TOÁN HÓA ĐƠN ĐANG CHỌN -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4">
                @if (Model.SelectedPendingTxId.HasValue)
                {
                    <div class="p-3 rounded-4 border border-primary bg-primary bg-opacity-10 mb-4" id="s17ActiveInvoicePanel"
                         data-tx-id="@Model.SelectedPendingTxId"
                         data-qr-payload="@Model.SelectedQrPayload"
                         data-amount="@Model.SelectedPendingAmount"
                         data-desc="@Model.SelectedDescription">
                        <div class="row align-items-center g-3">
                            <div class="col-sm-4 text-center">
                                <div class="d-inline-block p-2 bg-white rounded-3 border shadow-sm">
                                    <div id="s17SelectedQrCanvas" style="min-width:160px; min-height:160px;" class="d-flex align-items-center justify-content-center">
                                        <span class="small text-muted">Đang vẽ QR...</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-8">
                                <span class="badge bg-primary mb-1">HÓA ĐƠN CHỜ THANH TOÁN #TX-@Model.SelectedPendingTxId</span>
                                <h5 class="fw-bold mb-1">@Model.SelectedDescription</h5>
                                <div class="fs-4 fw-bold text-primary mb-2">@Model.SelectedPendingAmount.ToString("N0")đ ảo</div>
                                <p class="small text-muted mb-3">
                                    Dùng điện thoại / Web App bấm <strong>Quét QR Thanh Toán</strong> để quét mã bên trái, xem hóa đơn và bấm Xác nhận — màn hình này sẽ tự động cập nhật ngay lập tức.
                                </p>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-success btn-sm fw-bold js-s17-pay-now" data-qr-payload="@Model.SelectedQrPayload">
                                        <i class="bi bi-check2-circle me-1"></i>Xem Hóa Đơn &amp; Thanh Toán Ngay
                                    </button>
                                    <button type="button" class="btn btn-outline-primary btn-sm fw-semibold js-open-qr-pay-scanner">
                                        <i class="bi bi-camera-fill me-1"></i>Mở Camera Quét QR
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <h5 class="fw-bold mb-3"><i class="bi bi-qr-code text-primary me-2"></i>Tạo Hóa Đơn &amp; Mã QR Thanh Toán Nội Bộ</h5>
                <form id="formCreateSandboxOrder" class="d-flex flex-column gap-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold" for="txTypeSelect">Mục đích thanh toán</label>
                            <select id="txTypeSelect" class="form-select">
                                <option value="Membership" data-amount="49000">👑 Đăng ký / Gia hạn Gói Hội Viên</option>
                                <option value="Fine" data-amount="25000">⏰ Nộp phí phạt trả sách trễ hạn</option>
                                <option value="SimulatedDeposit" data-amount="50000">🛡️ Ký quỹ bảo lãnh sách quý (Hoàn 100%)</option>
                            </select>
                        </div>
                        <div class="col-md-6" id="membershipTierPickGroup">
                            <label class="form-label small fw-bold" for="txTargetTierSelect">Hạng gói hội viên</label>
                            <select id="txTargetTierSelect" class="form-select">
                                <option value="Standard" data-amount="29000">Standard — Đọc Sâu (29.000đ / 1 tháng)</option>
                                <option value="Premium" data-amount="49000" selected>Premium — Học Thuật (49.000đ / 1 tháng)</option>
                                <option value="Scholar" data-amount="89000">Scholar — Nghiên Cứu VIP (89.000đ / 1 tháng)</option>
                            </select>
                        </div>
                    </div>

                    <div id="loanSelectGroup">
                        <label class="form-label small fw-bold" for="txLoanIdSelect">Hợp đồng mượn liên kết (dùng khi nộp phí trễ / ký quỹ)</label>
                        <select id="txLoanIdSelect" class="form-select">
                            <option value="">-- Không gắn hợp đồng (Dành cho Gói Hội Viên) --</option>
                            @foreach (var l in Model.UnpaidFineLoans)
                            {
                                <option value="@l.LoanId">Hợp đồng #@l.LoanId — [@l.Barcode] @l.BookTitle (@l.BorrowerName • Phí: @l.FineAmount.ToString("N0")đ)</option>
                            }
                        </select>
                    </div>

                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold" for="txAmountInput">Số tiền hóa đơn (đồng ảo)</label>
                            <input type="number" id="txAmountInput" class="form-control fw-bold" value="49000" min="1000" step="1000" required />
                        </div>
                        <div class="col-md-6">
                            <button type="submit" id="btnCreateOrder" class="btn btn-primary fw-bold w-100">
                                <i class="bi bi-qr-code-scan me-1"></i>Tạo Hóa Đơn &amp; Hiện Mã QR
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Khối đối soát mã xác thực nâng cao (thu gọn mặc định) -->
                <details class="mt-4 pt-3 border-top">
                    <summary class="small fw-bold text-secondary" style="cursor:pointer;">
                        <i class="bi bi-shield-lock me-1"></i>Đối soát thủ công mã xác thực hóa đơn (Nâng cao)
                    </summary>
                    <form id="formVerifyCallback" class="d-flex flex-column gap-2 mt-3">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold" for="cbTransactionId">Mã hóa đơn</label>
                                <input type="number" id="cbTransactionId" class="form-control form-control-sm font-monospace fw-bold" value="@(Model.SelectedPendingTxId?.ToString() ?? "")" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-bold" for="cbResponseCode">Trạng thái xác nhận</label>
                                <select id="cbResponseCode" class="form-select form-select-sm">
                                    <option value="00">00 — Xác nhận hoàn tất hóa đơn</option>
                                    <option value="24">24 — Hủy hóa đơn</option>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="form-label small fw-bold" for="cbRawPayload">Chuỗi dữ liệu đối soát</label>
                            <input type="text" id="cbRawPayload" class="form-control form-control-sm font-monospace bg-light" value="@Model.SelectedRawPayload" />
                        </div>
                        <div>
                            <label class="form-label small fw-bold" for="cbHmacSignature">Mã đối soát toàn vẹn</label>
                            <textarea id="cbHmacSignature" class="form-control form-control-sm font-monospace" rows="2" required>@Model.SelectedExpectedHmac</textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" id="btnVerifyCallback" class="btn btn-success btn-sm fw-bold">Xác Nhận Đối Soát</button>
                            <button type="button" id="btnTamperSignature" class="btn btn-outline-danger btn-sm">Thử mã sai</button>
                        </div>
                    </form>
                </details>
            </div>
        </div>
    </div>
</div>

<!-- BẢNG LỊCH SỬ GIAO DỊCH VÍ TIỀN ẢO & HÓA ĐƠN -->
<section class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-0"><i class="bi bi-receipt-cutoff text-primary me-2"></i>Lịch Sử Ví Tiền Ảo &amp; Hóa Đơn Thanh Toán</h5>
            <small class="text-muted">Theo dõi toàn bộ lượt nạp tiền ảo miễn phí, nâng cấp gói hội viên, nộp phí trễ và ký quỹ bảo lãnh</small>
        </div>
        <span class="badge bg-primary">@Model.Transactions.Count giao dịch</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã HĐ</th>
                    <th>Thành viên</th>
                    <th>Loại &amp; Nội dung</th>
                    <th>Số tiền ảo</th>
                    <th>Phương thức</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model.Transactions)
                {
                    bool isTopUp = tx.TransactionType == "WalletTopUp";
                    bool isCancel = tx.TransactionType == "MembershipCancel";
                    string typeBadge = tx.TransactionType switch
                    {
                        "WalletTopUp" => "bg-success",
                        "Membership" => "bg-warning text-dark",
                        "MembershipSwitch" => "bg-primary",
                        "MembershipCancel" => "bg-secondary",
                        "Fine" => "bg-danger",
                        _ => "bg-info text-dark"
                    };
                    string typeLabel = tx.TransactionType switch
                    {
                        "WalletTopUp" => "Nạp tiền ảo",
                        "Membership" => "Đăng ký gói",
                        "MembershipSwitch" => "Chuyển gói hội viên",
                        "MembershipCancel" => "Hủy gói hội viên",
                        "Fine" => "Phí trễ / Bồi thường",
                        _ => "Ký quỹ bảo lãnh"
                    };
                    <tr>
                        <td><code>#TX-@tx.TransactionId</code></td>
                        <td>
                            <strong>@tx.UserFullName</strong>
                            @if (tx.LoanId.HasValue)
                            {
                                <div><small class="text-muted">Hợp đồng #@tx.LoanId</small></div>
                            }
                        </td>
                        <td>
                            <span class="badge @typeBadge mb-1">@typeLabel</span>
                            @if (tx.SwitchFee > 0)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border ms-1">Phí chuyển: @tx.SwitchFee.ToString("N0")đ</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(tx.Description))
                            {
                                <div class="text-muted">@tx.Description</div>
                            }
                        </td>
                        <td class="fw-bold @(isTopUp ? "text-success" : isCancel ? "text-muted" : "")">
                            <div>@(isTopUp ? "+" : "")@tx.Amount.ToString("N0")đ</div>
                            @if (tx.BalanceBefore.HasValue && tx.BalanceAfter.HasValue)
                            {
                                <small class="fw-normal text-muted" style="font-size:0.7rem;">
                                    Ví: @tx.BalanceBefore.Value.ToString("N0")đ &rarr; @tx.BalanceAfter.Value.ToString("N0")đ
                                </small>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @(tx.PaymentGateway == "QrPay" ? "QR Thanh Toán" : tx.PaymentGateway == "VirtualWallet" ? "Ví Tiền Ảo" : tx.PaymentGateway)
                            </span>
                        </td>
                        <td>
                            <span class="badge @(tx.PaymentStatus == "Completed" ? "bg-success" : tx.PaymentStatus == "Pending" ? "bg-warning text-dark" : tx.PaymentStatus == "Refunded" ? "bg-info text-dark" : "bg-danger")">
                                @(tx.PaymentStatus == "Completed" ? "Hoàn tất" : tx.PaymentStatus == "Pending" ? "Chờ thanh toán" : tx.PaymentStatus == "Refunded" ? "Đã hoàn về ví" : "Đã hủy")
                            </span>
                        </td>
                        <td>
                            <div class="d-inline-flex flex-wrap align-items-center gap-1">
                                @if (tx.PaymentStatus == "Pending")
                                {
                                    <button type="button" class="btn btn-xs btn-primary fw-bold js-s17-show-qr"
                                            data-tx-id="@tx.TransactionId"
                                            data-amount="@tx.Amount"
                                            data-desc="@(tx.Description ?? typeLabel)"
                                            data-qr-payload="@tx.QrPayload">
                                        <i class="bi bi-qr-code me-1"></i>Mã QR
                                    </button>
                                    <button type="button" class="btn btn-xs btn-success fw-bold js-s17-pay-now"
                                            data-qr-payload="@tx.QrPayload">
                                        Thanh toán
                                    </button>
                                    <button type="button" class="btn btn-xs btn-outline-danger js-s17-cancel-tx" data-tx-id="@tx.TransactionId" title="Hủy hóa đơn chờ">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }
                                else if (tx.TransactionType == "SimulatedDeposit" && tx.PaymentStatus == "Completed" && (User.IsInRole("Librarian") || User.IsInRole("Admin")))
                                {
                                    <button type="button" class="btn btn-xs btn-outline-primary fw-bold js-refund-deposit" data-tx-id="@tx.TransactionId">
                                        Hoàn về Ví 100%
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">@tx.CreatedAt.ToString("dd/MM HH:mm")</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/modules/s17-sandbox-payment/s17-sandbox-payment.js" asp-append-version="true"></script>
}
