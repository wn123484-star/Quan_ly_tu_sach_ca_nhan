@model BookShare.Web.Models.ViewModels.ReadingStudioPageViewModel
@{
    ViewData["Title"] = "BookShare Reading Studio — Pomodoro Im Lặng & Kịp Hạn Thuê Sách";
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s03-reading-tracker/s03-reading-studio.css" asp-append-version="true" />
}

<!-- [BS-READING-STUDIO] KHÔNG GIAN ĐỌC SÁCH TẬP TRUNG IM LẶNG 100% (KHÔNG CÓ ÂM THANH) -->
<div id="readingStudioShell" class="rs-shell rs-surface-light rs-font-md">
    <!-- 1. THANH ĐIỀU KHIỂN MÔI TRƯỜNG ĐỌC (SEPIA / SÁNG / ĐÊM + A- / A / A+) -->
    <section class="bs-card mb-4 rs-top-bar">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="bs-badge bs-badge-info mb-1">BOOKSHARE READING STUDIO • CHẾ ĐỘ IM LẶNG TUYỆT ĐỐI</span>
                <h4 class="fw-bold mb-1">📖 @Model.BookTitle</h4>
                <div class="small bs-muted">
                    @Model.BookAuthor • Tiến độ: <strong id="rsCurrentPageText">@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong> trang (<span id="rsPercentText">@Model.PercentCompleted</span>%)
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <form method="get" asp-controller="S03ReadingTracker" asp-action="Studio" class="d-flex align-items-center gap-2">
                    <select name="bookId" class="bs-select py-1" style="width:auto; max-width:240px;" onchange="this.form.submit()" aria-label="Chọn sách đọc">
                        @foreach (var b in Model.AvailableBooks)
                        {
                            if (b.BookId == Model.SelectedBookId)
                            {
                                <option value="@b.BookId" selected>@(b.IsActiveLoan ? "📌 [Đang thuê] " : "📘 ")@b.Title (@b.CurrentPage/@b.TotalPages)</option>
                            }
                            else
                            {
                                <option value="@b.BookId">@(b.IsActiveLoan ? "📌 [Đang thuê] " : "📘 ")@b.Title (@b.CurrentPage/@b.TotalPages)</option>
                            }
                        }
                    </select>
                </form>

                <!-- Chọn nền dịu mắt: Giấy Kem Sepia / Sáng / Đêm -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Chọn nền dịu mắt">
                    <button type="button" class="btn btn-outline-secondary js-rs-surface active" data-surface="light">☀️ Sáng</button>
                    <button type="button" class="btn btn-outline-warning js-rs-surface" data-surface="sepia">📜 Sepia</button>
                    <button type="button" class="btn btn-outline-dark js-rs-surface" data-surface="night">🌙 Đêm</button>
                </div>

                <!-- Chỉnh cỡ chữ A- / A / A+ -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Chỉnh cỡ chữ">
                    <button type="button" class="btn btn-outline-primary js-rs-font" data-size="sm">A-</button>
                    <button type="button" class="btn btn-outline-primary js-rs-font active" data-size="md">A</button>
                    <button type="button" class="btn btn-outline-primary js-rs-font" data-size="lg">A+</button>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. BẢNG LỘ TRÌNH KỊP HẠN THUÊ SÁCH, TỐC ĐỘ ĐỌC & READING STREAK -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="bs-card h-100">
                <div class="small bs-muted mb-1">⏳ Đối Chiếu Hạn Trả Sách Thuê (Bảng <code>Loans</code>)</div>
                @if (Model.ActiveLoanId.HasValue && Model.ActiveLoanDueDate.HasValue)
                {
                    <div class="fw-bold fs-5 text-primary mb-1">Còn @Model.DaysRemainingUntilDue ngày (Hạn @Model.ActiveLoanDueDate.Value.ToString("dd/MM/yyyy"))</div>
                    <div class="small mb-2">
                        Mã bản sao: <code>@Model.ActiveLoanBarcode</code> • Còn <strong>@Model.RemainingPages trang</strong>.
                    </div>
                    <div class="p-2 rounded-3 bg-warning bg-opacity-10 border border-warning small fw-bold mb-2">
                        🎯 Cần đọc tối thiểu <span class="text-danger fs-6">@Model.RequiredPagesPerDay trang/ngày</span> để kịp trả đúng hạn &amp; tiết kiệm phí trễ!
                    </div>
                    @if (Model.CanQuickRenew)
                    {
                        <button type="button" id="btnRsQuickRenew" class="bs-btn bs-btn-outline w-100 py-1" data-loan-id="@Model.ActiveLoanId.Value">
                            🔄 Gia hạn thuê nhanh (+7 ngày @(Model.QuickRenewFee > 0 ? $"• {Model.QuickRenewFee:N0}đ" : "• 0đ"))
                        </button>
                    }
                }
                else
                {
                    <div class="fw-bold fs-6 mb-1">Đọc tự do theo mục tiêu cá nhân</div>
                    <div class="small bs-muted">Còn <strong>@Model.RemainingPages trang</strong>. Gợi ý duy trì tối thiểu <strong>@Math.Max(15, Model.RequiredPagesPerDay) trang/ngày</strong>.</div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="bs-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="small bs-muted mb-1">⚡ Tốc Độ Đọc Thực Tế</div>
                    <div class="display-6 fw-bold text-primary" id="rsPagesPerHour">@Model.PagesPerHour <span class="fs-6 fw-semibold">trang/giờ</span></div>
                    <div class="small bs-muted mt-1">Tổng thời gian đã ghi nhận: <strong>@Model.TotalMinutesLogged phút</strong> (@Model.TotalSessionsLogged phiên)</div>
                </div>
                <div class="progress mt-3" style="height:10px;">
                    <div id="rsProgressBar" class="progress-bar bg-primary" style="width:@Model.PercentCompleted%"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="bs-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="small bs-muted mb-1">🔥 Chuỗi Ngày Đọc Liên Tiếp (Reading Streak)</div>
                    <div class="display-6 fw-bold text-warning" id="rsStreakDays">🔥 @Model.ReadingStreakDays <span class="fs-6 fw-semibold">ngày</span></div>
                    <div class="small bs-muted mt-1">Hoàn tất ít nhất 1 phiên Pomodoro mỗi ngày để giữ chuỗi đọc và hoàn thành sách trước hạn thuê!</div>
                </div>
                <a asp-controller="S03ReadingTracker" asp-action="Index" class="bs-btn bs-btn-outline py-1 mt-2">
                    📊 Xem Biểu Đồ Tiến Độ Đọc
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 3. ĐỒNG HỒ TẬP TRUNG POMODORO IM LẶNG & LƯU PHIÊN ĐỌC -->
        <div class="col-lg-5">
            <section class="bs-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">⏱️ Pomodoro Tập Trung (Im Lặng)</h5>
                    <span class="bs-badge bs-badge-success">Không âm thanh</span>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-sm btn-primary js-pomo-preset" data-mins="25">25 phút</button>
                    <button type="button" class="btn btn-sm btn-outline-primary js-pomo-preset" data-mins="50">50 phút</button>
                    <div class="input-group input-group-sm" style="width:140px;">
                        <input type="number" id="pomoCustomMins" class="form-control" value="15" min="1" max="180" aria-label="Số phút tùy chỉnh" />
                        <button type="button" id="btnSetCustomPomo" class="btn btn-outline-secondary">Đặt</button>
                    </div>
                </div>

                <div class="rs-timer-ring my-3">
                    <div id="pomoClockDisplay" class="rs-clock-digits">25:00</div>
                    <div id="pomoClockStatus" class="small bs-muted">Sẵn sàng bắt đầu phiên đọc im lặng</div>
                </div>

                <div class="d-flex justify-content-center gap-2 mb-4">
                    <button type="button" id="btnPomoStart" class="bs-btn bs-btn-primary">▶ Bắt đầu</button>
                    <button type="button" id="btnPomoPause" class="bs-btn bs-btn-outline">⏸ Tạm dừng</button>
                    <button type="button" id="btnPomoReset" class="bs-btn bs-btn-outline">↺ Đặt lại</button>
                </div>

                <form id="formLogReadingSession" class="p-3 rounded-3 border bg-body-tertiary">
                    <input type="hidden" id="rsSelectedBookId" value="@Model.SelectedBookId" />
                    <div class="fw-bold small mb-2">💾 Ghi Nhận Phiên Đọc &amp; Tự Động Cộng Trang</div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="bs-label">Thời lượng (phút)</label>
                            <input type="number" id="rsSessionMinutes" class="bs-input py-1" value="25" min="1" max="300" required />
                        </div>
                        <div class="col-6">
                            <label class="bs-label">Số trang đã đọc thêm</label>
                            <input type="number" id="rsSessionPages" class="bs-input py-1" value="15" min="0" max="500" required />
                        </div>
                    </div>
                    <button type="submit" id="btnSaveReadingSession" class="bs-btn bs-btn-primary w-100">
                        ✅ Hoàn Tất &amp; Lưu Vào ReadingSessions
                    </button>
                </form>
            </section>
        </div>

        <!-- 4. VOICE-TO-QUOTE (SPEECHRECOGNITION VI-VN) & THẺ LẬT ÔN TẬP FLASHCARDS -->
        <div class="col-lg-7 d-flex flex-column gap-4">
            <section class="bs-card">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <h5 class="fw-bold mb-0">🎙️ Ghi Chú Trích Dẫn Bằng Giọng Nói (Voice-to-Quote)</h5>
                    <button type="button" id="btnStartVoiceQuote" class="bs-btn bs-btn-outline py-1">
                        🎤 Đọc Trích Dẫn (vi-VN)
                    </button>
                </div>
                <p class="small bs-muted mb-3">
                    Đọc to câu văn hay từ cuốn sách giấy bạn đang thuê để lưu ngay vào <code>BookNotes</code>, giữ trọn tri thức quý trước ngày trả sách.
                </p>
                <form id="formSaveVoiceQuote" class="d-flex flex-column gap-2">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="bs-label">Trang số</label>
                            <input type="number" id="vqPageNumber" class="bs-input py-1" value="@Math.Max(1, Model.CurrentPage)" min="1" required />
                        </div>
                        <div class="col-md-9">
                            <label class="bs-label">Trạng thái Micro</label>
                            <div id="vqMicStatus" class="bs-input py-1 small bs-muted">Sẵn sàng nhận diện giọng nói tiếng Việt (vi-VN) hoặc nhập tay.</div>
                        </div>
                    </div>
                    <div>
                        <label class="bs-label">Câu trích dẫn từ sách giấy *</label>
                        <textarea id="vqQuoteText" class="bs-textarea" rows="2" placeholder="Bấm 'Đọc Trích Dẫn (vi-VN)' hoặc gõ câu trích dẫn tâm đắc..." required></textarea>
                    </div>
                    <div>
                        <label class="bs-label">Ghi chú suy ngẫm cá nhân</label>
                        <input type="text" id="vqNoteContent" class="bs-input py-1" placeholder="Áp dụng kiến thức này như thế nào vào học tập / công việc..." />
                    </div>
                    <button type="submit" id="btnSaveVoiceQuote" class="bs-btn bs-btn-primary align-self-end">
                        💾 Lưu Trích Dẫn Vào Sổ Tay &amp; Flashcard
                    </button>
                </form>
            </section>

            <section class="bs-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">🃏 Thẻ Lật Ôn Tập Trích Dẫn (Quote Flashcards)</h5>
                    <div class="d-flex gap-1">
                        <button type="button" id="btnFlashPrev" class="btn btn-sm btn-outline-secondary">&laquo; Trước</button>
                        <span id="flashCounter" class="btn btn-sm btn-light disabled">0 / 0</span>
                        <button type="button" id="btnFlashNext" class="btn btn-sm btn-outline-secondary">Sau &raquo;</button>
                    </div>
                </div>

                <script id="rsFlashcardsData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.QuoteFlashcards))</script>

                <div id="rsFlashcardBox" class="rs-flashcard" tabindex="0" role="button" aria-label="Bấm để lật thẻ Flashcard">
                    <div class="rs-flashcard-inner" id="rsFlashcardInner">
                        <div class="rs-flashcard-face rs-flashcard-front">
                            <span class="bs-badge bs-badge-info mb-2" id="fcFrontBadge">Trang --</span>
                            <blockquote class="rs-quote-text mb-2" id="fcFrontQuote">Chưa có trích dẫn nào. Hãy dùng Voice-to-Quote phía trên để tạo thẻ Flashcard đầu tiên!</blockquote>
                            <small class="bs-muted">👆 Bấm vào thẻ để lật xem ghi chú suy ngẫm</small>
                        </div>
                        <div class="rs-flashcard-face rs-flashcard-back">
                            <span class="bs-badge bs-badge-success mb-2">💡 Ghi chú &amp; Ứng dụng</span>
                            <p class="rs-quote-text mb-2" id="fcBackNote">Ghi chú của bạn sẽ hiển thị ở mặt sau thẻ.</p>
                            <small class="bs-muted">👆 Bấm lại để quay về mặt trước</small>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s03-reading-tracker/s03-reading-studio.js" asp-append-version="true"></script>
}
