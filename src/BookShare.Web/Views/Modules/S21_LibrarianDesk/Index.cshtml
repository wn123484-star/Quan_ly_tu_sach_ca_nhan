@model BookShare.Web.Models.ViewModels.S21LibrarianDeskPageViewModel
@{
    ViewData["Title"] = "S21 - Bàn Làm Việc Thủ Thư: Quét Barcode, Nhập Lô & Độc Giả Quá Hạn";
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s21-librarian-desk/s21-librarian-desk.css" asp-append-version="true" />
}

<!-- BÀN QUÉT BARCODE NHANH TẠI QUẦY THỦ THƯ -->
<section class="s21-scanner-banner mb-4 shadow-sm">
    <div class="row g-3 align-items-center">
        <div class="col-lg-5">
            <span class="badge bg-warning text-dark fw-bold mb-2">DỊCH VỤ S21 • [Authorize(Roles = "Librarian,Admin")]</span>
            <h3 class="fw-bold mb-1"><i class="bi bi-upc-scan me-2 text-info"></i>Bàn Làm Việc Thủ Thư: Quét Barcode Nhanh</h3>
            <p class="small text-white-50 mb-2">
                Quét mã vạch trên bìa sách vật lý để tự động duyệt giao sách (<code>Checkout</code>) hoặc thu hồi sách trả (<code>Checkin</code>) kèm tính phí trễ hạn & báo hàng chờ S11.
            </p>
            <div class="d-flex flex-wrap gap-1">
                <button type="button" class="btn btn-xs btn-outline-light js-sample-barcode" data-code="BS-SYS-0001">BS-SYS-0001 (Available)</button>
                <button type="button" class="btn btn-xs btn-outline-warning js-sample-barcode" data-code="BS-SYS-0002">BS-SYS-0002 (Đang mượn)</button>
                <button type="button" class="btn btn-xs btn-outline-danger js-sample-barcode" data-code="BS-SYS-0004">BS-SYS-0004 (Quá hạn)</button>
                <button type="button" class="btn btn-xs btn-outline-info js-sample-barcode" data-code="BS-SYS-0009">BS-SYS-0009 (Reserved S11)</button>
            </div>
        </div>
        <div class="col-lg-7">
            <form id="formQuickScan" class="bg-white text-dark p-3 rounded-4 shadow-sm">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="small fw-bold text-muted">Mã Barcode bản sao:</label>
                        <div class="input-group">
                            <input type="text" id="scanBarcodeInput" class="form-control font-monospace fw-bold" value="BS-SYS-0002" required aria-label="Mã Barcode bản sao" />
                            <button type="button" id="btnScanBarcodeCamera" class="btn btn-outline-primary" title="Quét Barcode bằng Camera" aria-label="Quét Barcode bằng Camera">
                                <i class="bi bi-camera-video-fill"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <label class="small fw-bold text-muted">Thao tác tại quầy:</label>
                        <select id="scanDeskAction" class="form-select">
                            <option value="AutoDetect" selected>⚡ Tự động nhận diện (Mượn ↔ Trả)</option>
                            <option value="Checkin">📥 Thu hồi sách trả & Kiểm tra phí trễ</option>
                            <option value="Checkout">📤 Xuất kho bàn giao sách tại quầy</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-grid">
                        <button type="submit" class="btn btn-primary fw-bold">
                            <i class="bi bi-lightning-charge-fill me-1"></i>Quét Duyệt
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- 4 THẺ CHỈ SỐ KHO CHUNG -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <small class="text-muted">Tổng bản sao Kho chung</small>
            <h3 class="fw-bold text-primary mb-0">@Model.TotalSystemCopies bản sao</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <small class="text-muted">Sẵn sàng trên kệ (Available)</small>
            <h3 class="fw-bold text-success mb-0">@Model.AvailableSystemCopies bản sao</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <small class="text-muted">Đang mượn / Giữ chỗ</small>
            <h3 class="fw-bold text-warning mb-0">@Model.BorrowedSystemCopies bản sao</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <small class="text-muted">Sách hỏng/mất • Độc giả quá hạn</small>
            <h3 class="fw-bold text-danger mb-0">@Model.DamagedOrLostCopies hỏng • @Model.OverdueLoansCount trễ</h3>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- CỘT TRÁI: NHẬP LÔ BẢN SAO MỚI & DANH SÁCH ĐỘC GIẢ QUÁ HẠN -->
    <div class="col-lg-5 d-flex flex-column gap-4">
        <!-- FORM NHẬP LÔ BẢN SAO MỚI VÀO KHO CHUNG -->
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-boxes text-primary me-2"></i>Nhập Lô Bản Sao Mới Vào Kho Chung</h5>
                <form id="formBatchImport" class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-bold">Chọn Đầu sách (<code>Books</code>)</label>
                        <select id="importBookId" class="form-select">
                            @foreach (var b in Model.Books)
                            {
                                <option value="@b.BookId">@b.Title (ISBN: @b.ISBN)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small fw-bold">Thư viện tiếp nhận (<code>Libraries</code>)</label>
                        <select id="importLibraryId" class="form-select">
                            @foreach (var lib in Model.Libraries)
                            {
                                <option value="@lib.LibraryId">@lib.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label small fw-bold">Số lượng lô</label>
                            <input type="number" id="importQuantity" class="form-control fw-bold" value="2" min="1" max="10" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold">Tình trạng</label>
                            <select id="importCondition" class="form-select">
                                <option value="New" selected>New</option>
                                <option value="Good">Good</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold">Vị trí kệ</label>
                            <input type="text" id="importShelfLocation" class="form-control" value="Kệ CNTT-A2" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-plus-circle-fill me-1"></i>Tự Động Sinh Barcode & Nhập Kho
                    </button>
                </form>
            </div>
        </div>

        <!-- DANH SÁCH ĐỘC GIẢ QUÁ HẠN -->
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Độc Giả Đang Quá Hạn Trả Sách</h5>
                    <span class="badge bg-danger">@Model.OverdueLoans.Count trường hợp</span>
                </div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var ov in Model.OverdueLoans)
                    {
                        <div class="p-3 rounded-3 border border-danger bg-danger bg-opacity-10 small">
                            <div class="d-flex justify-content-between fw-bold text-danger">
                                <span>@ov.BorrowerName (Trust: @ov.BorrowerTrustScore)</span>
                                <span>Trễ @ov.OverdueDays ngày (@ov.EstimatedFine.ToString("N0")đ)</span>
                            </div>
                            <div class="text-dark mt-1">
                                <code>@ov.Barcode</code> — <strong>@ov.BookTitle</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-muted">Hạn trả: @ov.DueDate.ToString("dd/MM/yyyy")</span>
                                <button type="button" class="btn btn-xs btn-danger fw-bold js-scan-overdue" data-code="@ov.Barcode">
                                    Quét Thu Hồi Ngay
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: QUẢN LÝ BẢN SAO KHO CHUNG & CHUYỂN TRẠNG THÁI DAMAGED / LOST -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-0"><i class="bi bi-collection-fill text-primary me-2"></i>Danh Mục Bản Sao Kho Chung & Đánh Dấu Sách Hỏng/Mất</h5>
                        <small class="text-muted">Chuyển nhanh trạng thái <code>Available</code> / <code>Damaged</code> / <code>Lost</code> (Khóa quyền <code>Librarian</code> & <code>Admin</code>)</small>
                    </div>
                </div>

                <div class="table-responsive" style="max-height: 620px;">
                    <table class="table table-hover align-middle small mb-0 table-mobile-cards">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Barcode / Đầu sách</th>
                                <th>Vị trí kệ</th>
                                <th>Trạng thái</th>
                                <th>Chuyển trạng thái (Damaged / Lost)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.SystemCopies)
                            {
                                <tr>
                                    <td>
                                        <code>@c.Barcode</code>
                                        <div class="fw-bold">@c.BookTitle</div>
                                        @if (!string.IsNullOrEmpty(c.CurrentBorrowerName))
                                        {
                                            <small class="text-primary">Độc giả: @c.CurrentBorrowerName</small>
                                        }
                                    </td>
                                    <td>
                                        <div>@c.ShelfLocation</div>
                                        <small class="text-muted">Tình trạng: @c.Condition</small>
                                    </td>
                                    <td>
                                        <span class="badge @(c.Status == "Available" ? "bg-success" : c.Status == "Borrowed" ? "bg-warning text-dark" : c.Status == "Reserved" ? "bg-info text-dark" : "bg-danger")">
                                            @c.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-xs btn-outline-success js-change-state"
                                                    data-id="@c.BookCopyId" data-status="Available" data-cond="Good">
                                                Available
                                            </button>
                                            <button type="button" class="btn btn-xs btn-outline-warning text-dark js-change-state"
                                                    data-id="@c.BookCopyId" data-status="Damaged" data-cond="Worn">
                                                Damaged
                                            </button>
                                            <button type="button" class="btn btn-xs btn-outline-danger js-change-state"
                                                    data-id="@c.BookCopyId" data-status="Lost" data-cond="Worn">
                                                Lost
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s21-librarian-desk/s21-librarian-desk.js" asp-append-version="true"></script>
}
