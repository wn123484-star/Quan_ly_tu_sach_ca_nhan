@model BookShare.Web.Models.ViewModels.S21LibrarianDeskPageViewModel
@{
    ViewData["Title"] = "Quầy Nghiệp Vụ Thủ Thư Tổng Hợp: Duyệt Mượn, Cho Mượn Trực Tiếp & Quản Lý Kho";
    var isStaff = Model.CurrentUserRole == "Librarian" || Model.CurrentUserRole == "Admin";
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s21-librarian-desk/s21-librarian-desk.css" asp-append-version="true" />
}

@if (!isStaff)
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <div class="mb-3"><i class="bi bi-shield-lock-fill text-warning" style="font-size: 2.5rem;"></i></div>
        <h4 class="fw-bold mb-2">Khu vực Quầy Nghiệp Vụ Thủ Thư</h4>
        <p class="text-muted mb-4">Chỉ tài khoản Thủ thư hoặc Quản trị viên mới có quyền truy cập Quầy điều phối mượn trả tổng hợp, quét mã vạch xuất nhập kho, nhập lô sách mới và xử lý quá hạn.</p>
        <div>
            <a asp-controller="S01AuthOtpGoogle" asp-action="Index" class="btn btn-primary fw-semibold px-4">
                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập tài khoản phù hợp
            </a>
        </div>
    </div>
    return;
}

<!-- BÀN QUÉT BARCODE NHANH TẠI QUẦY THỦ THƯ -->
<section class="s21-scanner-banner mb-4 shadow-sm">
    <div class="row g-3 align-items-center">
        <div class="col-lg-5">
            <div class="d-flex flex-wrap gap-2 mb-2">
                <span class="badge bg-info text-dark fw-bold">QUẦY NGHIỆP VỤ THỦ THƯ TỔNG HỢP</span>
                <span class="badge bg-warning text-dark fw-bold">Quyền: @Model.CurrentUserRole</span>
            </div>
            <h3 class="fw-bold mb-1"><i class="bi bi-upc-scan me-2 text-info"></i>Điều Phối Toàn Bộ Công Việc Mượn – Trả Sách</h3>
            <p class="small text-white-50 mb-2">
                Thủ thư và Quản trị viên xử lý tập trung tại một màn hình duy nhất: Duyệt &amp; giao trả mọi yêu cầu (Kho chung + Cộng đồng P2P), cho mượn trực tiếp tại quầy, quét mã vạch, nhập lô và kiểm soát quá hạn.
            </p>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var sampleCopy in Model.SampleQuickBarcodes)
                {
                    <button type="button" class="btn btn-xs btn-outline-light js-sample-barcode" data-code="@sampleCopy.Barcode">
                        @sampleCopy.Barcode (@sampleCopy.Status)
                    </button>
                }
            </div>
        </div>
        <div class="col-lg-7">
            <form id="formQuickScan" class="bg-white text-dark p-3 rounded-4 shadow-sm">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="small fw-bold text-muted" for="scanBarcodeInput">Mã vạch bản sao:</label>
                        <div class="input-group">
                            <input type="text" id="scanBarcodeInput" class="form-control font-monospace fw-bold" value="@(Model.SampleQuickBarcodes.FirstOrDefault()?.Barcode ?? "")" placeholder="Nhập hoặc quét mã vạch..." required aria-label="Mã vạch bản sao" />
                            <button type="button" id="btnScanBarcodeCamera" class="btn btn-outline-primary" title="Quét mã vạch bằng Camera" aria-label="Quét mã vạch bằng Camera">
                                <i class="bi bi-camera-video-fill"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <label class="small fw-bold text-muted" for="scanDeskAction">Thao tác tại quầy:</label>
                        <select id="scanDeskAction" class="form-select">
                            <option value="AutoDetect" selected>⚡ Tự động nhận diện (Mượn ↔ Trả)</option>
                            <option value="Checkin">📥 Thu hồi sách trả &amp; Kiểm tra phí trễ</option>
                            <option value="Checkout">📤 Xuất kho bàn giao sách tại quầy</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-grid">
                        <button type="submit" class="btn btn-primary fw-bold">
                            <i class="bi bi-lightning-charge-fill me-1"></i>Quét Duyệt
                        </button>
                    </div>
                    <div class="col-md-8 mt-2">
                        <label class="small fw-bold text-muted" for="scanBorrowerUserId">Độc giả nhận sách tại quầy (khi xuất kho trực tiếp không có phiếu chờ):</label>
                        <select id="scanBorrowerUserId" class="form-select form-select-sm">
                            <option value="">-- Tự động khớp theo phiếu yêu cầu đang chờ --</option>
                            @foreach (var u in Model.Borrowers)
                            {
                                <option value="@u.UserId">@u.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 mt-2">
                        <label class="small fw-bold text-muted" for="scanDesiredDays">Số ngày cho mượn:</label>
                        <select id="scanDesiredDays" class="form-select form-select-sm">
                            <option value="7">7 ngày</option>
                            <option value="14" selected>14 ngày</option>
                            <option value="21">21 ngày</option>
                            <option value="30">30 ngày</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- 5 THẺ CHỈ SỐ TỔNG QUAN QUẦY THỦ THƯ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <small class="text-muted">Phiếu chờ duyệt</small>
            <h3 class="fw-bold text-info mb-0">@Model.PendingLoansCount phiếu</h3>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <small class="text-muted">Đang cho mượn</small>
            <h3 class="fw-bold text-warning mb-0">@Model.ActiveLoansCount hợp đồng</h3>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <small class="text-muted">Bản sao sẵn sàng</small>
            <h3 class="fw-bold text-success mb-0">@Model.AvailableSystemCopies / @Model.TotalSystemCopies</h3>
        </div>
    </div>
    <div class="col-6 col-lg">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <small class="text-muted">Đang mượn / Giữ chỗ</small>
            <h3 class="fw-bold text-primary mb-0">@Model.BorrowedSystemCopies bản sao</h3>
        </div>
    </div>
    <div class="col-12 col-lg">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <small class="text-muted">Sách hỏng/mất • Quá hạn</small>
            <h3 class="fw-bold text-danger mb-0">@Model.DamagedOrLostCopies hỏng • @Model.OverdueLoansCount trễ</h3>
        </div>
    </div>
</div>

<!-- KHỐI CHO MƯỢN SÁCH TRỰC TIẾP TẠI QUẦY (1 BƯỚC — DỄ DÀNG CHO THỦ THƯ & ADMIN) -->
<section class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 border-start border-4 border-success">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-journal-arrow-up text-success me-2"></i>Cho Mượn Sách Trực Tiếp Tại Quầy (Kho Thư Viện &amp; P2P)</h5>
            <small class="text-muted">Chọn độc giả và bản sao sách sẵn sàng để lập phiếu duyệt &amp; bàn giao ngay trong 1 thao tác (không cần nhớ mã vạch).</small>
        </div>
        <span class="badge bg-success-subtle text-success border border-success-subtle">@Model.AvailableLendableCopies.Count bản sao sẵn sàng</span>
    </div>

    <form id="formDirectLend" class="row g-2 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label class="form-label small fw-bold mb-1" for="directLendCopyId">1. Chọn bản sao sách sẵn sàng</label>
            <select id="directLendCopyId" class="form-select form-select-sm" required>
                @if (!Model.AvailableLendableCopies.Any())
                {
                    <option value="">-- Chưa có bản sao sẵn sàng --</option>
                }
                else
                {
                    @foreach (var ac in Model.AvailableLendableCopies)
                    {
                        <option value="@ac.BookCopyId">[@ac.Barcode] @ac.BookTitle — @ac.LocationOrOwner</option>
                    }
                }
            </select>
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label small fw-bold mb-1" for="directLendBorrowerId">2. Chọn độc giả mượn sách</label>
            <select id="directLendBorrowerId" class="form-select form-select-sm" required>
                @foreach (var u in Model.Borrowers)
                {
                    <option value="@u.UserId">@u.DisplayName</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label small fw-bold mb-1" for="directLendDays">3. Thời hạn</label>
            <select id="directLendDays" class="form-select form-select-sm">
                <option value="7">7 ngày</option>
                <option value="14" selected>14 ngày</option>
                <option value="21">21 ngày</option>
                <option value="30">30 ngày</option>
            </select>
        </div>
        <div class="col-lg-3 col-md-8">
            <div class="form-check small mb-1">
                <input class="form-check-input" type="checkbox" id="directLendImmediate" checked />
                <label class="form-check-label fw-semibold" for="directLendImmediate">Bàn giao ngay (kích hoạt hợp đồng)</label>
            </div>
            <button type="submit" class="btn btn-success btn-sm fw-bold w-100" @(Model.AvailableLendableCopies.Any() ? null : "disabled")>
                <i class="bi bi-check2-circle me-1"></i>Xác Nhận Cho Mượn Ngay
            </button>
        </div>
    </form>
</section>

<!-- TRUNG TÂM ĐIỀU PHỐI TẤT CẢ PHIẾU YÊU CẦU & HỢP ĐỒNG MƯỢN SÁCH (CÓ BỘ LỌC & PHÂN TRANG) -->
<section class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4" id="s21UnifiedLoanSection">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-list-check text-primary me-2"></i>Danh Sách Điều Phối Tất Cả Phiếu Mượn Sách (Kho Chung &amp; P2P)</h5>
            <small class="text-muted">Duyệt yêu cầu, xác nhận bàn giao, phát mã QR hoặc thu hồi sách trả tập trung cho toàn bộ hệ thống.</small>
        </div>
        <span class="badge bg-primary">@Model.TotalFilteredLoans phiếu khớp bộ lọc • Trang @Model.LoanPage/@Model.LoanTotalPages</span>
    </div>

    <form method="get" asp-controller="S21LibrarianDesk" asp-action="Index" class="row g-2 mb-3 p-3 rounded-4 bg-light border">
        <input type="hidden" name="copyKeyword" value="@Model.CopyKeyword" />
        <input type="hidden" name="copyStatus" value="@Model.CopyStatusFilter" />
        <input type="hidden" name="copyLibraryId" value="@Model.CopyLibraryFilter" />
        <input type="hidden" name="copyPage" value="@Model.CopyPage" />
        <div class="col-md-4">
            <input type="text" name="loanKeyword" value="@Model.LoanKeyword" class="form-control form-control-sm" placeholder="Tìm theo tên sách, mã vạch, tên/email độc giả..." />
        </div>
        <div class="col-md-3">
            <select name="loanChannel" class="form-select form-select-sm" aria-label="Lọc theo kênh mượn">
                <option value="all" selected="@(Model.LoanChannelFilter == "all")">🌐 Tất cả kênh mượn</option>
                <option value="Library" selected="@(Model.LoanChannelFilter == "Library")">🏛️ Kho chung Thư viện</option>
                <option value="P2P" selected="@(Model.LoanChannelFilter == "P2P")">🤝 Cộng đồng P2P</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="loanStatus" class="form-select form-select-sm" aria-label="Lọc theo trạng thái phiếu">
                <option value="all" selected="@(Model.LoanStatusFilter == "all")">Tất cả trạng thái</option>
                <option value="Pending" selected="@(Model.LoanStatusFilter == "Pending")">⏳ Chờ duyệt (Pending)</option>
                <option value="Approved" selected="@(Model.LoanStatusFilter == "Approved")">📌 Đã duyệt chờ giao</option>
                <option value="Active" selected="@(Model.LoanStatusFilter == "Active")">📖 Đang mượn</option>
                <option value="Overdue" selected="@(Model.LoanStatusFilter == "Overdue")">⚠️ Đang quá hạn</option>
                <option value="Returned" selected="@(Model.LoanStatusFilter == "Returned")">✅ Đã hoàn trả</option>
                <option value="Rejected" selected="@(Model.LoanStatusFilter == "Rejected")">❌ Từ chối / Hủy</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm fw-bold flex-grow-1"><i class="bi bi-funnel-fill me-1"></i>Lọc</button>
            <a asp-controller="S21LibrarianDesk" asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Xóa bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>

    @if (!Model.UnifiedLoans.Any())
    {
        <div class="p-4 text-center rounded-4 border bg-light text-muted small">
            <i class="bi bi-inbox fs-3 d-block mb-1"></i>Chưa có phiếu yêu cầu mượn sách nào khớp với bộ lọc hiện tại.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0 table-mobile-cards">
                <thead class="table-light">
                    <tr>
                        <th>Phiếu / Sách</th>
                        <th>Kênh &amp; Nguồn</th>
                        <th>Độc giả mượn</th>
                        <th>Trạng thái &amp; Hạn trả</th>
                        <th class="text-end">Thao tác Thủ thư</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.UnifiedLoans)
                    {
                        <tr>
                            <td data-label="Phiếu / Sách">
                                <span class="badge bg-dark">#@item.LoanRequestId</span>
                                <code class="ms-1 fw-bold">@item.Barcode</code>
                                <div class="fw-bold mt-1">@item.BookTitle</div>
                                <small class="text-muted">Yêu cầu: @item.RequestedAt.ToString("dd/MM/yyyy HH:mm") (@item.DesiredDays ngày)</small>
                            </td>
                            <td data-label="Kênh & Nguồn">
                                <span class="badge @(item.LoanType == "Library" ? "bg-primary" : "bg-info text-dark")">
                                    @(item.LoanType == "Library" ? "🏛️ Kho Thư viện" : "🤝 Cộng đồng P2P")
                                </span>
                                <div class="small text-muted mt-1">@item.SourceDisplay</div>
                            </td>
                            <td data-label="Độc giả mượn">
                                <div class="fw-bold">@item.BorrowerName</div>
                                <small class="text-muted d-block">@item.BorrowerEmail</small>
                                <span class="badge bg-warning text-dark">Uy tín: @item.BorrowerTrustScore</span>
                            </td>
                            <td data-label="Trạng thái & Hạn trả">
                                @if (item.LoanStatus == "Returned")
                                {
                                    <span class="badge bg-success">✅ Đã trả (@(item.ReturnDate?.ToString("dd/MM/yyyy") ?? ""))</span>
                                }
                                else if (item.LoanStatus == "Overdue")
                                {
                                    <span class="badge bg-danger">⚠️ Quá hạn (Hạn: @item.DueDate?.ToString("dd/MM/yyyy"))</span>
                                }
                                else if (item.LoanId != null)
                                {
                                    <span class="badge bg-warning text-dark">📖 Đang mượn (Hạn: @item.DueDate?.ToString("dd/MM/yyyy"))</span>
                                }
                                else if (item.RequestStatus == "Approved")
                                {
                                    <span class="badge bg-primary">📌 Đã duyệt • Chờ giao</span>
                                }
                                else if (item.RequestStatus == "Pending")
                                {
                                    <span class="badge bg-info text-dark">⏳ Chờ Thủ thư duyệt</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.RequestStatus</span>
                                }
                                @if (item.FineAmount > 0)
                                {
                                    <div class="text-danger fw-bold mt-1">Phí trễ: @item.FineAmount.ToString("N0")đ</div>
                                }
                            </td>
                            <td class="text-end" data-label="Thao tác Thủ thư">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    @if (item.RequestStatus == "Pending")
                                    {
                                        <button type="button" class="btn btn-xs btn-success fw-bold js-s21-loan-action"
                                                data-req-id="@item.LoanRequestId" data-action="Approve">
                                            <i class="bi bi-check2-circle me-1"></i>Duyệt
                                        </button>
                                        <button type="button" class="btn btn-xs btn-primary fw-bold js-s21-loan-action"
                                                data-req-id="@item.LoanRequestId" data-action="Handover" title="Duyệt và giao sách ngay">
                                            <i class="bi bi-box-arrow-right me-1"></i>Giao ngay
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-danger js-s21-loan-action"
                                                data-req-id="@item.LoanRequestId" data-action="Reject">
                                            Từ chối
                                        </button>
                                    }
                                    else if (item.RequestStatus == "Approved" && item.LoanId == null)
                                    {
                                        <button type="button" class="btn btn-xs btn-primary fw-bold js-s21-loan-action"
                                                data-req-id="@item.LoanRequestId" data-action="Handover">
                                            <i class="bi bi-box-arrow-right me-1"></i>Giao sách
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-dark js-s21-qr-create"
                                                data-req-id="@item.LoanRequestId" data-type="Handover">
                                            <i class="bi bi-qr-code me-1"></i>QR Giao
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-danger js-s21-loan-action"
                                                data-req-id="@item.LoanRequestId" data-action="Reject">
                                            Hủy giữ
                                        </button>
                                    }
                                    else if (item.LoanId != null && item.LoanStatus != "Returned")
                                    {
                                        <button type="button" class="btn btn-xs btn-warning text-dark fw-bold js-s21-loan-action"
                                                data-req-id="@item.LoanRequestId" data-action="Return" data-cond="Good">
                                            <i class="bi bi-box-arrow-in-left me-1"></i>Nhận trả (Tốt)
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-danger js-s21-loan-action"
                                                data-req-id="@item.LoanRequestId" data-action="Return" data-cond="Damaged">
                                            Trả hỏng
                                        </button>
                                        <button type="button" class="btn btn-xs btn-outline-dark js-s21-qr-create"
                                                data-req-id="@item.LoanRequestId" data-type="Return">
                                            <i class="bi bi-qr-code me-1"></i>QR Trả
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">Hoàn tất</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.LoanTotalPages > 1)
        {
            <nav class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2" aria-label="Phân trang danh sách phiếu mượn">
                <small class="text-muted">Hiển thị @Model.UnifiedLoans.Count / @Model.TotalFilteredLoans phiếu</small>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.LoanPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-controller="S21LibrarianDesk" asp-action="Index"
                           asp-route-loanKeyword="@Model.LoanKeyword" asp-route-loanChannel="@Model.LoanChannelFilter"
                           asp-route-loanStatus="@Model.LoanStatusFilter" asp-route-loanPage="@(Model.LoanPage - 1)"
                           asp-route-copyKeyword="@Model.CopyKeyword" asp-route-copyStatus="@Model.CopyStatusFilter"
                           asp-route-copyLibraryId="@Model.CopyLibraryFilter" asp-route-copyPage="@Model.CopyPage">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= Model.LoanTotalPages; p++)
                    {
                        <li class="page-item @(p == Model.LoanPage ? "active" : "")">
                            <a class="page-link" asp-controller="S21LibrarianDesk" asp-action="Index"
                               asp-route-loanKeyword="@Model.LoanKeyword" asp-route-loanChannel="@Model.LoanChannelFilter"
                               asp-route-loanStatus="@Model.LoanStatusFilter" asp-route-loanPage="@p"
                               asp-route-copyKeyword="@Model.CopyKeyword" asp-route-copyStatus="@Model.CopyStatusFilter"
                               asp-route-copyLibraryId="@Model.CopyLibraryFilter" asp-route-copyPage="@Model.CopyPage">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.LoanPage >= Model.LoanTotalPages ? "disabled" : "")">
                        <a class="page-link" asp-controller="S21LibrarianDesk" asp-action="Index"
                           asp-route-loanKeyword="@Model.LoanKeyword" asp-route-loanChannel="@Model.LoanChannelFilter"
                           asp-route-loanStatus="@Model.LoanStatusFilter" asp-route-loanPage="@(Model.LoanPage + 1)"
                           asp-route-copyKeyword="@Model.CopyKeyword" asp-route-copyStatus="@Model.CopyStatusFilter"
                           asp-route-copyLibraryId="@Model.CopyLibraryFilter" asp-route-copyPage="@Model.CopyPage">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
</section>

<div class="row g-4 mb-4">
    <!-- CỘT TRÁI: NHẬP LÔ BẢN SAO MỚI & DANH SÁCH ĐỘC GIẢ QUÁ HẠN -->
    <div class="col-lg-5 d-flex flex-column gap-4">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-boxes text-primary me-2"></i>Nhập Lô Bản Sao Mới Vào Kho Chung</h5>
                <form id="formBatchImport" class="d-flex flex-column gap-3">
                    <div>
                        <label class="form-label small fw-bold" for="importBookId">Chọn Đầu sách</label>
                        <select id="importBookId" class="form-select">
                            @foreach (var b in Model.Books)
                            {
                                <option value="@b.BookId">@b.Title (ISBN: @b.ISBN)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label small fw-bold" for="importLibraryId">Thư viện tiếp nhận</label>
                        <select id="importLibraryId" class="form-select">
                            @foreach (var lib in Model.Libraries)
                            {
                                <option value="@lib.LibraryId">@lib.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label small fw-bold" for="importQuantity">Số lượng lô</label>
                            <input type="number" id="importQuantity" class="form-control fw-bold" value="2" min="1" max="10" required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold" for="importCondition">Tình trạng</label>
                            <select id="importCondition" class="form-select">
                                <option value="New" selected>New</option>
                                <option value="Good">Good</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold" for="importShelfLocation">Vị trí kệ</label>
                            <input type="text" id="importShelfLocation" class="form-control" value="Kệ CNTT-A2" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-plus-circle-fill me-1"></i>Tự Động Sinh Barcode &amp; Nhập Kho
                    </button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Độc Giả Đang Quá Hạn Trả Sách</h5>
                    <span class="badge bg-danger">@Model.OverdueLoans.Count trường hợp</span>
                </div>
                @if (!Model.OverdueLoans.Any())
                {
                    <p class="small text-muted mb-0">Hiện không có hợp đồng mượn nào đang trễ hạn.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var ov in Model.OverdueLoans)
                        {
                            <div class="p-3 rounded-3 border border-danger bg-danger bg-opacity-10 small">
                                <div class="d-flex justify-content-between fw-bold text-danger">
                                    <span>@ov.BorrowerName (Trust: @ov.BorrowerTrustScore)</span>
                                    <span>Trễ @ov.OverdueDays ngày (@ov.EstimatedFine.ToString("N0")đ)</span>
                                </div>
                                <div class="text-dark mt-1">
                                    <code>@ov.Barcode</code> — <strong>@ov.BookTitle</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="text-muted">Hạn trả: @ov.DueDate.ToString("dd/MM/yyyy")</span>
                                    <button type="button" class="btn btn-xs btn-danger fw-bold js-scan-overdue" data-code="@ov.Barcode">
                                        Quét Thu Hồi Ngay
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: QUẢN LÝ BẢN SAO KHO CHUNG CÓ BỘ LỌC & PHÂN TRANG -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-0"><i class="bi bi-collection-fill text-primary me-2"></i>Danh Mục Bản Sao Kho Chung &amp; Đánh Dấu Sách Hỏng/Mất</h5>
                        <small class="text-muted">Lọc nhanh theo mã vạch, trạng thái kho, thư viện và chuyển trạng thái bản sao.</small>
                    </div>
                    <span class="badge bg-secondary">@Model.TotalFilteredCopies bản • Trang @Model.CopyPage/@Model.CopyTotalPages</span>
                </div>

                <form method="get" asp-controller="S21LibrarianDesk" asp-action="Index" class="row g-2 mb-3">
                    <input type="hidden" name="loanKeyword" value="@Model.LoanKeyword" />
                    <input type="hidden" name="loanChannel" value="@Model.LoanChannelFilter" />
                    <input type="hidden" name="loanStatus" value="@Model.LoanStatusFilter" />
                    <input type="hidden" name="loanPage" value="@Model.LoanPage" />
                    <div class="col-md-5">
                        <input type="text" name="copyKeyword" value="@Model.CopyKeyword" class="form-control form-control-sm" placeholder="Mã vạch, tên sách, ISBN, vị trí kệ..." />
                    </div>
                    <div class="col-md-3">
                        <select name="copyStatus" class="form-select form-select-sm" aria-label="Lọc trạng thái bản sao">
                            <option value="all" selected="@(Model.CopyStatusFilter == "all")">Mọi trạng thái</option>
                            <option value="Available" selected="@(Model.CopyStatusFilter == "Available")">Available (Sẵn sàng)</option>
                            <option value="Borrowed" selected="@(Model.CopyStatusFilter == "Borrowed")">Borrowed (Đang mượn)</option>
                            <option value="Reserved" selected="@(Model.CopyStatusFilter == "Reserved")">Reserved (Giữ chỗ)</option>
                            <option value="Damaged" selected="@(Model.CopyStatusFilter == "Damaged")">Damaged (Hư hỏng)</option>
                            <option value="Lost" selected="@(Model.CopyStatusFilter == "Lost")">Lost (Thất lạc)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="copyLibraryId" class="form-select form-select-sm" aria-label="Lọc theo thư viện">
                            <option value="">Tất cả kho</option>
                            @foreach (var lib in Model.Libraries)
                            {
                                <option value="@lib.LibraryId" selected="@(Model.CopyLibraryFilter == lib.LibraryId)">@lib.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-outline-primary btn-sm fw-bold">Lọc kho</button>
                    </div>
                </form>

                <div class="table-responsive" style="max-height: 540px;">
                    <table class="table table-hover align-middle small mb-0 table-mobile-cards">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Barcode / Đầu sách</th>
                                <th>Vị trí kệ</th>
                                <th>Trạng thái</th>
                                <th>Chuyển trạng thái (Damaged / Lost)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.SystemCopies)
                            {
                                <tr>
                                    <td>
                                        <code>@c.Barcode</code>
                                        <div class="fw-bold">@c.BookTitle</div>
                                        @if (!string.IsNullOrEmpty(c.CurrentBorrowerName))
                                        {
                                            <small class="text-primary">Độc giả: @c.CurrentBorrowerName</small>
                                        }
                                    </td>
                                    <td>
                                        <div>@c.ShelfLocation</div>
                                        <small class="text-muted">@c.LibraryName • @c.Condition</small>
                                    </td>
                                    <td>
                                        <span class="badge @(c.Status == "Available" ? "bg-success" : c.Status == "Borrowed" ? "bg-warning text-dark" : c.Status == "Reserved" ? "bg-info text-dark" : "bg-danger")">
                                            @c.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-xs btn-outline-success js-change-state"
                                                    data-id="@c.BookCopyId" data-status="Available" data-cond="Good">
                                                Available
                                            </button>
                                            <button type="button" class="btn btn-xs btn-outline-warning text-dark js-change-state"
                                                    data-id="@c.BookCopyId" data-status="Damaged" data-cond="Worn">
                                                Damaged
                                            </button>
                                            <button type="button" class="btn btn-xs btn-outline-danger js-change-state"
                                                    data-id="@c.BookCopyId" data-status="Lost" data-cond="Worn">
                                                Lost
                                            </button>
                                            <button type="button" class="btn btn-xs btn-outline-secondary js-delete-sys-copy"
                                                    data-id="@c.BookCopyId" data-barcode="@c.Barcode" title="Thanh lý / Xóa bản sao kho chung">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.CopyTotalPages > 1)
                {
                    <nav class="mt-3 d-flex justify-content-end" aria-label="Phân trang danh mục bản sao kho chung">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CopyPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-controller="S21LibrarianDesk" asp-action="Index"
                                   asp-route-loanKeyword="@Model.LoanKeyword" asp-route-loanChannel="@Model.LoanChannelFilter"
                                   asp-route-loanStatus="@Model.LoanStatusFilter" asp-route-loanPage="@Model.LoanPage"
                                   asp-route-copyKeyword="@Model.CopyKeyword" asp-route-copyStatus="@Model.CopyStatusFilter"
                                   asp-route-copyLibraryId="@Model.CopyLibraryFilter" asp-route-copyPage="@(Model.CopyPage - 1)">&laquo;</a>
                            </li>
                            @for (int p = 1; p <= Model.CopyTotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CopyPage ? "active" : "")">
                                    <a class="page-link" asp-controller="S21LibrarianDesk" asp-action="Index"
                                       asp-route-loanKeyword="@Model.LoanKeyword" asp-route-loanChannel="@Model.LoanChannelFilter"
                                       asp-route-loanStatus="@Model.LoanStatusFilter" asp-route-loanPage="@Model.LoanPage"
                                       asp-route-copyKeyword="@Model.CopyKeyword" asp-route-copyStatus="@Model.CopyStatusFilter"
                                       asp-route-copyLibraryId="@Model.CopyLibraryFilter" asp-route-copyPage="@p">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.CopyPage >= Model.CopyTotalPages ? "disabled" : "")">
                                <a class="page-link" asp-controller="S21LibrarianDesk" asp-action="Index"
                                   asp-route-loanKeyword="@Model.LoanKeyword" asp-route-loanChannel="@Model.LoanChannelFilter"
                                   asp-route-loanStatus="@Model.LoanStatusFilter" asp-route-loanPage="@Model.LoanPage"
                                   asp-route-copyKeyword="@Model.CopyKeyword" asp-route-copyStatus="@Model.CopyStatusFilter"
                                   asp-route-copyLibraryId="@Model.CopyLibraryFilter" asp-route-copyPage="@(Model.CopyPage + 1)">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s21-librarian-desk/s21-librarian-desk.js" asp-append-version="true"></script>
}
