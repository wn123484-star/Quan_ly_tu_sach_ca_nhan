@model BookShare.Web.Models.ViewModels.S09P2PLoanPageViewModel
@{
    ViewData["Title"] = "Giao Dịch Mượn – Trả Sách Cộng Đồng P2P & Thưởng Hạn Mức";
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s09-p2p-loan-flow/s09-p2p-loan-flow.css" asp-append-version="true" />
}

<!-- 1. THÔNG TIN ĐIỂM UY TÍN (TRUSTSCORE), THƯỞNG QUOTA P2P & ĐẶT MƯỢN P2P MỚI -->
<section class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="row g-4 align-items-center">
        <div class="col-lg-6">
            <span class="badge bg-primary mb-1">MẠNG LƯỚI CHIA SẺ SÁCH NGANG HÀNG P2P</span>
            <h4 class="fw-bold mb-1">🤝 Giao Dịch Mượn Sách P2P Cộng Đồng &amp; Điểm Hẹn An Toàn</h4>
            <p class="text-muted small mb-3">
                Chủ sách xét duyệt dựa trên <strong>Điểm uy tín (<code>TrustScore</code>)</strong> của người mượn &rarr; Hẹn giao nhận tại <strong>Trạm Sách CLB / Hub</strong> &rarr; Xác nhận ký gửi (<code>InTransit</code>) &rarr; Bàn giao (<code>Borrowed</code>) và tự động cộng thưởng <strong><code>+1 LendQuotaBonus</code></strong> cho chủ sách.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <div class="s09-badge-pill">
                    <i class="bi bi-shield-fill-check text-success me-1"></i>
                    Điểm uy tín của bạn: <strong class="text-success">@Model.CurrentUserTrustScore điểm</strong>
                </div>
                <div class="s09-badge-pill">
                    <i class="bi bi-gift-fill text-warning me-1"></i>
                    Thưởng hạn mức cho mượn P2P (<code>LendQuotaBonus</code>): <strong class="text-primary">+@Model.CurrentUserLendQuotaBonus cuốn</strong>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="s09-create-box p-3 rounded-4">
                <h6 class="fw-bold small text-primary mb-2">
                    <i class="bi bi-people-fill me-1"></i>Gửi Yêu Cầu Mượn Sách P2P Từ Chủ Tủ Sách Cá Nhân
                </h6>
                <form id="s09CreateP2PForm" class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-muted mb-1">Bản sao P2P đang mở cho thuê / mượn</label>
                        <select id="s09BookCopyId" class="form-select form-select-sm" required>
                            @foreach (var c in Model.AvailableP2PCopies)
                            {
                                var feeTag = c.DailyRentalFee > 0 ? $"{c.DailyRentalFee:N0}đ/ng • Cọc {c.DepositAmount:N0}đ" : "Miễn phí 0đ";
                                <option value="@c.BookCopyId" data-daily-fee="@((int)c.DailyRentalFee)" data-deposit="@((int)c.DepositAmount)">[@c.Barcode] @c.Title — @feeTag (@c.OwnerName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">Số ngày</label>
                        <select id="s09DesiredDays" class="form-select form-select-sm">
                            <option value="7">7 ngày</option>
                            <option value="14" selected>14 ngày</option>
                            <option value="30">30 ngày</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">Điểm hẹn giao nhận (Hub)</label>
                        <select id="s09PickupHubId" class="form-select form-select-sm">
                            @foreach (var h in Model.PickupHubs)
                            {
                                <option value="@h.Id">@h.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold py-2">
                            <i class="bi bi-send-check me-1"></i>Thuê P2P
                        </button>
                    </div>
                    <div class="col-12">
                        <div class="small text-primary fw-semibold" id="s09EscrowPreview">💰 Dự kiến tạm giữ Escrow P2P: Đang tính...</div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- 2. DANH SÁCH GIAO DỊCH MƯỢN P2P & CÁC BƯỚC ĐIỀU PHỐI -->
<section class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h6 class="fw-bold mb-0">
            <i class="bi bi-arrow-left-right text-primary me-2"></i>Danh Sách Giao Dịch Mượn Sách P2P Giữa Các Độc Giả (@Model.P2PItems.Count phiếu)
        </h6>
        <span class="small text-muted">
            Mỗi lần xác nhận bàn giao P2P thành công, Chủ sách được cộng <code>+1 LendQuotaBonus</code> và <code>+3 TrustScore</code>
        </span>
    </div>

    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.P2PItems)
        {
            int stepIndex = item.LoanStatus == "Returned" ? 4
                : (item.LoanId != null || item.CopyStatus == "InTransit" ? 3
                : (item.RequestStatus == "Approved" ? 2 : 1));

            <div class="s09-p2p-card p-3 rounded-4">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-4">
                        <div class="d-flex gap-3 align-items-center">
                            <img src="@(string.IsNullOrEmpty(item.CoverImageUrl) ? "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=200" : item.CoverImageUrl)"
                                 class="s09-cover-thumb shadow-sm" alt="@item.BookTitle"
                                 onerror="this.src='https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=200'" />
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-info text-dark">P2P #@item.LoanRequestId</span>
                                    <code class="fw-bold">@item.Barcode</code>
                                    <span class="badge bg-light text-dark border">@item.CopyStatus</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">@item.BookTitle</h6>
                                <div class="small text-muted">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>Điểm hẹn: <strong>@item.PickupHubName</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="p-2 rounded-3 bg-light border small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Chủ tủ sách (Lender):</span>
                                <span>
                                    <strong>@item.OwnerName</strong>
                                    <span class="badge bg-warning text-dark">Bonus +@item.OwnerQuotaBonus</span>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Người mượn & Điểm uy tín:</span>
                                <span>
                                    <strong>@item.BorrowerName</strong>
                                    <span class="badge bg-success"><i class="bi bi-shield-check me-1"></i>@item.BorrowerTrustScore đ</span>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Thời hạn thuê:</span>
                                <span>
                                    @item.DesiredDays ngày
                                    @if (item.DueDate.HasValue)
                                    {
                                        <strong class="text-primary">(Hạn: @item.DueDate.Value.ToString("dd/MM/yyyy"))</strong>
                                    }
                                </span>
                            </div>
                            <!-- [BS-RENTAL-FLOW] Thông tin Phí thuê & Cọc Escrow P2P -->
                            <div class="d-flex justify-content-between pt-1 border-top">
                                <span class="text-muted">Phí thuê &amp; Escrow:</span>
                                <span>
                                    @if (item.RentalFeeTotal > 0 || item.DepositHeld > 0)
                                    {
                                        <strong class="text-primary">@item.RentalFeeTotal.ToString("N0")đ + Cọc @item.DepositHeld.ToString("N0")đ</strong>
                                        <span class="badge @(item.EscrowStatus == "Held" ? "bg-warning text-dark" : item.EscrowStatus == "ReleasedToLender" || item.EscrowStatus == "RefundedToBorrower" ? "bg-success" : "bg-secondary") ms-1">@item.EscrowStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">Miễn phí 0đ</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <!-- Thanh tiến trình 4 bước -->
                        <div class="d-flex justify-content-between small mb-2 px-1">
                            <span class="@(stepIndex >= 1 ? "text-primary fw-bold" : "text-muted")">1. Yêu cầu</span>
                            <span class="@(stepIndex >= 2 ? "text-primary fw-bold" : "text-muted")">2. Duyệt</span>
                            <span class="@(stepIndex >= 3 ? "text-primary fw-bold" : "text-muted")">3. @(item.LoanId == null && item.CopyStatus == "InTransit" ? "Tại Hub" : "Giao nhận")</span>
                            <span class="@(stepIndex >= 4 ? "text-success fw-bold" : "text-muted")">4. Đã trả</span>
                        </div>

                        <div class="d-flex flex-wrap justify-content-end gap-2">
                            @if (item.RequestStatus == "Pending")
                            {
                                <button type="button" class="btn btn-sm btn-success fw-bold js-s09-approve"
                                        data-req-id="@item.LoanRequestId" data-approve="true">
                                    <i class="bi bi-check2-circle me-1"></i>Chủ Sách Duyệt P2P
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger js-s09-approve"
                                        data-req-id="@item.LoanRequestId" data-approve="false">
                                    Từ chối
                                </button>
                            }
                            else if (item.RequestStatus == "Approved" && item.LoanId == null && item.CopyStatus != "InTransit")
                            {
                                <button type="button" class="btn btn-sm btn-info fw-bold text-dark js-s09-stage"
                                        data-req-id="@item.LoanRequestId" data-stage="InTransit">
                                    <i class="bi bi-truck me-1"></i>Mang Ra Trạm Hub (InTransit)
                                </button>
                                <button type="button" class="btn btn-sm btn-primary fw-bold js-s09-stage"
                                        data-req-id="@item.LoanRequestId" data-stage="HandoverBorrowed">
                                    <i class="bi bi-handshake me-1"></i>Giao Nhận Ngay (+1 Quota)
                                </button>
                            }
                            else if (item.CopyStatus == "InTransit" && item.LoanId == null)
                            {
                                <button type="button" class="btn btn-sm btn-primary fw-bold js-s09-stage"
                                        data-req-id="@item.LoanRequestId" data-stage="HandoverBorrowed">
                                    <i class="bi bi-box2-heart-fill me-1"></i>Xác Nhận Nhận Sách (+1 LendQuotaBonus)
                                </button>
                            }
                            else if (item.LoanId != null && item.LoanStatus != "Returned")
                            {
                                <button type="button" class="btn btn-sm btn-warning fw-bold text-dark js-s09-stage"
                                        data-req-id="@item.LoanRequestId" data-stage="Returned">
                                    <i class="bi bi-arrow-return-left me-1"></i>Xác Nhận Hoàn Trả P2P (+2 TrustScore)
                                </button>
                            }
                            else if (item.LoanStatus == "Returned")
                            {
                                var p2pReviewTargetId = Model.CurrentUserId == item.BorrowerId ? item.OwnerUserId : item.BorrowerId;
                                <span class="badge bg-success py-2 px-3">
                                    <i class="bi bi-check2-all me-1"></i>Hoàn tất P2P (@(item.ReturnDate?.ToString("dd/MM/yyyy") ?? "Đã trả"))
                                </span>
                                <a asp-controller="S10ConditionReport" asp-action="Index" asp-route-loanId="@item.LoanId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-shield-check me-1"></i>Hộ Chiếu Kiểm Định
                                </a>
                                <!-- [FEAT-LOGIC] Khép kín vòng đời P2P Mượn -> Trả -> Đánh giá 2 chiều & Cộng TrustScore -->
                                <a asp-controller="S15TrustScoreReview" asp-action="Index"
                                   asp-route-loanId="@item.LoanId"
                                   asp-route-targetType="User"
                                   asp-route-targetId="@p2pReviewTargetId"
                                   class="btn btn-sm btn-warning text-dark fw-bold">
                                    ⭐ Đánh giá lượt mượn này
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary py-2 px-3">@item.RequestStatus</span>
                            }
                            <!-- [BS-RENTAL-CONTRACT] Nút xem & in Phiếu Hợp Đồng Thuê P2P Điện Tử kèm QR -->
                            <button type="button" class="btn btn-sm btn-outline-dark js-open-p2p-receipt"
                                    data-req-id="@item.LoanRequestId"
                                    data-loan-id="@(item.LoanId?.ToString() ?? "Chờ giao")"
                                    data-barcode="@item.Barcode"
                                    data-title="@item.BookTitle"
                                    data-borrower="@item.BorrowerName"
                                    data-owner="@item.OwnerName"
                                    data-hub="@item.PickupHubName"
                                    data-days="@item.DesiredDays"
                                    data-rental-fee="@((int)item.RentalFeeTotal)"
                                    data-deposit="@((int)item.DepositHeld)"
                                    data-escrow="@item.EscrowStatus"
                                    data-due="@(item.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa bắt đầu")">
                                <i class="bi bi-qr-code me-1"></i>Phiếu QR
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- [BS-RENTAL-CONTRACT] Modal Phiếu Hợp Đồng Thuê P2P Điện Tử & Mã QR/Barcode (In A5 / 80mm) -->
<div class="modal fade" id="bsP2PReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h6 class="modal-title fw-bold"><i class="bi bi-file-earmark-check text-primary me-1"></i>Phiếu Hợp Đồng Thuê Sách P2P &amp; Escrow</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center border-bottom pb-3 mb-3">
                    <div class="fw-bold fs-5 text-primary">BOOKSHARE P2P E-CONTRACT</div>
                    <div class="small text-muted">Giao nhận tại Trạm CLB/Hub • Bảo lãnh cọc 100%</div>
                    <img id="p2pRcQrImg" src="" alt="QR Hợp đồng P2P" class="my-2 border rounded-3 p-1 bg-white" style="width:150px; height:150px;" />
                    <div><code id="p2pRcBarcode" class="fs-6 fw-bold text-dark">BS-P2P</code></div>
                </div>
                <div class="small d-flex flex-column gap-1">
                    <div class="d-flex justify-content-between"><span class="text-muted">Mã Phiếu / Loan:</span><strong id="p2pRcRef">-</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Sách vật lý:</span><strong id="p2pRcTitle">-</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Chủ sách (Lender):</span><strong id="p2pRcOwner">-</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Người thuê (Borrower):</span><strong id="p2pRcBorrower">-</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Điểm hẹn Hub:</span><strong id="p2pRcHub">-</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Thời hạn / Hạn trả:</span><strong id="p2pRcDue">-</strong></div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-1"><span class="text-muted">Phí thuê giải ngân chủ sách:</span><strong id="p2pRcFee" class="text-primary">0đ</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Tiền cọc Escrow (Hoàn 100%):</span><strong id="p2pRcDeposit" class="text-success">0đ</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Trạng thái Escrow:</span><span id="p2pRcEscrow" class="badge bg-info text-dark">None</span></div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-sm btn-primary fw-bold" id="btnPrintP2PReceipt">
                    <i class="bi bi-printer-fill me-1"></i>In Phiếu (A5 / 80mm)
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s09-p2p-loan-flow/s09-p2p-loan-flow.js" asp-append-version="true"></script>
}
