@model BookShare.Web.Models.ViewModels.S08LibraryLoanPageViewModel
@{
    ViewData["Title"] = "Điều Phối Mượn – Trả Sách Kho Chung Thư Viện";
}

@section Styles {
    <link rel="stylesheet" href="~/modules/s08-library-loan-flow/s08-library-loan-flow.css" asp-append-version="true" />
}

<!-- 1. THÔNG TIN HẠN MỨC MƯỢN & KHỞI TẠO PHIẾU MƯỢN KHO CHUNG MỚI -->
<section class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="row g-4 align-items-center">
        <div class="col-lg-6">
            <span class="badge bg-primary mb-1">TRUNG TÂM LƯU THÔNG &amp; MƯỢN TRẢ THƯ VIỆN</span>
            <h4 class="fw-bold mb-1">🏛️ Điều Phối Mượn – Trả Sách Kho Chung Thư Viện</h4>
            <p class="text-muted small mb-3">
                Quy trình khép kín 4 bước: <strong>(1) Độc giả gửi yêu cầu</strong> &rarr; <strong>(2) Thủ thư kiểm tra hạn mức gói & Duyệt</strong> &rarr; <strong>(3) Bàn giao tại quầy (Sinh hợp đồng <code>Loans</code>)</strong> &rarr; <strong>(4) Thu hồi & Kiểm định sách trả</strong>.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <div class="s08-quota-badge">
                    <i class="bi bi-person-vcard text-primary me-1"></i>
                    Độc giả: <strong>@Model.CurrentUserName</strong> (<span class="text-primary fw-bold">Gói @Model.MembershipTier</span>)
                </div>
                <div class="s08-quota-badge">
                    <i class="bi bi-journal-check text-success me-1"></i>
                    Đang mượn: <strong>@Model.CurrentActiveLoansCount / @Model.EffectiveMaxLoans cuốn</strong>
                    <span class="text-muted">(Gốc @Model.MaxConcurrentLoans + Thưởng P2P @Model.LendQuotaBonus)</span>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="s08-request-box p-3 rounded-4">
                <h6 class="fw-bold small text-primary mb-2">
                    <i class="bi bi-plus-circle-fill me-1"></i>Bước 1: Tạo Nhanh Phiếu Yêu Cầu Mượn Kho Chung (<code>LoanRequests</code>)
                </h6>
                <form id="s08CreateRequestForm" class="row g-2 align-items-end">
                    <div class="col-md-7">
                        <label class="form-label small text-muted mb-1">Chọn bản sao sách Kho chung đang sẵn có (<code>Available</code>)</label>
                        <select id="s08BookCopyId" class="form-select form-select-sm" required>
                            @foreach (var copy in Model.AvailableLibraryCopies)
                            {
                                var feeTag = copy.DailyRentalFee > 0 ? $"{copy.DailyRentalFee:N0}đ/ngày • Cọc {copy.DepositAmount:N0}đ" : "Miễn phí 0đ";
                                <option value="@copy.BookCopyId" data-daily-fee="@((int)copy.DailyRentalFee)" data-deposit="@((int)copy.DepositAmount)">[@copy.Barcode] @copy.Title — @feeTag (@copy.LibraryName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">Số ngày</label>
                        <select id="s08DesiredDays" class="form-select form-select-sm">
                            <option value="7">7 ngày</option>
                            <option value="14" selected>14 ngày</option>
                            <option value="30">30 ngày</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold py-2">
                            <i class="bi bi-send-plus me-1"></i>Gửi Phiếu
                        </button>
                    </div>
                    <div class="col-12">
                        <div class="small text-primary fw-semibold" id="s08EscrowPreview">💰 Dự kiến tạm giữ Escrow khi nhận sách: Miễn phí 0 VNĐ</div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- 2. BẢNG ĐIỀU PHỐI LUỒNG MƯỢN - DUYỆT - GIAO - TRẢ SÁCH KHO CHUNG -->
<section class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h6 class="fw-bold mb-0">
            <i class="bi bi-diagram-3-fill text-primary me-2"></i>Danh Sách Phiếu Yêu Cầu & Hợp Đồng Mượn Kho Chung (@Model.LoanItems.Count phiếu)
        </h6>
        <span class="small text-muted">
            Bấm trực tiếp các nút thao tác từng bước ở cột phải để kiểm thử luồng Thủ thư duyệt, giao sách và thu hồi sách
        </span>
    </div>

    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.LoanItems)
        {
            int stepIndex = item.LoanStatus == "Returned" ? 4
                : (item.LoanId != null ? 3
                : (item.RequestStatus == "Approved" ? 2 : 1));

            <div class="s08-flow-card p-3 rounded-4">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-4">
                        <div class="d-flex gap-3 align-items-center">
                            <img src="@(string.IsNullOrEmpty(item.CoverImageUrl) ? "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=200" : item.CoverImageUrl)"
                                 class="s08-cover-thumb shadow-sm" alt="@item.BookTitle"
                                 onerror="this.src='https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=200'" />
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-dark">Phiếu #@item.LoanRequestId</span>
                                    <code class="fw-bold text-primary">@item.Barcode</code>
                                    <span class="badge bg-light text-dark border">@item.CopyStatus</span>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">@item.BookTitle</h6>
                                <div class="small text-muted">@item.LibraryName • @item.ShelfLocation</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="p-2 rounded-3 bg-light border small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Người mượn:</span>
                                <strong>@item.BorrowerName <span class="badge bg-primary bg-opacity-10 text-primary">@item.BorrowerTier</span></strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Kiểm tra hạn mức gói:</span>
                                <span class="fw-bold @(item.BorrowerActiveLoans < item.BorrowerMaxQuota ? "text-success" : "text-danger")">
                                    Đang mượn @item.BorrowerActiveLoans / @item.BorrowerMaxQuota cuốn
                                </span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Thời hạn đăng ký:</span>
                                <span>
                                    @item.DesiredDays ngày
                                    @if (item.DueDate.HasValue)
                                    {
                                        <strong class="text-primary">(Hạn trả: @item.DueDate.Value.ToString("dd/MM/yyyy"))</strong>
                                    }
                                </span>
                            </div>
                            <!-- [BS-RENTAL-FLOW] Thông tin Phí thuê & Trạng thái bảo lãnh cọc Escrow -->
                            <div class="d-flex justify-content-between pt-1 border-top">
                                <span class="text-muted">Phí thuê &amp; Escrow:</span>
                                <span>
                                    @if (item.RentalFeeTotal > 0 || item.DepositHeld > 0)
                                    {
                                        <strong class="text-primary">@item.RentalFeeTotal.ToString("N0")đ + Cọc @item.DepositHeld.ToString("N0")đ</strong>
                                        <span class="badge @(item.EscrowStatus == "Held" ? "bg-warning text-dark" : item.EscrowStatus == "RefundedToBorrower" || item.EscrowStatus == "ReleasedToLender" ? "bg-success" : "bg-secondary") ms-1">@item.EscrowStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">Miễn phí 0đ</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <!-- Thanh tiến trình 4 bước -->
                        <div class="d-flex justify-content-between small mb-2 px-1">
                            <span class="@(stepIndex >= 1 ? "text-primary fw-bold" : "text-muted")">1. Yêu cầu</span>
                            <span class="@(stepIndex >= 2 ? "text-primary fw-bold" : "text-muted")">2. Duyệt</span>
                            <span class="@(stepIndex >= 3 ? "text-primary fw-bold" : "text-muted")">3. Nhận sách</span>
                            <span class="@(stepIndex >= 4 ? "text-success fw-bold" : "text-muted")">4. Đã trả</span>
                        </div>

                        <div class="d-flex flex-wrap justify-content-end gap-2">
                            @if (item.RequestStatus == "Pending")
                            {
                                <button type="button" class="btn btn-sm btn-success fw-bold js-s08-approve"
                                        data-req-id="@item.LoanRequestId" data-approve="true">
                                    <i class="bi bi-check2-circle me-1"></i>Bước 2: Thủ thư Duyệt
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger js-s08-approve"
                                        data-req-id="@item.LoanRequestId" data-approve="false">
                                    Từ chối
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary js-s08-cancel"
                                        data-req-id="@item.LoanRequestId" title="Hủy / Xóa phiếu yêu cầu mượn (Delete CRUD)">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                            else if (item.RequestStatus == "Approved" && item.LoanId == null)
                            {
                                <button type="button" class="btn btn-sm btn-primary fw-bold js-s08-handover"
                                        data-req-id="@item.LoanRequestId">
                                    <i class="bi bi-box-arrow-right me-1"></i>Bước 3: Xác Nhận Giao Sách (Tạo Loan)
                                </button>
                            }
                            else if (item.LoanId != null && item.LoanStatus != "Returned")
                            {
                                <div class="input-group input-group-sm">
                                    <select class="form-select" id="returnCond-@item.LoanRequestId">
                                        <option value="Good" selected>Trả nguyên vẹn (Good)</option>
                                        <option value="Fair">Hao mòn nhẹ (Fair)</option>
                                        <option value="Damaged">Hư hỏng / Rách (Damaged)</option>
                                    </select>
                                    <button type="button" class="btn btn-warning fw-bold text-dark js-s08-return"
                                            data-req-id="@item.LoanRequestId">
                                        <i class="bi bi-box-arrow-in-left me-1"></i>Bước 4: Nhận Trả
                                    </button>
                                </div>
                            }
                            else if (item.LoanStatus == "Returned")
                            {
                                var reviewTargetType = Model.CurrentUserId == item.BorrowerId ? "Book" : "User";
                                var reviewTargetId = Model.CurrentUserId == item.BorrowerId ? item.BookId.ToString() : item.BorrowerId;
                                <span class="badge bg-success py-2 px-3">
                                    <i class="bi bi-check-all me-1"></i>Đã hoàn trả (@(item.ReturnDate?.ToString("dd/MM/yyyy") ?? "Hoàn tất"))
                                </span>
                                <a asp-controller="S10ConditionReport" asp-action="Index" asp-route-loanId="@item.LoanId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-shield-check me-1"></i>Hộ Chiếu Kiểm Định
                                </a>
                                <!-- [FEAT-LOGIC] Khép kín vòng đời Mượn -> Trả -> Đánh giá 2 chiều & Cộng TrustScore -->
                                <a asp-controller="S15TrustScoreReview" asp-action="Index"
                                   asp-route-loanId="@item.LoanId"
                                   asp-route-targetType="@reviewTargetType"
                                   asp-route-targetId="@reviewTargetId"
                                   class="btn btn-sm btn-warning text-dark fw-bold">
                                    ⭐ Đánh giá lượt mượn này
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary py-2 px-3">@item.RequestStatus</span>
                            }
                            <!-- [BS-RENTAL-CONTRACT] Nút xem & in Phiếu Hợp Đồng Thuê Điện Tử kèm QR/Barcode (A5/80mm) -->
                            <button type="button" class="btn btn-sm btn-outline-dark js-open-rental-receipt"
                                    data-req-id="@item.LoanRequestId"
                                    data-loan-id="@(item.LoanId?.ToString() ?? "Chờ giao")"
                                    data-barcode="@item.Barcode"
                                    data-title="@item.BookTitle"
                                    data-borrower="@item.BorrowerName"
                                    data-owner="@item.LibraryName"
                                    data-days="@item.DesiredDays"
                                    data-rental-fee="@((int)item.RentalFeeTotal)"
                                    data-deposit="@((int)item.DepositHeld)"
                                    data-escrow="@item.EscrowStatus"
                                    data-due="@(item.DueDate?.ToString("dd/MM/yyyy") ?? "Chưa bắt đầu")">
                                <i class="bi bi-qr-code me-1"></i>Phiếu QR
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- [BS-RENTAL-CONTRACT] Modal Phiếu Hợp Đồng Thuê Sách Điện Tử & Mã QR/Barcode (Hỗ trợ in A5 / 80mm) -->
<div class="modal fade" id="bsRentalReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h6 class="modal-title fw-bold"><i class="bi bi-file-earmark-text text-primary me-1"></i>Phiếu Hợp Đồng Thuê Sách Điện Tử &amp; QR</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="bsReceiptPrintArea">
                <div class="text-center border-bottom pb-3 mb-3">
                    <div class="fw-bold fs-5 text-primary">BOOKSHARE E-RENTAL CONTRACT</div>
                    <div class="small text-muted">Phiếu giao nhận &amp; bảo lãnh cọc Escrow (Khổ A5 / 80mm)</div>
                    <img id="rcQrImg" src="" alt="QR Hợp đồng thuê sách" class="my-2 border rounded-3 p-1 bg-white" style="width:150px; height:150px;" />
                    <div><code id="rcBarcode" class="fs-6 fw-bold text-dark">BS-SYS-0001</code></div>
                </div>
                <div class="small d-flex flex-column gap-1">
                    <div class="d-flex justify-content-between"><span class="text-muted">Mã Phiếu / Hợp đồng:</span><strong id="rcRef">#1</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Đầu sách vật lý:</span><strong id="rcTitle">-</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Đơn vị / Chủ sách:</span><strong id="rcOwner">-</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Người thuê:</span><strong id="rcBorrower">-</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Thời hạn / Hạn trả:</span><strong id="rcDue">-</strong></div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-1"><span class="text-muted">Tổng phí thuê:</span><strong id="rcFee" class="text-primary">0đ</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Tiền cọc Escrow (Hoàn 100%):</span><strong id="rcDeposit" class="text-success">0đ</strong></div>
                    <div class="d-flex justify-content-between"><span class="text-muted">Trạng thái Escrow:</span><span id="rcEscrow" class="badge bg-info text-dark">None</span></div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-sm btn-primary fw-bold" id="btnPrintRentalReceipt">
                    <i class="bi bi-printer-fill me-1"></i>In Phiếu (A5 / 80mm)
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/modules/s08-library-loan-flow/s08-library-loan-flow.js" asp-append-version="true"></script>
}
