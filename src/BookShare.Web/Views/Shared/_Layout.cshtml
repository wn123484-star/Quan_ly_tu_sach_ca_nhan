                                        <button type="button" class="btn btn-xs btn-outline-light py-0 px-2" data-set-ui-style="paper">📜 Trang sách</button>
                                        <button type="button" class="btn btn-xs btn-outline-warning py-0 px-2" data-set-ui-style="neobrutal">💥 Truyện tranh</button>
                                        <button type="button" class="btn btn-xs btn-outline-info py-0 px-2" data-set-ui-style="pastel">🍬 Kẹo ngọt</button>
                                        <button type="button" class="btn btn-xs btn-outline-success py-0 px-2" data-set-ui-style="terminal">💻 Terminal</button>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider border-secondary opacity-25 my-1" /></li>
                                <li>
                                    <form asp-controller="S01AuthOtpGoogle" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger fw-bold">
                                            <i class="bi bi-box-arrow-right"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown bs-domain-dropdown">
                            <a class="dropdown-toggle py-1 px-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Chọn giao diện, phong cách và màu sắc" aria-label="Chọn giao diện và màu sắc">
                                <i class="bi bi-palette-fill text-info"></i><span id="activePaletteLabel" class="d-none d-xxl-inline">Giao Diện</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" style="min-width:270px;">
                                <li class="px-3 py-1 small text-info fw-bold">🎨 Bảng màu giao diện</li>
                                <li><button type="button" class="dropdown-item" data-set-palette="blue" data-palette-name="Xanh Sapphire">🔵 Xanh Sapphire (Mặc định)</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="gold" data-palette-name="Vàng Mộng Mơ">✨ Vàng Mộng Mơ</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="rose" data-palette-name="Hồng Ấm Áp">🌸 Hồng Ấm Áp</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="sakura" data-palette-name="Hoa Anh Đào Pastel">🌷 Hoa Anh Đào Pastel</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="mint" data-palette-name="Bạc Hà Tươi Mát">🌿 Bạc Hà Tươi Mát</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="lavender" data-palette-name="Tím Oải Hương">💜 Tím Oải Hương</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="sepia" data-palette-name="Giấy Cổ Thư Viện">📜 Giấy Cổ Thư Viện</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="emerald" data-palette-name="Lục Bảo Thư Viện">🟢 Lục Bảo Thư Viện</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="ocean" data-palette-name="Xanh Đại Dương">🌊 Xanh Đại Dương</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="coral" data-palette-name="Cam Hoàng Hôn">🟠 Cam Hoàng Hôn</button></li>
                                <li><button type="button" class="dropdown-item" data-set-palette="midnight" data-palette-name="Đêm Ngân Hà">🌌 Đêm Ngân Hà</button></li>
                                <li><hr class="dropdown-divider border-secondary opacity-25 my-1" /></li>
                                <li class="px-3 py-1 small text-warning fw-bold">✏️ Phong cách giao diện (9 kiểu)</li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="standard">📘 Chuẩn Hiện Đại</button></li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="sketchy">✏️ Nét Vẽ Nghệch Ngoặc (Sketchy)</button></li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="morph">🫧 Kính Mờ Mềm Mại (Morph)</button></li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="flatly">📐 Phẳng Sắc Nét (Flatly)</button></li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="paper">📜 Trang Sách Cổ Điển (Paper)</button></li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="neobrutal">💥 Truyện Tranh Pop (Neo-Brutal)</button></li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="pastel">🍬 Kẹo Ngọt Dịu Mắt (Pastel)</button></li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="cyborg">⚡ Đêm Công Nghệ (Cyborg)</button></li>
                                <li><button type="button" class="dropdown-item" data-set-ui-style="terminal">💻 Lập Trình Viên (Terminal)</button></li>
                            </ul>
                        </div>

                        <a href="/S01AuthOtpGoogle?tab=qr" class="btn btn-xs btn-outline-light fw-bold px-2 py-1 rounded-pill text-decoration-none" title="Đăng nhập nhanh bằng mã QR">
                            <i class="bi bi-qr-code-scan me-1" aria-hidden="true"></i>Đăng nhập nhanh
                        </a>

                        <a asp-controller="S01AuthOtpGoogle" asp-action="Index" class="btn btn-xs btn-warning text-dark fw-bold px-3 py-1 rounded-pill text-decoration-none">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
                        </a>
                    }
                </div>
            </div>
        </div>
        </nav>

        <!-- Thanh Header Chính: Logo + Thanh Tìm Kiếm Lớn + Kệ Sách -->
        <div class="portal-main-bar">
            <div class="container">
                <div class="row align-items-center g-3">
                    <div class="col-lg-3 col-md-4">
                        <a asp-controller="Home" asp-action="Index" class="portal-logo">
                            <div class="bg-white text-primary rounded-3 d-flex align-items-center justify-content-center shadow-sm brand-logo-box" style="width:44px; height:44px;">
                                @IconService.RenderIconHtml("brand_logo", "bi-book-half", "fs-3")
                            </div>
                            <div>
                                <div class="fs-4 fw-bold lh-1">BookShare</div>
                                <small class="opacity-75" style="font-size:0.72rem;">Cổng Tri Thức &amp; Chia Sẻ Sách Cộng Đồng</small>
                            </div>
                        </a>
                    </div>

                    <div class="col-lg-7 col-md-6">
                        <form asp-controller="Home" asp-action="Index" method="get" role="search">
                            <div class="portal-search-box">
                                <input type="text" name="keyword" value="@Context.Request.Query["keyword"]" aria-label="Từ khóa tìm sách" placeholder="Tìm sách giấy theo Tên sách, Tác giả, ISBN (Mượn miễn phí 0đ - Không bán sách)..." />
                                <select name="source" aria-label="Nguồn sách">
                                    <option value="all">🌐 Tất cả nguồn sách</option>
                                    <option value="System">🏛️ Kho chung Thư viện</option>
                                    <option value="User">🤝 Tủ sách P2P Cộng đồng</option>
                                </select>
                                <button type="submit" class="portal-search-btn" aria-label="Tìm kiếm">
                                    <i class="bi bi-search" aria-hidden="true"></i>
                                </button>
                            </div>
                        </form>
                        <div class="portal-quick-tags">
                            <a href="/?source=System">@IconService.RenderIconHtml("quick_library", "bi-buildings-fill", "me-1")Kho Chung Thư Viện</a>
                            <a href="/?source=User">@IconService.RenderIconHtml("quick_p2p", "bi-people-fill", "me-1")Tủ Sách P2P Cộng Đồng</a>
                            <a href="/S06SearchDiscovery">@IconService.RenderIconHtml("quick_filter", "bi-funnel-fill", "me-1")Bộ Lọc Đa Tiêu Chí</a>
                            <a href="/S05IsbnAutoCatalog">@IconService.RenderIconHtml("quick_isbn", "bi-upc-scan", "me-1")Biên Mục Mã ISBN</a>
                            <a href="/S11HotBookQueue">@IconService.RenderIconHtml("quick_hot", "bi-fire", "me-1")Hàng Chờ Sách Hot</a>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-12 text-lg-end">
                        <a asp-controller="S02PersonalShelf" asp-action="Index" class="portal-shelf-cta text-white text-decoration-none d-inline-flex flex-column align-items-center">
                            <div class="position-relative">
                                @IconService.RenderIconHtml("nav_cart_shelf", "bi-journal-bookmark-fill", "fs-3")
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info text-dark">Kệ Sách</span>
                            </div>
                            <span style="font-size:0.74rem;" class="fw-semibold">Tủ Sách &amp; Phiếu Mượn</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- 2. KHUNG HIỂN THỊ TRẠNG THÁI HỆ THỐNG (CHỈ HIỆN KHI CÓ THÔNG BÁO THỰC TẾ) -->
    <div class="container status-banner-container">
        <div id="systemStatusBox" class="status-banner @statusClass @(hasFlash ? "" : "hidden-banner")" role="status" aria-live="polite" data-flash="@(hasFlash ? "1" : "0")">
            <div class="status-banner-left">
                <span id="statusCodeBadge" class="status-code-pill">MÃ @statusCode</span>
                <div class="status-text-group">
                    <strong id="statusTitleText">@statusTitle</strong>
                    <span id="statusDetailText" class="status-detail-sub">@statusDetail</span>
                </div>
            </div>
            <button type="button" class="status-close-btn" id="btnHideStatusBox" title="Thu gọn thông báo" aria-label="Thu gọn thông báo">×</button>
        </div>
    </div>

    <!-- 3. NỘI DUNG CHÍNH TỪNG MODULE -->
    <main id="mainContent" class="container py-4" tabindex="-1">
        @RenderBody()
    </main>

    <!-- 4. WIDGET TRỢ LÝ AI GỌN NHẸ Ở GÓC PHẢI DƯỚI (LỊCH SỬ BỀN VỮNG THEO PHÂN QUYỀN + RESET + EMAIL + STYLE) -->
    @if (!isAiFullPage)
    {
        <div id="aiFloatingWidget" class="ai-chat-widget" data-authenticated="@(isAuthenticated ? "1" : "0")" data-user-role="@currentRole">
            <button type="button" id="btnToggleAIChat" class="ai-chat-fab shadow" aria-expanded="false" aria-controls="aiChatPopup" title="Trợ lý AI Thủ thư" aria-label="Mở Trợ lý AI Thủ thư">
                @IconService.RenderIconHtml("ai_fab", "bi-stars", "fs-4")
            </button>

            <div id="aiChatPopup" class="ai-chat-popup shadow-lg d-none" role="dialog" aria-label="Trợ lý AI BookShare">
                <div class="ai-chat-header text-white d-flex justify-content-between align-items-center px-3 py-2">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        @IconService.RenderIconHtml("ai_fab", "bi-stars", "fs-5")
                        <div class="min-w-0">
                            <strong class="small d-block text-truncate">Trợ lý AI BookShare</strong>
                            <span id="aiWidgetSubtitle" style="font-size: 0.68rem; opacity: 0.9;" class="d-block text-truncate">
                                @(isAuthenticated ? $"Phiên lưu bền vững • {currentRole}" : "Tư vấn kho sách & giao diện")
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-1 flex-shrink-0">
                        <button type="button" id="btnToggleAiStyleBar" class="btn btn-sm text-white p-0 px-1" title="Chọn phong cách, font & cỡ chữ" aria-label="Chọn phong cách và font chữ">
                            <i class="bi bi-palette2" aria-hidden="true"></i>
                        </button>
                        @if (isAuthenticated)
                        {
                            <button type="button" id="btnEmailAIChat" class="btn btn-sm text-white p-0 px-1" title="Gửi bản lưu hội thoại qua Email" aria-label="Gửi hội thoại qua Email">
                                <i class="bi bi-envelope-arrow-up" aria-hidden="true"></i>
                            </button>
                        }
                        <button type="button" id="btnResetAIChat" class="btn btn-sm text-white p-0 px-1" title="Đặt lại cuộc trò chuyện (Reset Chat)" aria-label="Đặt lại cuộc trò chuyện">
                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        </button>
                        <a asp-controller="S13GeminiAiAssistant" asp-action="Index" class="btn btn-sm text-white p-0 px-1" title="Mở toàn trang Trợ lý AI" aria-label="Mở toàn trang Trợ lý AI">
                            <i class="bi bi-arrows-angle-expand" aria-hidden="true"></i>
                        </a>
                        <button type="button" id="btnMinimizeAIChat" class="btn btn-sm text-white p-0 px-1" title="Thu gọn khung chat" aria-label="Thu gọn khung chat">
                            <i class="bi bi-dash-lg" aria-hidden="true"></i>
                        </button>
                        <button type="button" id="btnCloseAIChat" class="btn btn-sm text-white p-0 px-1" title="Đóng trợ lý AI" aria-label="Đóng trợ lý AI">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <!-- Thanh tùy biến Style/Màu/Font/Cỡ chữ nhanh ngay trong Chat AI -->
                <div id="aiWidgetStyleBar" class="ai-chat-stylebar d-none">
                    <select id="aiStyleSelect" class="form-select form-select-sm" aria-label="Chọn phong cách giao diện">
                        <option value="standard">Style: Chuẩn Hiện Đại</option>
                        <option value="sketchy">Style: Nét vẽ nghệch ngoặc</option>
                        <option value="morph">Style: Kính mờ Morph</option>
                        <option value="flatly">Style: Phẳng sắc nét</option>
                        <option value="paper">Style: Trang sách cổ điển</option>
                        <option value="neobrutal">Style: Truyện tranh Pop</option>
                        <option value="pastel">Style: Kẹo ngọt dịu mắt</option>
                        <option value="cyborg">Style: Đêm công nghệ</option>
                        <option value="terminal">Style: Lập trình viên</option>
                    </select>
                    <select id="aiPaletteSelect" class="form-select form-select-sm" aria-label="Chọn bảng màu">
                        <option value="blue">Màu: Sapphire</option>
                        <option value="gold">Màu: Vàng Mộng Mơ</option>
                        <option value="rose">Màu: Hồng Ấm Áp</option>
                        <option value="sakura">Màu: Hoa Anh Đào</option>
                        <option value="mint">Màu: Bạc Hà Tươi</option>
                        <option value="lavender">Màu: Tím Oải Hương</option>
                        <option value="sepia">Màu: Giấy Cổ</option>
                        <option value="emerald">Màu: Lục Bảo</option>
                        <option value="ocean">Màu: Đại Dương</option>
                        <option value="coral">Màu: Cam Hoàng Hôn</option>
                        <option value="royal">Màu: Tím Hoàng Gia</option>
                        <option value="midnight">Màu: Đêm Ngân Hà</option>
                    </select>
                    <select id="aiBgSelect" class="form-select form-select-sm" aria-label="Chọn loại nền trang">
                        <option value="solid">Nền: Trơn chuẩn</option>
                        <option value="paper-grain">Nền: Giấy sách ấm</option>
                        <option value="dot-grid">Nền: Lưới chấm sổ tay</option>
                        <option value="graph-grid">Nền: Kẻ ô kỹ thuật</option>
                        <option value="notebook-lines">Nền: Trang vở kẻ ngang</option>
                        <option value="soft-aurora">Nền: Cực quang dịu nhẹ</option>
                        <option value="sunset-glow">Nền: Hoàng hôn ấm áp</option>
                        <option value="botanical">Nền: Vườn sách xanh mát</option>
                        <option value="starry-night">Nền: Bầu trời sao nhẹ</option>
                        <option value="warm-linen">Nền: Vải bố cổ điển</option>
                        <option value="pastel-clouds">Nền: Mây Pastel mộng mơ</option>
                        <option value="geometric-prism">Nền: Hoa văn hình học</option>
                    </select>
                    <select id="aiFontSelect" class="form-select form-select-sm" aria-label="Chọn phông chữ">
                        <option value="roboto">Font: Roboto</option>
                        <option value="bevietnam">Font: Be Vietnam Pro</option>
                        <option value="lora">Font: Lora (Sách giấy)</option>
                        <option value="patrick">Font: Patrick Hand</option>
                        <option value="jetbrains">Font: JetBrains Mono</option>
                    </select>
                    <select id="aiFontSizeSelect" class="form-select form-select-sm" aria-label="Chọn cỡ chữ">
                        <option value="xs">Cỡ chữ: Siêu nhỏ (13px)</option>
                        <option value="sm">Cỡ chữ: Nhỏ (14px)</option>
                        <option value="md">Cỡ chữ: Chuẩn (16px)</option>
                        <option value="lg">Cỡ chữ: Vừa lớn (17.5px)</option>
                        <option value="xl">Cỡ chữ: Lớn (19px)</option>
                        <option value="2xl">Cỡ chữ: Rất lớn (20.5px)</option>
                        <option value="3xl">Cỡ chữ: Siêu lớn (22px)</option>
                    </select>
                </div>

                <div class="px-2 py-2 border-bottom bg-body-tertiary d-flex gap-1 flex-wrap">
                    <button type="button" class="btn btn-outline-primary btn-xs ai-quick-prompt" data-prompt="Gợi ý sách sẵn sàng cho mượn trong kho ĐH CMC.">📚 Sách sẵn có</button>
                    <button type="button" class="btn btn-outline-success btn-xs ai-quick-prompt" data-prompt="Kiểm tra tiến độ đọc và hạn trả sách hiện tại của mình.">⏰ Hạn trả</button>
                    <button type="button" class="btn btn-outline-warning text-dark btn-xs ai-quick-prompt" data-prompt="Đổi giao diện sang phong cách nét vẽ nghệch ngoặc màu vàng mộng mơ.">✏️ Thử Sketchy</button>
                </div>

                <div id="aiChatWidgetMessages" class="ai-chat-messages p-3" role="log" aria-live="polite">
                    <div class="ai-msg ai-msg-bot">Xin chào! Mình là Trợ lý AI BookShare. Bạn cần tìm sách mượn miễn phí hay tùy chỉnh giao diện, font chữ?</div>
                </div>

                <form id="aiChatWidgetForm" class="border-top p-2 d-flex gap-2 bg-white">
                    <input type="text" id="aiChatWidgetInput" class="form-control form-control-sm" placeholder="Nhập câu hỏi hoặc lệnh đổi giao diện..." autocomplete="off" aria-label="Câu hỏi cho trợ lý AI" />
                    <button type="submit" class="btn btn-primary btn-sm px-3" aria-label="Gửi câu hỏi"><i class="bi bi-send" aria-hidden="true"></i></button>
                </form>
            </div>
        </div>
    }

    <footer class="py-4 mt-auto border-top bg-white">
        <div class="container text-center text-muted small">
            <p class="mb-1 fw-bold">BookShare – Hệ Sinh Thái Thư Viện Số, Quản Lý Tủ Sách Cá Nhân &amp; Chia Sẻ Sách Cộng Đồng</p>
            <p class="mb-0">100% chia sẻ &amp; mượn trả sách giấy 0đ • Bảo lãnh uy tín thành viên minh bạch</p>
            @if (RecaptchaService.IsEnabled)
            {
                <p class="mb-0 mt-1" style="font-size:0.72rem; opacity:0.75;">
                    Bảo vệ chống truy cập tự động bởi Google reCAPTCHA (áp dụng Chính sách Quyền riêng tư &amp; Điều khoản của Google).
                </p>
            }
        </div>
    </footer>

    <nav id="mobileBottomNav" class="mobile-bottom-nav" aria-label="Điều hướng nhanh trên di động">
        <a asp-controller="Home" asp-action="Index" class="mobile-nav-item">
            @IconService.RenderIconHtml("nav_home", "bi-house-door-fill")
            <span>Trang chủ</span>
        </a>
        <a asp-controller="S02PersonalShelf" asp-action="Index" class="mobile-nav-item">
            @IconService.RenderIconHtml("nav_shelf", "bi-bookshelf")
            <span>Tủ sách</span>
        </a>
        <button type="button" id="btnMobileCenterQr" class="mobile-nav-qr-btn" aria-label="Quét QR thanh toán, đăng nhập và bàn giao sách">
            @IconService.RenderIconHtml("qr_scan", "bi-qr-code-scan")
        </button>
        <a asp-controller="S18NotificationHub" asp-action="Index" class="mobile-nav-item position-relative">
            <i class="bi bi-bell-fill"></i>
            <span>Thông báo</span>
            <span id="mobileUnreadBadge" class="mobile-nav-badge d-none">0</span>
        </a>
        <a asp-controller="S01AuthOtpGoogle" asp-action="Index" class="mobile-nav-item">
            @IconService.RenderIconHtml("avatar_default", "bi-person-circle")
            <span>@(isAuthenticated ? "Hồ sơ" : "Tài khoản")</span>
        </a>
    </nav>

    <script src="~/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/vendor/chartjs/chart.umd.js"></script>
    @* Không gắn ?v= để trùng URL với lệnh import '../../js/core-api.js' của các module → trình duyệt chỉ nạp 1 bản *@
    <script type="module" src="~/js/core-api.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // PWA: đăng ký Service Worker cache tài nguyên tĩnh (CSS, JS, Fonts)
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/service-worker.js').catch(function () { });
            });
        }
    </script>
</body>
</html>
