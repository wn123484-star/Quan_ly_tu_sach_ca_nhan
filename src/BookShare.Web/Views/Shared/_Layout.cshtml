@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject BookShare.Web.Services.Interfaces.IRecaptchaService RecaptchaService
@inject BookShare.Web.Services.Interfaces.ISystemIconService IconService
@{
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isMobileApp = Context.Request.Headers.UserAgent.ToString().Contains("BookShareAndroidApp", StringComparison.OrdinalIgnoreCase);
    var isAiFullPage = Context.Request.Path.StartsWithSegments("/S13GeminiAiAssistant", StringComparison.OrdinalIgnoreCase);
    var currentUserName = User.Identity?.Name ?? "Khách (Chế độ Xem nhanh)";
    var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
    var currentTrust = User.FindFirst("TrustScore")?.Value ?? "100";
    var currentAvatarUrl = User.FindFirst("AvatarUrl")?.Value;
    var defaultAvatarIcon = IconService.GetImageUrl("avatar_default", "/images/avatar-default.svg");

    var statusCode = TempData["StatusCode"] as int? ?? 200;
    var flashTitle = TempData["StatusTitle"] as string;
    var hasFlash = !string.IsNullOrEmpty(flashTitle);
    var statusTitle = flashTitle ?? "Hệ thống BookShare hoạt động ổn định";
    var statusDetail = TempData["StatusDetail"] as string ?? "Hệ thống BookShare đã sẵn sàng phục vụ bạn.";
    var statusClass = statusCode >= 500 ? "status-500" : statusCode == 404 ? "status-404" : statusCode >= 400 ? "status-400" : statusCode >= 300 ? "status-300" : "status-200";

    // Huy hiệu TrustScore: Bronze < 110 <= Silver < 130 <= Gold < 150 <= Platinum
    var trustValue = int.TryParse(currentTrust, out var parsedTrust) ? parsedTrust : 0;
    var trustTier = trustValue >= 150 ? "Platinum" : trustValue >= 130 ? "Gold" : trustValue >= 110 ? "Silver" : "Bronze";
    var faviconUrl = IconService.GetImageUrl("brand_favicon", "/images/icons/icon-192.png");
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="csrf-token" content="@antiForgeryToken" />
    @if (RecaptchaService.IsEnabled)
    {
        <meta name="recaptcha-site-key" content="@RecaptchaService.SiteKey" />
        <script src="https://www.google.com/recaptcha/api.js?render=@RecaptchaService.SiteKey" async defer></script>
    }
    <title>@ViewData["Title"] - BookShare</title>

    <!-- Zero-FOUC: áp dụng ngay Chế độ Sáng/Tối, Phong cách Bootstrap, Phông chữ & Cỡ chữ cục bộ (0 CDN) -->
    <script>
        (function () {
            var styleMap = {
                sketchy: '/vendor/bootswatch/sketchy.min.css',
                flatly: '/vendor/bootswatch/flatly.min.css',
                morph: '/vendor/bootswatch/morph.min.css',
                cyborg: '/vendor/bootswatch/cyborg.min.css',
                terminal: '/vendor/bootswatch/cyborg.min.css'
            };
            var prefs = { theme: 'light', style: 'standard', palette: 'blue', background: 'solid', font: 'roboto', fontSize: 'md' };
            try {
                var raw = localStorage.getItem('bookshare_ui_prefs');
                if (raw) {
                    var parsed = JSON.parse(raw);
                    if (parsed && typeof parsed === 'object') {
                        if (parsed.theme === 'dark') prefs.theme = 'dark';
                        if (parsed.style) prefs.style = parsed.style;
                        if (parsed.palette) prefs.palette = parsed.palette;
                        if (parsed.background) prefs.background = parsed.background;
                        if (parsed.font) prefs.font = parsed.font;
                        if (parsed.fontSize) prefs.fontSize = parsed.fontSize;
                    }
                } else {
                    if (localStorage.getItem('bookshare_theme') === 'dark') prefs.theme = 'dark';
                    var p = localStorage.getItem('bookshare_palette');
                    if (p) prefs.palette = p;
                }
            } catch (e) { }
            var html = document.documentElement;
            html.setAttribute('data-bs-theme', (prefs.style === 'cyborg' || prefs.style === 'terminal') ? 'dark' : prefs.theme);
            html.setAttribute('data-ui-style', prefs.style);
            html.setAttribute('data-bg-pattern', prefs.background);
            html.setAttribute('data-font-family', prefs.font);
            html.setAttribute('data-font-size', prefs.fontSize);
            window.__bsInitialUiPrefs = prefs;
            window.__bsStyleCssUrl = styleMap[prefs.style] || '/vendor/bootstrap/bootstrap.min.css';
        })();
    </script>

    <!-- PWA & Favicon tùy biến -->
    <link rel="icon" href="@faviconUrl" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="BookShare" />
    <link rel="apple-touch-icon" href="@faviconUrl" />

    <link id="bsBootstrapThemeLink" rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css" />
    <script>
        (function () {
            var lnk = document.getElementById('bsBootstrapThemeLink');
            if (lnk && window.__bsStyleCssUrl && !lnk.getAttribute('href').endsWith(window.__bsStyleCssUrl)) {
                lnk.setAttribute('href', window.__bsStyleCssUrl);
            }
        })();
    </script>
    <link rel="stylesheet" href="~/vendor/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/core-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-portal-palette="blue" data-authenticated="@(isAuthenticated ? "1" : "0")" class="@(isMobileApp ? "is-mobile-app" : null)">
    <script>
        if (window.__bsInitialUiPrefs && window.__bsInitialUiPrefs.palette) {
            document.body.setAttribute('data-portal-palette', window.__bsInitialUiPrefs.palette);
        }
    </script>
    <a href="#mainContent" class="skip-link">Bỏ qua menu, tới nội dung chính</a>

    <!-- Splash Screen: chỉ hiện trên trình duyệt web/PWA (Android App dùng lớp chờ native để tránh kẹt kép) -->
    @if (!isMobileApp)
    {
        <div id="appSplash" class="app-splash" role="status" aria-label="Đang khởi động BookShare">
            <div class="app-splash-logo" aria-hidden="true">@IconService.RenderIconHtml("brand_logo", "bi-book-half")</div>
            <div class="fs-4 fw-bold">BookShare</div>
            <div class="small opacity-75">Mượn sách giấy cộng đồng • Không bán sách</div>
            <div class="spinner-border spinner-border-sm mt-2" aria-hidden="true"></div>
        </div>
        <script>
            (function () {
                var seen = false;
                try { seen = sessionStorage.getItem('bookshare_splash') === '1'; sessionStorage.setItem('bookshare_splash', '1'); } catch (e) { }
                var splash = document.getElementById('appSplash');
                if (!splash) return;
                if (seen) { splash.remove(); return; }
                var dismissed = false;
                var dismiss = function () {
                    if (dismissed || !splash) return;
                    dismissed = true;
                    splash.classList.add('is-hidden');
                    setTimeout(function () { if (splash && splash.parentNode) splash.remove(); }, 450);
                };
                document.addEventListener('DOMContentLoaded', function () { setTimeout(dismiss, 350); }, { once: true });
                window.addEventListener('load', dismiss, { once: true });
                setTimeout(dismiss, 2200);
            })();
        </script>
    }

