@model BookShare.Web.Models.ViewModels.PortalHomeViewModel
@inject BookShare.Web.Services.Interfaces.ISystemIconService IconService
@{
    ViewData["Title"] = "Cổng Khám Phá & Mượn Sách Cộng Đồng";
    var bookPlaceholderUrl = IconService.GetImageUrl("book_placeholder", "/images/book-placeholder.svg");
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isStaffAdmin = isAuthenticated && User.IsInRole("Admin");
    var isStaffLibrarian = isAuthenticated && (User.IsInRole("Librarian") || User.IsInRole("Admin"));
    var isStaffCurator = isAuthenticated && (User.IsInRole("Curator") || User.IsInRole("Admin"));
}

<!-- KHỐI BANNER PORTAL & CỤM DỊCH VỤ NHANH -->
<section class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="row g-3">
        <!-- [LOCKED-DESIGN] Hero Banner Tone Xanh Dương Đậm (Deep Royal / Sapphire Navy) Chuẩn Mẫu Tham Khảo -->
        <div class="col-lg-8">
            <div class="p-4 rounded-4 text-white h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #060d1f 0%, #0f172a 52%, #1e3a8a 100%); border: 1.5px solid rgba(56, 189, 248, 0.45); min-height: 230px; box-shadow: 0 14px 32px rgba(6, 13, 31, 0.25);">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge bg-info text-dark fw-bold px-3 py-1 rounded-pill">
                            <i class="bi bi-stars me-1"></i>HỆ SINH THÁI THƯ VIỆN SỐ &amp; CHIA SẺ SÁCH CỘNG ĐỒNG P2P
                        </span>
                        <span class="badge bg-dark border border-info text-info">🛡️ Bảo Lãnh Tín Nhiệm Độc Giả</span>
                    </div>
                    <h3 class="fw-bold mb-2" style="color: #38bdf8;">Mượn Sách Kho Trường &amp; Tủ Sách Cá Nhân Hoàn Toàn Miễn Phí</h3>
                    <p class="small opacity-90 mb-3">
                        Đang kết nối <strong>@Model.TotalBooksCount đầu sách học thuật</strong> và <strong>@Model.TotalCopiesCount bản sao vật lý</strong> (@Model.AvailableCopiesCount bản sẵn sàng cho mượn ngay). Quản lý trọn vẹn chu trình: Biên mục ISBN, Theo dõi trang đọc, Mượn trả cộng đồng và Kiểm định tình trạng sách.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="S06SearchDiscovery" asp-action="Index" class="btn btn-primary btn-sm fw-bold px-3 py-2">
                        <i class="bi bi-funnel-fill me-1"></i>Tìm Kiếm Đa Tiêu Chí
                    </a>
                    <a asp-controller="S02PersonalShelf" asp-action="Index" class="btn btn-info text-dark btn-sm fw-bold px-3 py-2">
                        <i class="bi bi-bookshelf me-1"></i>Tủ Sách Cá Nhân
                    </a>
                    <a asp-controller="S08LibraryLoanFlow" asp-action="Index" class="btn btn-warning text-dark btn-sm fw-bold px-3 py-2">
                        <i class="bi bi-journal-arrow-down me-1"></i>Mượn Kho Thư Viện
                    </a>
                    <a asp-controller="S09P2PLoanFlow" asp-action="Index" class="btn btn-outline-light btn-sm fw-semibold px-3 py-2">
                        <i class="bi bi-people-fill me-1"></i>Mượn Cộng Đồng P2P
                    </a>
                    <a asp-controller="S20ExchangeHubClub" asp-action="Index" class="btn btn-outline-info btn-sm fw-bold px-3 py-2">
                        <i class="bi bi-geo-alt-fill me-1"></i>Câu Lạc Bộ Sách
                    </a>
                    <a asp-controller="S13GeminiAiAssistant" asp-action="Index" class="btn btn-outline-warning btn-sm fw-bold px-3 py-2">
                        <i class="bi bi-robot me-1"></i>Trợ Lý Đọc Sách AI
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-4 d-flex flex-column gap-3">
            <div class="p-3 rounded-4 text-white flex-fill d-flex flex-column justify-content-center" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); border: 1.5px solid rgba(56, 189, 248, 0.4);">
                <span class="badge bg-info text-dark fw-bold align-self-start mb-1" style="font-size:0.7rem;">CỘNG ĐỒNG MINH BẠCH &amp; PHÂN QUYỀN RÕ RÀNG</span>
                <h6 class="fw-bold mb-1">Độc Giả • Trưởng Nhóm CLB • Thủ Thư • Quản Trị</h6>
                <p class="small opacity-85 mb-0">Mỗi vai trò có cổng nghiệp vụ riêng rõ ràng; Thủ thư &amp; Quản trị viên điều phối tập trung toàn bộ mượn trả tại một màn hình duy nhất.</p>
            </div>
            <div class="p-3 rounded-4 text-white flex-fill d-flex flex-column justify-content-center" style="background: linear-gradient(135deg, #060d1f 0%, #0369a1 100%); border: 1.5px solid rgba(250, 204, 21, 0.45);">
                <span class="badge bg-warning text-dark fw-bold align-self-start mb-1" style="font-size:0.7rem;">BẢO LÃNH MƯỢN TRẢ &amp; KIỂM ĐỊNH MINH BẠCH</span>
                <h6 class="fw-bold mb-1">Hộ Chiếu Tình Trạng Sách &amp; Gói Hội Viên 4 Cấp</h6>
                <p class="small opacity-85 mb-0">Đối chiếu hình ảnh trước/sau khi mượn, tự động cập nhật điểm uy tín thành viên và xác minh thông báo qua mã OTP Email.</p>
            </div>
        </div>
    </div>
</section>

<!-- CỔNG LÀM VIỆC RIÊNG THEO PHÂN QUYỀN (HIỂN THỊ NGAY KHI ĐĂNG NHẬP THỦ THƯ / TRƯỞNG CLB / ADMIN) -->
@if (isStaffLibrarian || isStaffCurator || isStaffAdmin)
{
    <section class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white border-start border-4 border-primary">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h6 class="fw-bold text-primary text-uppercase mb-0">
                <i class="bi bi-briefcase-fill me-2"></i>Cổng Nghiệp Vụ Dành Riêng Cho Vai Trò Của Bạn
            </h6>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                @(isStaffAdmin ? "Quản trị viên có toàn bộ quyền vận hành" : isStaffLibrarian ? "Cổng Thủ thư" : "Cổng Trưởng nhóm CLB")
            </span>
        </div>
        <div class="row g-3">
            @if (isStaffLibrarian)
            {
                <div class="col-md-4">
                    <a asp-controller="S21LibrarianDesk" asp-action="Index" class="d-block p-3 rounded-4 border text-decoration-none h-100 bg-light text-dark">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success"><i class="bi bi-upc-scan me-1"></i>Quầy Thủ Thư</span>
                            <strong class="small text-success ms-auto">Mở ngay &rarr;</strong>
                        </div>
                        <div class="fw-bold">Quầy Mượn Trả Tổng Hợp</div>
                        <small class="text-muted">Duyệt &amp; cho mượn trực tiếp tất cả sách (Kho chung + P2P), quét mã vạch, nhập lô và thu hồi sách quá hạn.</small>
                    </a>
                </div>
            }
            @if (isStaffCurator)
            {
                <div class="col-md-4">
                    <a asp-controller="S20ExchangeHubClub" asp-action="Index" class="d-block p-3 rounded-4 border text-decoration-none h-100 bg-light text-dark">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-warning text-dark"><i class="bi bi-people-fill me-1"></i>Không Gian CLB</span>
                            <strong class="small text-primary ms-auto">Mở ngay &rarr;</strong>
                        </div>
                        <div class="fw-bold">Quản Lý CLB Dạng Group &amp; Trạm Sách</div>
                        <small class="text-muted">Tách riêng từng CLB, thêm/duyệt thành viên, phân công Trưởng/Phó nhóm, đăng bảng tin và kiểm định sách.</small>
                    </a>
                </div>
            }
            @if (isStaffAdmin)
            {
                <div class="col-md-4">
                    <a asp-controller="S22AdminAnalytics" asp-action="Index" class="d-block p-3 rounded-4 border text-decoration-none h-100 bg-light text-dark">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-danger"><i class="bi bi-speedometer2 me-1"></i>Quản Trị Hệ Thống</span>
                            <strong class="small text-danger ms-auto">Mở ngay &rarr;</strong>
                        </div>
                        <div class="fw-bold">Thống Kê, Biểu Đồ, Phân Quyền &amp; Icon</div>
                        <small class="text-muted">Lọc biểu đồ theo thời gian/kênh/thể loại, quản lý toàn bộ tài khoản, phân quyền và tùy chỉnh biểu tượng.</small>
                    </a>
                </div>
            }
        </div>
    </section>
}

<!-- LƯỚI DANH MỤC THỂ LOẠI SÁCH (CATEGORIES) -->
<section class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h6 class="fw-bold text-secondary text-uppercase mb-0">
            <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Danh Mục Chuyên Ngành &amp; Kệ Sách (@Model.Categories.Count Chuyên mục)
        </h6>
        <a asp-controller="Home" asp-action="Index" class="small text-decoration-none">Xem tất cả (@Model.TotalBooksCount đầu sách)</a>
    </div>
    <div class="row g-2">
        @foreach (var cat in Model.Categories)
        {
            var isActive = Model.CategorySlug == cat.Slug;
            <div class="col-6 col-md-3 col-lg-3">
                <a asp-controller="Home" asp-action="Index" asp-route-category="@cat.Slug" asp-route-source="@Model.SourceFilter"
                   class="d-flex align-items-center gap-3 p-3 rounded-3 border text-decoration-none @(isActive ? "border-primary bg-primary bg-opacity-10 text-primary fw-bold" : "bg-light text-dark")">
                    <i class="bi @cat.IconClass fs-4 text-primary"></i>
                    <div class="text-truncate">
                        <div class="small fw-semibold text-truncate">@cat.Name</div>
                        <small class="text-muted">@cat.BookCount đầu sách</small>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- LƯỚI KỆ SÁCH ĐANG MỞ CHO MƯỢN (CÓ BỘ LỌC ĐA TIÊU CHÍ & PHÂN TRANG) -->
<section class="card border-0 shadow-sm rounded-4 p-4 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <h5 class="fw-bold mb-1">
                <i class="bi bi-journal-richtext text-primary me-2"></i>Kệ Sách Đang Mở Cho Mượn Miễn Phí
                <span class="badge bg-primary ms-2">@Model.TotalFilteredCopies bản sao • Trang @Model.Page/@Model.TotalPages</span>
            </h5>
            <p class="text-muted small mb-0">Tách biệt rõ ràng giữa Kho chung Thư viện trường và Tủ sách Chia sẻ Cộng đồng (0đ mượn trả minh bạch).</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Thanh chuyển đổi mật độ kệ sách -->
            <div class="bs-density-bar" role="group" aria-label="Chọn mật độ hiển thị kệ sách">
                <button type="button" class="bs-density-btn active" data-shelf-density="3" aria-pressed="true" title="Hiển thị 3 cột rộng">
                    <i class="bi bi-grid-3x2-gap-fill" aria-hidden="true"></i><span>3 Cột Rộng</span>
                </button>
                <button type="button" class="bs-density-btn" data-shelf-density="4" aria-pressed="false" title="Hiển thị 4 cột tiêu chuẩn">
                    <i class="bi bi-grid-fill" aria-hidden="true"></i><span>4 Cột</span>
                </button>
                <button type="button" class="bs-density-btn" data-shelf-density="list" aria-pressed="false" title="Hiển thị dạng danh sách ngang">
                    <i class="bi bi-view-list" aria-hidden="true"></i><span>Danh Sách</span>
                </button>
            </div>
        </div>
    </div>

    <!-- BỘ LỌC ĐA TIÊU CHÍ TRANG CHỦ -->
    <form method="get" asp-controller="Home" asp-action="Index" id="homeShelfFilterForm" class="row g-2 mb-4 p-3 rounded-4 bg-light border align-items-end">
        <div class="col-lg-3 col-md-6">
            <label class="form-label small fw-bold mb-1" for="homeFilterKeyword">Từ khóa</label>
            <input type="text" id="homeFilterKeyword" name="keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="Tên sách, tác giả, ISBN, mã vạch..." />
        </div>
        <div class="col-lg-2 col-md-6">
            <label class="form-label small fw-bold mb-1" for="homeFilterSource">Nguồn sách</label>
            <select id="homeFilterSource" name="source" class="form-select form-select-sm">
                <option value="all" selected="@(Model.SourceFilter == "all")">🌐 Tất cả nguồn</option>
                <option value="System" selected="@(Model.SourceFilter == "System")">🏛️ Kho Chung ĐH CMC</option>
                <option value="User" selected="@(Model.SourceFilter == "User")">🤝 Tủ Sách P2P</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label small fw-bold mb-1" for="homeFilterCategory">Chuyên mục</label>
            <select id="homeFilterCategory" name="category" class="form-select form-select-sm">
                <option value="all" selected="@(string.IsNullOrEmpty(Model.CategorySlug) || Model.CategorySlug == "all")">Tất cả thể loại</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Slug" selected="@(Model.CategorySlug == cat.Slug)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label small fw-bold mb-1" for="homeFilterAvail">Trạng thái</label>
            <select id="homeFilterAvail" name="availability" class="form-select form-select-sm">
                <option value="all" selected="@(Model.AvailabilityFilter == "all")">Mọi trạng thái</option>
                <option value="Available" selected="@(Model.AvailabilityFilter == "Available")">✅ Sẵn sàng mượn</option>
                <option value="Borrowed" selected="@(Model.AvailabilityFilter == "Borrowed")">⏳ Đang mượn / Chờ</option>
            </select>
        </div>
        <div class="col-lg-1 col-md-4">
            <label class="form-label small fw-bold mb-1" for="homeFilterCond">Độ mới</label>
            <select id="homeFilterCond" name="condition" class="form-select form-select-sm">
                <option value="all" selected="@(Model.ConditionFilter == "all")">Tất cả</option>
                <option value="New" selected="@(Model.ConditionFilter == "New")">New</option>
                <option value="Good" selected="@(Model.ConditionFilter == "Good")">Good</option>
                <option value="Fair" selected="@(Model.ConditionFilter == "Fair")">Fair</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-12">
            <label class="form-label small fw-bold mb-1" for="homeFilterSort">Sắp xếp</label>
            <div class="d-flex gap-1">
                <select id="homeFilterSort" name="sort" class="form-select form-select-sm">
                    <option value="available" selected="@(Model.SortBy == "available")">Sẵn sàng trước</option>
                    <option value="newest" selected="@(Model.SortBy == "newest")">Mới cập nhật</option>
                    <option value="title" selected="@(Model.SortBy == "title")">Tên sách A-Z</option>
                    <option value="pages" selected="@(Model.SortBy == "pages")">Nhiều trang nhất</option>
                </select>
                <button type="submit" class="btn btn-primary btn-sm fw-bold px-2" title="Áp dụng bộ lọc"><i class="bi bi-funnel-fill"></i></button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm px-2" title="Xóa bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </div>
    </form>

    @if (!Model.BookCards.Any())
    {
        <div class="bs-empty-state my-2" role="status">
            <div class="bs-empty-icon">
                <i class="bi @(Model.TotalBooksCount == 0 ? "bi-database-add" : "bi-search")" aria-hidden="true"></i>
            </div>
            @if (Model.TotalBooksCount == 0)
            {
                <span class="bs-badge bs-badge-info mb-2">
                    <i class="bi bi-stars" aria-hidden="true"></i>KHO SÁCH CỘNG ĐỒNG ĐANG KHỞI TẠO
                </span>
                <h4>Kho sách hiện chưa có đầu sách hoặc bản sao vật lý nào</h4>
                <p class="bs-muted">
                    Hệ thống đã sẵn sàng đón nhận những cuốn sách đầu tiên. Thành viên có thể thêm sách vào tủ cá nhân bằng mã ISBN, hoặc Quản trị viên có thể khởi tạo bộ danh mục ban đầu tại Trung tâm Quản trị.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="S22AdminAnalytics" asp-action="Index" class="bs-btn bs-btn-primary">
                            <i class="bi bi-database-fill-up" aria-hidden="true"></i>Mở Trung Tâm Quản Trị Khởi Tạo Dữ Liệu
                        </a>
                    }
                    <a asp-controller="S05IsbnAutoCatalog" asp-action="Index" class="bs-btn bs-btn-outline">
                        <i class="bi bi-upc-scan" aria-hidden="true"></i>Quét Mã ISBN Thêm Sách Mới
                    </a>
                </div>
            }
            else
            {
                <span class="bs-badge bs-badge-warning mb-2">
                    <i class="bi bi-funnel" aria-hidden="true"></i>KHÔNG TÌM THẤY BẢN SAO KHỚP BỘ LỌC
                </span>
                <h4>Chưa có bản sao sách nào khớp với điều kiện tìm kiếm hiện tại</h4>
                <p class="bs-muted">
                    Hãy thử xóa bộ lọc nguồn sách / thể loại hoặc chuyển sang công cụ Tìm kiếm Đa tiêu chí để mở rộng phạm vi tra cứu trong toàn bộ @Model.TotalBooksCount đầu sách.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="bs-btn bs-btn-primary">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>Xem Toàn Bộ Kệ Sách
                    </a>
                    <a asp-controller="S06SearchDiscovery" asp-action="Index" class="bs-btn bs-btn-outline">
                        <i class="bi bi-funnel-fill" aria-hidden="true"></i>Mở Bộ Lọc Đa Tiêu Chí
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div id="homeBookShelfGrid" class="row g-4 bs-shelf-grid is-density-3" data-skeleton-target="grid">
            @foreach (var b in Model.BookCards)
            {
                <div class="col-md-6 col-lg-4 bs-book-col">
                    <div class="card book-card tilt-3d h-100 border shadow-sm overflow-hidden">
                        <div class="position-relative bs-book-cover-wrap">
                            <img src="@(string.IsNullOrEmpty(b.CoverImageUrl) ? bookPlaceholderUrl : b.CoverImageUrl)"
                                 class="book-cover w-100 lazy-blur" alt="Bìa sách @b.Title" loading="lazy" decoding="async"
                                 onerror="this.onerror=null;this.src='@bookPlaceholderUrl'" />
                            <span class="position-absolute top-0 start-0 m-2 @(b.OwnerType == "System" ? "owner-badge-lib" : "owner-badge-p2p")">
                                @(b.OwnerType == "System" ? "🏛️ Kho chung ĐH CMC" : "🤝 Tủ sách P2P")
                            </span>
                            <span class="position-absolute top-0 end-0 m-2 badge @(b.Status == "Available" ? "bg-success" : "bg-warning text-dark")">
                                @(b.Status == "Available" ? "Sẵn sàng mượn" : $"Đang mượn / Hàng chờ ({b.QueueCount})")
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-1 gap-2">
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">@b.CategoryName</span>
                                <small class="text-muted font-monospace">ISBN: @b.ISBN</small>
                            </div>
                            <h6 class="fw-bold mb-1">@b.Title</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-pen me-1"></i>@b.Author • @b.PageCount trang</p>

                            <div class="p-2 rounded-3 bg-light small mb-3 border">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Nguồn sách:</span>
                                    <strong class="text-truncate ms-2">@b.OwnerDisplayName</strong>
                                </div>
                                @if (b.OwnerTrustScore.HasValue)
                                {
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Điểm uy tín P2P:</span>
                                        <span class="trust-pill"><i class="bi bi-star-fill me-1"></i>Uy tín: @b.OwnerTrustScore đ</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Vị trí kệ / Điểm trạm:</span>
                                    <span class="fw-semibold">@b.LocationDisplay</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Tình trạng &amp; Mã vạch:</span>
                                    <span>@b.Condition • <code>@b.Barcode</code></span>
                                </div>
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                @if (b.Status == "Available")
                                {
                                    <a asp-controller="@(b.OwnerType == "System" ? "S08LibraryLoanFlow" : "S09P2PLoanFlow")"
                                       asp-action="Index"
                                       asp-route-copyId="@b.BookCopyId"
                                       class="btn btn-primary btn-sm flex-grow-1 fw-semibold">
                                        <i class="bi bi-journal-arrow-down me-1"></i>@(b.OwnerType == "System" ? "Mượn Kho chung (0đ)" : "Mượn P2P (0đ)")
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="S11HotBookQueue" asp-action="Index" class="btn btn-warning text-dark btn-sm flex-grow-1 fw-semibold">
                                        <i class="bi bi-fire me-1"></i>Đặt Trước Hàng Chờ
                                    </a>
                                }
                                <a asp-controller="S06SearchDiscovery" asp-action="Index" asp-route-keyword="@b.Barcode" class="btn btn-outline-secondary btn-sm" title="Xem chi tiết &amp; bộ lọc">
                                    <i class="bi bi-search"></i>
                                </a>
                                <a asp-controller="S04BookNotesQuotes" asp-action="Index" asp-route-bookId="@b.BookId" class="btn btn-outline-primary btn-sm" title="Sổ tay Ghi chú &amp; Trích dẫn">
                                    <i class="bi bi-journal-richtext"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4 d-flex justify-content-between align-items-center flex-wrap gap-2" aria-label="Phân trang kệ sách Trang chủ">
                <small class="text-muted">Đang xem trang @Model.Page / @Model.TotalPages (@Model.TotalFilteredCopies bản sao phù hợp)</small>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-controller="Home" asp-action="Index"
                           asp-route-keyword="@Model.Keyword" asp-route-source="@Model.SourceFilter"
                           asp-route-category="@Model.CategorySlug" asp-route-availability="@Model.AvailabilityFilter"
                           asp-route-condition="@Model.ConditionFilter" asp-route-sort="@Model.SortBy"
                           asp-route-page="@(Model.Page - 1)">&laquo;</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-controller="Home" asp-action="Index"
                               asp-route-keyword="@Model.Keyword" asp-route-source="@Model.SourceFilter"
                               asp-route-category="@Model.CategorySlug" asp-route-availability="@Model.AvailabilityFilter"
                               asp-route-condition="@Model.ConditionFilter" asp-route-sort="@Model.SortBy"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-controller="Home" asp-action="Index"
                           asp-route-keyword="@Model.Keyword" asp-route-source="@Model.SourceFilter"
                           asp-route-category="@Model.CategorySlug" asp-route-availability="@Model.AvailabilityFilter"
                           asp-route-condition="@Model.ConditionFilter" asp-route-sort="@Model.SortBy"
                           asp-route-page="@(Model.Page + 1)">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        (function () {
            const grid = document.getElementById('homeBookShelfGrid');
            const buttons = document.querySelectorAll('[data-shelf-density]');
            if (!grid || !buttons.length) return;

            const STORAGE_KEY = 'bookshare_home_shelf_density';
            const applyDensity = (mode) => {
                const validMode = ['3', '4', 'list'].includes(mode) ? mode : '3';
                grid.classList.remove('is-density-3', 'is-density-4', 'is-density-list');
                grid.classList.add(`is-density-${validMode}`);

                grid.querySelectorAll('.bs-book-col').forEach((col) => {
                    col.classList.remove('col-md-6', 'col-lg-4', 'col-sm-6', 'col-lg-3', 'col-12');
                    if (validMode === '4') {
                        col.classList.add('col-sm-6', 'col-lg-3');
                    } else if (validMode === 'list') {
                        col.classList.add('col-12');
                    } else {
                        col.classList.add('col-md-6', 'col-lg-4');
                    }
                });

                buttons.forEach((btn) => {
                    const active = btn.getAttribute('data-shelf-density') === validMode;
                    btn.classList.toggle('active', active);
                    btn.setAttribute('aria-pressed', String(active));
                });

                try { localStorage.setItem(STORAGE_KEY, validMode); } catch { }
            };

            let saved = '3';
            try { saved = localStorage.getItem(STORAGE_KEY) || '3'; } catch { }
            applyDensity(saved);

            buttons.forEach((btn) => {
                btn.addEventListener('click', () => {
                    applyDensity(btn.getAttribute('data-shelf-density') || '3');
                });
            });
        })();
    </script>
}
